Cell[CellGroupData[{

Cell["Defining the function imposing cuts", "Subsubsection",
 CellChangeTimes->{{3.9823124727165127`*^9, 
  3.9823124881758575`*^9}},ExpressionUUID->"972173b5-1492-704b-8eb1-\
0e78bc03f712"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"cutFuncComp", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Hold", "@", 
      RowBox[{"Compile", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"ptsKin", ",", "_Real", ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"weights", ",", "_Real"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"ifFBD", ",", 
            RowBox[{"True", "|", "False"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"ifMid", ",", 
            RowBox[{"True", "|", "False"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"EALPmin", ",", "_Real"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"EpprMin", ",", "_Real"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"EpprMax", ",", "_Real"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"etaPmin", ",", "_Real"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"etaXmin", ",", "_Real"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"etaXmax", ",", "_Real"}], "}"}]}], "}"}], ",", 
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
           "Eppr", ",", "EALP", ",", "Eepr", ",", "cppr", ",", "cX", ",", 
            "cepr", ",", "s2", ",", "t1", ",", "t2", ",", "s1", ",", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{
               RowBox[{"robust", " ", "eta", " ", "from", " ", "cos", 
                RowBox[{"(", "theta", ")"}]}], ":", "eta"}], "=", 
              RowBox[{"0.5", " ", "Log", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"1", "+", "c"}], ")"}], "/", 
                 RowBox[{"(", 
                  RowBox[{"1", "-", "c"}], ")"}]}], ")"}]}]}], "*)"}], 
            RowBox[{"eps", "=", "1.*^-12"}], ",", "cClip", ",", "etaPpr", ",",
             "etaX", ",", 
            RowBox[{"\[Phi]Suppression", "=", "0."}], ",", 
            RowBox[{"\[Eta]epr", "=", "0."}], ",", 
            RowBox[{"pass", "=", "False"}], ",", 
            RowBox[{"passFin", "=", "0"}], ",", 
            RowBox[{"Q2FBDmin", "=", 
             SuperscriptBox["10", 
              RowBox[{"-", "3."}]]}], ",", 
            RowBox[{"\[Eta]eprFBDmax", "=", 
             RowBox[{"-", "4.2"}]}], ",", 
            RowBox[{"\[Eta]MidCut", "=", "4."}]}], "}"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
             "s2", ",", "t1", ",", "t2", ",", "s1", ",", "Eppr", ",", "EALP", 
              ",", "Eepr", ",", "cppr", ",", "cX", ",", "cepr", ",", "etaPpr",
               ",", "etaX"}], "}"}], "=", "ptsKin"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"pass", "=", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"EALP", ">", "EALPmin"}], ")"}], "&&", 
              RowBox[{"(", 
               RowBox[{"EpprMin", "<", "Eppr", "<", "EpprMax"}], ")"}], "&&", 
              RowBox[{"(", 
               RowBox[{"etaPpr", ">", "etaPmin"}], ")"}], "&&", 
              RowBox[{"etaXmin", "<", "etaX", "<", "etaXmax"}]}], ")"}]}], ";",
            "\[IndentingNewLine]", 
           RowBox[{"\[Eta]epr", "=", 
            RowBox[{
             FractionBox["1", "2"], 
             RowBox[{"Log", "[", 
              FractionBox[
               RowBox[{"1", "+", "cepr"}], 
               RowBox[{"1.", "-", "cepr"}]], "]"}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{"ifFBD", ",", "\[IndentingNewLine]", 
             RowBox[{"pass", "=", 
              RowBox[{"pass", "&&", 
               RowBox[{"(", 
                RowBox[{"Q2FBDmin", "<", 
                 RowBox[{"-", "t1"}]}], ")"}], "&&", 
               RowBox[{"\[Eta]epr", "<", "\[Eta]eprFBDmax"}]}]}]}], 
            "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{"ifMid", ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"pass", "=", 
               RowBox[{"pass", "&&", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"Abs", "[", "\[Eta]epr", "]"}], "<", 
                  "\[Eta]MidCut"}], ")"}]}]}], ";"}]}], "\[IndentingNewLine]",
             "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"passFin", "=", 
            RowBox[{"Boole", "[", "pass", "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"weights", "*", "passFin"}], ",", "s2", ",", "t1", ",", 
             "t2", ",", "s1", ",", "Eppr", ",", "EALP", ",", "Eepr", ",", 
             "cppr", ",", "cX", ",", "cepr", ",", "etaPpr", ",", "etaX", ",", 
             "\[Eta]epr"}], "}"}]}]}], "]"}], ",", 
        RowBox[{"CompilationTarget", "->", "\"\<C\>\""}], ",", 
        RowBox[{"RuntimeOptions", "->", "\"\<Speed\>\""}], ",", 
        RowBox[{"RuntimeAttributes", "->", 
         RowBox[{"{", "Listable", "}"}]}], ",", 
        RowBox[{"Parallelization", "->", "True"}]}], "]"}]}], "/.", 
     RowBox[{"ruleOwn", "[", 
      RowBox[{"{", 
       RowBox[{"Q2minEIC", ",", "Q2maxEIC"}], "}"}], "]"}]}], "//", 
    "ReleaseHold"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"checkIfCompiled", "[", "cutFuncComp", "]"}]}], "Input",
 CellChangeTimes->{{3.9817730376794357`*^9, 3.981773041829777*^9}, {
   3.981773082259775*^9, 3.9817730926884403`*^9}, {3.9817731304963417`*^9, 
   3.9817732001952*^9}, {3.9817757443932133`*^9, 3.9817757626187344`*^9}, {
   3.9823125697914658`*^9, 3.982312581254423*^9}, {3.9823130224228306`*^9, 
   3.9823130295900764`*^9}, {3.9823131335569973`*^9, 
   3.9823132302840557`*^9}, {3.9823132838908424`*^9, 
   3.9823133467247677`*^9}, {3.9823134041568375`*^9, 3.982313421322191*^9}, {
   3.983694773214567*^9, 3.9836947935080605`*^9}, {3.9837047928059254`*^9, 
   3.9837047928525314`*^9}, 3.996584526991246*^9},
 CellLabel->"In[66]:=",ExpressionUUID->"fe3e0f38-1f29-3949-86cb-752ce6d66324"],

Cell[BoxData[
 FormBox[
  RowBox[{"{", 
   RowBox[{"True", ",", 
    RowBox[{"{", "}"}]}], "}"}], TraditionalForm]], "Output",
 CellChangeTimes->{3.9823130391058197`*^9, 3.9823132480347214`*^9, 
  3.9823133501167126`*^9, 3.9823134267176037`*^9, 3.9836948074439907`*^9, 
  3.98370479644549*^9, 3.996587331265739*^9},
 CellLabel->"Out[67]=",ExpressionUUID->"419125de-1533-410a-8215-e95a6e292a35"]
}, Open  ]]
