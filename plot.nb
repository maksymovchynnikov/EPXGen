Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"If", " ", "generating", " ", "total", " ", "cross"}], "-", 
    "section", " ", "-", " ", "MC"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ifGenerate\[Sigma]", "=", "False"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"file\[Sigma]", "=", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"dir", "[", "\"\<datasets\>\"", "]"}], 
        ",", "\"\<MC calculation\>\"", 
        ",", "\"\<cross-sections-mesons-setups.mx\>\""}], "}"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"!", 
       RowBox[{"FileExistsQ", "[", "file\[Sigma]", "]"}]}], ",", 
      RowBox[{"ifGenerate\[Sigma]", "=", "True"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"If", " ", "generating", " ", "analytic", " ", 
     RowBox[{"d\[Sigma]", "/", 
      SuperscriptBox["dQ", "2"]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ifGenerated\[Sigma]dQ2ini", "=", "False"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "\[Sigma]2to3Total", ",", "mesonSample", ",", 
       "d\[Sigma]dQ22to3analytic"}], "}"}], "//", "Clear"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"EnergiesConfigurations", "=", 
        RowBox[{"{", 
         RowBox[{"\"\<100\[Times]10\>\"", ",", "\"\<275\[Times]18\>\"", 
          ",", "\"\<41\[Times]5\>\""}], "}"}]}], ",", 
       RowBox[{"allMesons", "=", 
        RowBox[{"Join", "[", 
         RowBox[{"mesonsP", ",", "mesonsV"}], "]"}]}], ",", 
       RowBox[{"NeventsTest", "=", 
        RowBox[{"5", "*", 
         SuperscriptBox["10", "6"]}]}], ",", "Ep", ",", "Ee"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
      "Print", "[", "\"\<Generating/importing total cross-section...\>\"", 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{"ifGenerate\[Sigma]", ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"ResourceFunction", "[", "\"\<MonitorProgress\>\"", "]"}], "@", 
          RowBox[{"Do", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{"Ep", ",", "Ee"}], "}"}], "=", 
              RowBox[{"energies", "[", "setup", "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"Print", "[", 
              RowBox[{"Row", "[", 
               RowBox[{"{", 
                RowBox[{"\"\<Setup \>\"", ",", " ", "setup"}], "}"}], "]"}], 
              "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
              "ResourceFunction", "[", "\"\<MonitorProgress\>\"", "]"}], "@", 
              RowBox[{"Do", "[", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{
                 RowBox[{"BlockFinal", "[", 
                  RowBox[{"P", ",", 
                   RowBox[{"MASS", "[", "P", "]"}], ",", "fatest", ",", "Ep", 
                   ",", "Ee", ",", "NeventsTest", ",", 
                   RowBox[{"MASS", "[", "P", "]"}], ",", "mpval", ",", "Ep", ",",
                    "0.", ",", 
                   RowBox[{"-", "3."}], ",", "14.", ",", "0.", ",", "2."}], 
                  "]"}], ";", "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"\[Sigma]2to3Total", "[", 
                   RowBox[{"setup", ",", "P"}], "]"}], "=", "\[Sigma]tot"}], 
                 ";"}], "\[IndentingNewLine]", ",", 
                RowBox[{"{", 
                 RowBox[{"P", ",", "allMesons"}], "}"}]}], "]"}]}], ";"}], 
            "\[IndentingNewLine]", ",", 
            RowBox[{"{", 
             RowBox[{"setup", ",", "EnergiesConfigurations"}], "}"}]}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"tabMesonsAll", "=", 
          RowBox[{"Flatten", "[", 
           RowBox[{
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"setup", ",", "P", ",", 
                RowBox[{"\[Sigma]2to3Total", "[", 
                 RowBox[{"setup", ",", "P"}], "]"}]}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"setup", ",", "EnergiesConfigurations"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"P", ",", "allMesons"}], "}"}]}], "]"}], ",", "1"}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"Export", "[", 
          RowBox[{"file\[Sigma]", ",", "tabMesonsAll", ",", "\"\<MX\>\""}], 
          "]"}]}], "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"tabMesonsAll", "=", 
          RowBox[{"Import", "[", 
           RowBox[{"file\[Sigma]", ",", "\"\<MX\>\""}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Do", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"\[Sigma]2to3Total", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"tabMesonsAll", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", 
              RowBox[{
               RowBox[{"tabMesonsAll", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "=", 
            RowBox[{
             RowBox[{"tabMesonsAll", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "[", 
             RowBox[{"[", "3", "]"}], "]"}]}], "\[IndentingNewLine]", ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", 
             RowBox[{"Length", "[", "tabMesonsAll", "]"}]}], "}"}]}], "]"}], 
         ";"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{
      "Print", "[", "\"\<Generating/importing analytic \
d\[Sigma]/\!\(\*SuperscriptBox[\(dQ\), \(2\)]\)...\>\"", "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"ResourceFunction", "[", "\"\<MonitorProgress\>\"", "]"}], "@", 
       RowBox[{"Do", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"Ep", ",", "Ee"}], "}"}], "=", 
           RowBox[{"energies", "[", "setup", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"ResourceFunction", "[", "\"\<MonitorProgress\>\"", "]"}], 
           "@", 
           RowBox[{"Do", "[", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Module", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"fileQ2", ",", 
                 RowBox[{
                 "ifGenerated\[Sigma]dQ2", "=", 
                  "ifGenerated\[Sigma]dQ2ini"}]}], "}"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"fileQ2", "=", 
                 RowBox[{"FileNameJoin", "[", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"dir", "[", "\"\<datasets\>\"", "]"}], 
                    ",", "\"\<Analytic calculation\>\"", ",", 
                    RowBox[{"\"\<dsigmadQ2_\>\"", "<>", 
                    RowBox[{"exportName", "[", "setup", "]"}], 
                    "<>", "\"\<_\>\"", "<>", 
                    RowBox[{"mapMeson", "[", "meson", "]"}], 
                    "<>", "\"\<.mx\>\""}]}], "}"}], "]"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"!", 
                   RowBox[{"FileExistsQ", "[", "fileQ2", "]"}]}], ",", 
                  RowBox[{"ifGenerated\[Sigma]dQ2", "=", "True"}]}], "]"}], ";",
                 "\[IndentingNewLine]", 
                RowBox[{"If", "[", 
                 RowBox[{"ifGenerated\[Sigma]dQ2", ",", "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"MemberQ", "[", 
                    RowBox[{"mesonsP", ",", "meson"}], "]"}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"d\[Sigma]dQ22to3analytic", "[", 
                    RowBox[{"setup", ",", "meson"}], "]"}], "=", 
                    RowBox[{"d\[Sigma]Pdt1AnalyticTab", "[", 
                    RowBox[{"meson", ",", 
                    RowBox[{"MASS", "[", "meson", "]"}], ",", "fatest", ",", 
                    "Ep", ",", "Ee", ",", "\"\<QuasiMonteCarlo\>\""}], 
                    "]"}]}], ";"}], "\[IndentingNewLine]", ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"d\[Sigma]dQ22to3analytic", "[", 
                    RowBox[{"setup", ",", "meson"}], "]"}], "=", 
                    RowBox[{"d\[Sigma]Vdt1AnalyticTab", "[", 
                    RowBox[{
                    "meson", ",", "Ep", ",", "Ee", 
                    ",", "\"\<QuasiMonteCarlo\>\""}], "]"}]}], ";"}]}], 
                    "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
                   RowBox[{"Export", "[", 
                    RowBox[{"fileQ2", ",", 
                    RowBox[{"d\[Sigma]dQ22to3analytic", "[", 
                    RowBox[{"setup", ",", "meson"}], "]"}], 
                    ",", "\"\<MX\>\""}], "]"}]}], "\[IndentingNewLine]", ",", 
                  "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{"d\[Sigma]dQ22to3analytic", "[", 
                    RowBox[{"setup", ",", "meson"}], "]"}], "=", 
                   RowBox[{"Import", "[", 
                    RowBox[{"fileQ2", ",", "\"\<MX\>\""}], "]"}]}]}], 
                 "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
                RowBox[{"Module", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"Q2min", "=", 
                    RowBox[{"Min", "[", 
                    RowBox[{
                    RowBox[{"d\[Sigma]dQ22to3analytic", "[", 
                    RowBox[{"setup", ",", "meson"}], "]"}], "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}], ",", 
                    RowBox[{"Q2max", "=", 
                    RowBox[{"Max", "[", 
                    RowBox[{
                    RowBox[{"d\[Sigma]dQ22to3analytic", "[", 
                    RowBox[{"setup", ",", "meson"}], "]"}], "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}]}], "}"}],
                   ",", "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"d\[Sigma]dQ22to3analyticInt", "[", 
                    RowBox[{"setup", ",", "meson", ",", "Q2_"}], "]"}], "=", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Min", "[", 
                    RowBox[{
                    RowBox[{"d\[Sigma]dQ22to3analytic", "[", 
                    RowBox[{"setup", ",", "meson"}], "]"}], "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}], "<=", 
                    "Q2", "<=", 
                    RowBox[{"Max", "[", 
                    RowBox[{
                    RowBox[{"d\[Sigma]dQ22to3analytic", "[", 
                    RowBox[{"setup", ",", "meson"}], "]"}], "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}], ",", 
                    RowBox[{"Evaluate", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Interpolation", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"Log", "[", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", 
                    RowBox[{"Log", "[", 
                    RowBox[{"Max", "[", 
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], ",", 
                    SuperscriptBox["10", 
                    RowBox[{"-", "90."}]]}], "]"}], "]"}]}], "}"}], "&"}], "/@", 
                    RowBox[{"d\[Sigma]dQ22to3analytic", "[", 
                    RowBox[{"setup", ",", "meson"}], "]"}]}], ",", 
                    RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}], "[", 
                    RowBox[{"Log", "[", "Q2", "]"}], "]"}], "//", "Exp"}], 
                    "]"}], ",", "0."}], "]"}]}], ";", "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{"\[Sigma]2to3Q2cut", "[", 
                    RowBox[{"setup", ",", "meson"}], "]"}], "=", 
                    RowBox[{
                    RowBox[{"NIntegrate", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"d\[Sigma]dQ22to3analyticInt", "[", 
                    RowBox[{"setup", ",", "meson", ",", 
