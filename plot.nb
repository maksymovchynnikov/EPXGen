Cell["Defining the cut function", "Subsection",
 CellChangeTimes->{{3.9817730151100388`*^9, 3.9817730188888474`*^9}, {
  3.9817811911600037`*^9, 
  3.9817811932296505`*^9}},ExpressionUUID->"9ddbdd45-b88a-494c-b779-\
ab59af1f3b7e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"cutFuncComp", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Hold", "@", 
      RowBox[{"Compile", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"ptsKin", ",", "_Real", ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"weights", ",", "_Real"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"EALPmin", ",", "_Real"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"EpprMin", ",", "_Real"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"EpprMax", ",", "_Real"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"etaPmin", ",", "_Real"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"etaXmin", ",", "_Real"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"etaXmax", ",", "_Real"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"ifFBD", ",", 
            RowBox[{"True", "|", "False"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"ifMid", ",", 
            RowBox[{"True", "|", "False"}]}], "}"}]}], "}"}], ",", 
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
           "Eppr", ",", "EALP", ",", "Eepr", ",", "cppr", ",", "cX", ",", 
            "cepr", ",", "s2", ",", "t1", ",", "t2", ",", "s1", ",", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{
               RowBox[{"robust", " ", "eta", " ", "from", " ", "cos", 
                RowBox[{"(", "theta", ")"}]}], ":", "eta"}], "=", 
              RowBox[{"0.5", " ", "Log", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"1", "+", "c"}], ")"}], "/", 
                 RowBox[{"(", 
                  RowBox[{"1", "-", "c"}], ")"}]}], ")"}]}]}], "*)"}], 
            RowBox[{"eps", "=", "1.*^-12"}], ",", "cClip", ",", "etaPpr", ",",
             "etaX", ",", 
            RowBox[{"\[Phi]Suppression", "=", "0."}], ",", 
            RowBox[{"\[Eta]epr", "=", "0."}], ",", 
            RowBox[{"pass", "=", "False"}], ",", 
            RowBox[{"passFin", "=", "0"}], ",", 
            RowBox[{"Q2minFBD", "=", 
             RowBox[{"0.9", "*", 
              SuperscriptBox["10", 
               RowBox[{"-", "3."}]]}]}], 
            RowBox[{"(*", 
             RowBox[{"not", " ", 
              SuperscriptBox["10", 
               RowBox[{"-", "3"}]], " ", "just", " ", "for", " ", "niceness", 
              " ", "of", " ", "plot"}], "*)"}], ",", 
            RowBox[{"\[Eta]maxFBD", "=", 
             RowBox[{"-", "4.2"}]}], ",", 
            RowBox[{"\[Eta]absMidmax", "=", "4."}]}], "}"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
             "s2", ",", "t1", ",", "t2", ",", "s1", ",", "Eppr", ",", "EALP", 
              ",", "Eepr", ",", "cppr", ",", "cX", ",", "cepr", ",", "etaPpr",
               ",", "etaX"}], "}"}], "=", "ptsKin"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"\[Eta]epr", "=", 
            RowBox[{
             FractionBox["1", "2."], 
             RowBox[{"Log", "[", 
              FractionBox[
               RowBox[{"1", "+", "cepr"}], 
               RowBox[{"1", "-", "cepr"}]], "]"}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{"ifFBD", ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"pass", "=", 
               RowBox[{"pass", "||", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"EALP", ">", "EALPmin"}], ")"}], "&&", 
                  RowBox[{"(", 
                   RowBox[{"EpprMin", "<", "Eppr", "<", "EpprMax"}], ")"}], "&&", 
                  RowBox[{"(", 
                   RowBox[{"etaPpr", ">", "etaPmin"}], ")"}], "&&", 
                  RowBox[{"etaXmin", "<", "etaX", "<", "etaXmax"}], " ", "&&", 
                  RowBox[{"Q2minFBD", "<", 
                   RowBox[{"-", "t1"}]}], "&&", 
                  RowBox[{"\[Eta]epr", "<", "\[Eta]maxFBD"}]}], ")"}]}]}], 
              ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{"ifMid", ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"pass", "=", 
               RowBox[{"pass", "||", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"EALP", ">", "EALPmin"}], ")"}], "&&", 
                  RowBox[{"(", 
                   RowBox[{"EpprMin", "<", "Eppr", "<", "EpprMax"}], ")"}], "&&", 
                  RowBox[{"(", 
                   RowBox[{"etaPpr", ">", "etaPmin"}], ")"}], "&&", 
                  RowBox[{"etaXmin", "<", "etaX", "<", "etaXmax"}], " ", "&&", 
                  RowBox[{
                   RowBox[{"Abs", "[", "\[Eta]epr", "]"}], "<", 
                   "\[Eta]absMidmax"}]}], ")"}]}]}], ";"}]}], 
            "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"passFin", "=", 
            RowBox[{"Boole", "[", "pass", "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"weights", "*", "passFin"}], ",", "s2", ",", "t1", ",", 
             "t2", ",", "s1", ",", "Eppr", ",", "EALP", ",", "Eepr", ",", 
             "cppr", ",", "cX", ",", "cepr", ",", "etaPpr", ",", "etaX"}], 
            "}"}]}]}], "]"}], ",", 
        RowBox[{"CompilationTarget", "->", "\"\<C\>\""}], ",", 
        RowBox[{"RuntimeOptions", "->", "\"\<Speed\>\""}], ",", 
        RowBox[{"RuntimeAttributes", "->", 
         RowBox[{"{", "Listable", "}"}]}], ",", 
        RowBox[{"Parallelization", "->", "True"}]}], "]"}]}], "/.", 
     RowBox[{"ruleOwn", "[", 
      RowBox[{"{", "}"}], "]"}]}], "//", "ReleaseHold"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"checkIfCompiled", "[", "cutFuncComp", "]"}]}], "Input",
 CellChangeTimes->{{3.9817730376794357`*^9, 3.981773041829777*^9}, {
   3.981773082259775*^9, 3.9817730926884403`*^9}, {3.9817731304963417`*^9, 
   3.9817732001952*^9}, {3.9817757443932133`*^9, 3.9817757626187344`*^9}, {
   3.9836920829040966`*^9, 3.9836921816544456`*^9}, {3.98369259621611*^9, 
   3.9836926125050087`*^9}, 3.983692648247017*^9, {3.996584376747551*^9, 
   3.9965843837443933`*^9}},
 CellLabel->"In[24]:=",ExpressionUUID->"61908f74-7582-854d-b300-d8e5bc8c2651"],

