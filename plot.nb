Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"setup", ",", "pt"}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{"\"\<100\[Times]10\>\"", ",", "\"\<\[Eta]\>\""}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"pdf2D1", "=", 
    RowBox[{"pdf2Dmaker", "[", 
     RowBox[{
      RowBox[{"mesonSample", "[", 
       RowBox[{"setup", ",", "pt"}], "]"}], ",", "indexFinEepr", ",", 
      "indexFint1", ",", "30", ",", "30"}], "]"}]}], ";"}], "//", 
  "AbsoluteTiming"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dataconv", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Hold", "@", 
      RowBox[{"Compile", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{"data", ",", "_Real", ",", "1"}], "}"}], "}"}], ",", 
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"cos", "=", 
            RowBox[{"data", "[", 
             RowBox[{"[", "indexFincos\[Theta]epr", "]"}], "]"}]}], "}"}], ",",
           "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             FractionBox["1", "2"], 
             RowBox[{"Log", "[", 
              FractionBox[
               RowBox[{"1", "+", "cos"}], 
               RowBox[{"1", "-", "cos"}]], "]"}]}], ",", 
            RowBox[{"-", 
             RowBox[{"data", "[", 
              RowBox[{"[", "indexFint1", "]"}], "]"}]}]}], "}"}]}], 
         "\[IndentingNewLine]", "]"}], ",", 
        RowBox[{"CompilationTarget", "->", "\"\<C\>\""}], ",", 
        RowBox[{"RuntimeOptions", "->", "\"\<Speed\>\""}], ",", 
        RowBox[{"RuntimeAttributes", "->", 
         RowBox[{"{", "Listable", "}"}]}]}], "]"}]}], "/.", 
     RowBox[{"ruleOwn", "[", 
      RowBox[{"{", 
       RowBox[{"indexFincos\[Theta]epr", ",", "indexFint1"}], "}"}], "]"}]}], 
    "//", "ReleaseHold"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"checkIfCompiled", "[", "dataconv", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"pdf2D2", "=", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"datTemp", "=", 
        RowBox[{"dataconv", "[", 
         RowBox[{"mesonSample", "[", 
          RowBox[{"setup", ",", "pt"}], "]"}], "]"}]}], "}"}], ",", 
      RowBox[{"pdf2Dmaker", "[", 
       RowBox[{"datTemp", ",", "1", ",", "2", ",", "30", ",", "30"}], "]"}]}],
      "]"}]}], ";"}], "//", "AbsoluteTiming"}]}], "Input",
 CellChangeTimes->{{3.977287462569309*^9, 3.977287477813362*^9}, {
