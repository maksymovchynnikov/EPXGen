Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"dataconv", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Hold", "@", 
      RowBox[{"Compile", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{"data", ",", "_Real", ",", "1"}], "}"}], "}"}], ",", 
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"cos1", "=", 
             RowBox[{"data", "[", 
              RowBox[{"[", "indexFincos\[Theta]ppr", "]"}], "]"}]}], ",", 
            RowBox[{"cos2", "=", 
             RowBox[{"data", "[", 
              RowBox[{"[", "indexFincos\[Theta]ALP", "]"}], "]"}]}]}], "}"}], 
          ",", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             FractionBox["1", "2"], 
             RowBox[{"Log", "[", 
              FractionBox[
               RowBox[{"1", "+", "cos1"}], 
               RowBox[{"1", "-", "cos1"}]], "]"}]}], ",", 
            RowBox[{
             FractionBox["1", "2"], 
             RowBox[{"Log", "[", 
              FractionBox[
               RowBox[{"1", "+", "cos2"}], 
               RowBox[{"1", "-", "cos2"}]], "]"}]}]}], "}"}]}], 
         "\[IndentingNewLine]", "]"}], ",", 
        RowBox[{"CompilationTarget", "->", "\"\<C\>\""}], ",", 
        RowBox[{"RuntimeOptions", "->", "\"\<Speed\>\""}], ",", 
        RowBox[{"RuntimeAttributes", "->", 
         RowBox[{"{", "Listable", "}"}]}]}], "]"}]}], "/.", 
     RowBox[{"ruleOwn", "[", 
      RowBox[{"{", 
       RowBox[{"indexFincos\[Theta]ALP", ",", "indexFincos\[Theta]ppr"}], 
       "}"}], "]"}]}], "//", "ReleaseHold"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"checkIfCompiled", "[", "dataconv", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"quickSelector", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Hold", "@", 
      RowBox[{"Compile", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"data", ",", "_Real", ",", "2"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"Epcut", ",", "_Real"}], "}"}]}], "}"}], ",", 
        RowBox[{"Select", "[", 
         RowBox[{"data", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "indexFinEppr", "]"}], "]"}], "<", "Epcut"}], 
           "&"}]}], "]"}], ",", 
        RowBox[{"CompilationTarget", "->", "\"\<C\>\""}], ",", 
        RowBox[{"RuntimeOptions", "->", "\"\<Speed\>\""}]}], "]"}]}], "/.", 
     RowBox[{"ruleOwn", "[", 
      RowBox[{"{", "indexFinEppr", "}"}], "]"}]}], "//", "ReleaseHold"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"checkIfCompiled", "[", "quickSelector", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"particle", "=", "\"\<\[Eta]\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"setup1", "=", "\"\<275\[Times]18\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"pdf2D1", "=", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"datTemp", "=", 
        RowBox[{"quickSelector", "[", 
         RowBox[{
          RowBox[{"mesonSample", "[", 
           RowBox[{"setup1", ",", "particle"}], "]"}], ",", 
          RowBox[{"0.9", "*", 
           RowBox[{
            RowBox[{"energies", "[", "setup1", "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}]}]}], "]"}]}], "}"}], ",", 
      RowBox[{"pdf2Dmaker", "[", 
       RowBox[{
        RowBox[{"dataconv", "[", "datTemp", "]"}], ",", "1", ",", "2", ",", 
        "25", ",", "25"}], "]"}]}], "]"}]}], ";"}], "//", 
  "AbsoluteTiming"}], "\[IndentingNewLine]", 
 RowBox[{
