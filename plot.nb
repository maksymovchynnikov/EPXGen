Cell[CellGroupData[{

Cell["Imposing cuts and generating PDFs", "Subsubsection",
 CellChangeTimes->{{3.982312483069868*^9, 3.982312484558897*^9}, {
  3.982313510940916*^9, 
  3.9823135138450546`*^9}},ExpressionUUID->"7e6c2ba3-0b33-6145-a98f-\
77090d4fde15"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"setup", ",", "mes"}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{"\"\<100\[Times]10\>\"", ",", "\"\<\[Eta]\>\""}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Block", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"Ep", ",", "Ee", ",", "mX", ",", 
     RowBox[{"\[Eta]pprMin", "=", "4.5"}], ",", 
     RowBox[{"\[Eta]Xmin", "=", 
      RowBox[{"-", "4."}]}], ",", 
     RowBox[{"\[Eta]Xmax", "=", "4."}]}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"mX", "=", 
     RowBox[{"MASS", "[", "mes", "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"Ep", ",", "Ee"}], "}"}], "=", 
     RowBox[{"energies", "[", "setup", "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"funcOwn", "[", 
      RowBox[{"ptsKin_", ",", "weights_"}], "]"}], ":=", 
     RowBox[{"cutFuncComp", "[", 
      RowBox[{
      "ptsKin", ",", "weights", ",", "True", ",", "False", ",", "mX", ",", 
       RowBox[{"0.5", "*", "Ep"}], ",", 
       RowBox[{"0.9", "*", "Ep"}], ",", "\[Eta]pprMin", ",", "\[Eta]Xmin", ",",
        "\[Eta]Xmax"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"cuttedDataFBD", "[", 
      RowBox[{"setup", ",", "mes"}], "]"}], "=", 
     RowBox[{"BlockFinalAlt", "[", 
      RowBox[{"mes", ",", "mX", ",", "fatest", ",", "Ep", ",", "Ee", ",", 
       RowBox[{"mesonSample", "[", 
        RowBox[{"setup", ",", "mes"}], "]"}], ",", "funcOwn"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"pdfDataCuts", "[", 
      RowBox[{"setup", ",", "mes", ",", "\"\<FBD\>\""}], "]"}], "=", 
     RowBox[{"pdf2Dmaker", "[", 
      RowBox[{
       RowBox[{"cuttedDataFBD", "[", 
        RowBox[{"setup", ",", "mes"}], "]"}], ",", "indexFinEepr", ",", 
       RowBox[{"-", "1"}], ",", "50", ",", "50"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"funcOwn", "[", 
      RowBox[{"ptsKin_", ",", "weights_"}], "]"}], ":=", 
     RowBox[{"cutFuncComp", "[", 
      RowBox[{
      "ptsKin", ",", "weights", ",", "False", ",", "True", ",", "mX", ",", 
       RowBox[{"0.5", "*", "Ep"}], ",", 
       RowBox[{"0.9", "*", "Ep"}], ",", "\[Eta]pprMin", ",", "\[Eta]Xmin", ",",
        "\[Eta]Xmax"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"cuttedDataMid", "[", 
      RowBox[{"setup", ",", "mes"}], "]"}], "=", 
     RowBox[{"BlockFinalAlt", "[", 
      RowBox[{"mes", ",", "mX", ",", "fatest", ",", "Ep", ",", "Ee", ",", 
       RowBox[{"mesonSample", "[", 
        RowBox[{"setup", ",", "mes"}], "]"}], ",", "funcOwn"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"pdfDataCuts", "[", 
      RowBox[{"setup", ",", "mes", ",", "\"\<Mid\>\""}], "]"}], "=", 
     RowBox[{"pdf2Dmaker", "[", 
      RowBox[{
       RowBox[{"cuttedDataMid", "[", 
        RowBox[{"setup", ",", "mes"}], "]"}], ",", "indexFinEepr", ",", 
       RowBox[{"-", "1"}], ",", "50", ",", "50"}], "]"}]}], ";"}]}], 
  "\[IndentingNewLine]", "]"}]}], "Input",
 CellChangeTimes->{{3.9823123919201527`*^9, 3.9823124327501125`*^9}, {
  3.982312636711567*^9, 3.9823126978533344`*^9}, {3.9823127456204376`*^9, 
  3.982312756681221*^9}, {3.9823130434779415`*^9, 3.9823130990057735`*^9}, {
  3.9823132611419067`*^9, 3.9823132690390396`*^9}, {3.98231335701684*^9, 
  3.9823133661965446`*^9}, {3.9823134178399677`*^9, 3.982313483970701*^9}},
 CellLabel->"In[68]:=",ExpressionUUID->"a99240f4-8ff1-ef4e-be63-0ea5b6a2aa62"]
}, Open  ]],

