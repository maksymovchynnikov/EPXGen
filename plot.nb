Cell[CellGroupData[{

Cell["Defining the cut function", "Subsection",
 CellChangeTimes->{{3.982304576868107*^9, 
  3.982304579514799*^9}},ExpressionUUID->"cee7fdbf-159d-5746-9e0a-\
f7b2d7fa9da3"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"fraction\[Eta]CutComp", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Hold", "@", 
      RowBox[{"Compile", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"ptsKin", ",", "_Real", ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"weights", ",", "_Real"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"EALPmin", ",", "_Real"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"EpprMin", ",", "_Real"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"EpprMax", ",", "_Real"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"etaPmin", ",", "_Real"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"etaXmin", ",", "_Real"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"etaXmax", ",", "_Real"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"ifFBD", ",", 
            RowBox[{"True", "|", "False"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"ifMid", ",", 
            RowBox[{"True", "|", "False"}]}], "}"}]}], "}"}], ",", 
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
           "Eppr", ",", "EALP", ",", "Eepr", ",", "cppr", ",", "cX", ",", 
            "cepr", ",", "s2", ",", "t1", ",", "t2", ",", "s1", ",", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{
               RowBox[{"robust", " ", "eta", " ", "from", " ", "cos", 
                RowBox[{"(", "theta", ")"}]}], ":", "eta"}], "=", 
              RowBox[{"0.5", " ", "Log", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"1", "+", "c"}], ")"}], "/", 
                 RowBox[{"(", 
                  RowBox[{"1", "-", "c"}], ")"}]}], ")"}]}]}], "*)"}], 
            RowBox[{"eps", "=", "1.*^-12"}], ",", "cClip", ",", "etaPpr", ",",
             "etaX", ",", 
            RowBox[{"pass", "=", "1."}], ",", 
            RowBox[{"\[Phi]Suppression", "=", "0."}], ",", 
            RowBox[{"\[Eta]epr", "=", "0."}], ",", 
            RowBox[{"Q2minFBD", "=", 
             SuperscriptBox["10", 
              RowBox[{"-", "3."}]]}], ",", 
            RowBox[{"\[Eta]eprMaxFBD", "=", 
             RowBox[{"-", "4.2"}]}], ",", 
            RowBox[{"\[Eta]Mid\[Eta]Cut", "=", "4."}]}], "}"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
             "s2", ",", "t1", ",", "t2", ",", "s1", ",", "Eppr", ",", "EALP", 
              ",", "Eepr", ",", "cppr", ",", "cX", ",", "cepr"}], "}"}], "=", 
            "ptsKin"}], ";", "\[IndentingNewLine]", 
           RowBox[{"cClip", "=", "cppr"}], ";", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"cClip", ">", 
              RowBox[{"1.", "-", "eps"}]}], ",", 
             RowBox[{"cClip", "=", 
              RowBox[{"1.", "-", "eps"}]}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"cClip", "<", 
              RowBox[{
               RowBox[{"-", "1."}], "+", "eps"}]}], ",", 
             RowBox[{"cClip", "=", 
              RowBox[{
               RowBox[{"-", "1."}], "+", "eps"}]}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"etaPpr", "=", 
            RowBox[{"0.5", "*", 
             RowBox[{"Log", "[", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"1.", "+", "cClip"}], ")"}], "/", 
               RowBox[{"(", 
                RowBox[{"1.", "-", "cClip"}], ")"}]}], "]"}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"cClip", "=", "cX"}], ";", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"cClip", ">", 
              RowBox[{"1.", "-", "eps"}]}], ",", 
             RowBox[{"cClip", "=", 
              RowBox[{"1.", "-", "eps"}]}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"cClip", "<", 
              RowBox[{
               RowBox[{"-", "1."}], "+", "eps"}]}], ",", 
             RowBox[{"cClip", "=", 
              RowBox[{
               RowBox[{"-", "1."}], "+", "eps"}]}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"etaX", "=", 
            RowBox[{"0.5", "*", 
             RowBox[{"Log", "[", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"1.", "+", "cClip"}], ")"}], "/", 
               RowBox[{"(", 
                RowBox[{"1.", "-", "cClip"}], ")"}]}], "]"}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"pass", "=", 
            RowBox[{"Boole", "[", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"EALP", ">", "EALPmin"}], ")"}], "&&", 
              RowBox[{"(", 
               RowBox[{"EpprMin", "<", "Eppr", "<", "EpprMax"}], ")"}], "&&", 
              RowBox[{"(", 
               RowBox[{"etaPpr", ">", "etaPmin"}], ")"}], "&&", 
              RowBox[{"etaXmin", "<", "etaX", "<", "etaXmax"}]}], " ", 
             "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"\[Eta]epr", "=", 
            RowBox[{
             FractionBox["1", "2."], 
             RowBox[{"Log", "[", 
              FractionBox[
               RowBox[{"1", "+", "cepr"}], 
               RowBox[{"1", "-", "cepr"}]], "]"}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{"ifFBD", ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"pass", "=", 
               RowBox[{"pass", "*", 
                RowBox[{"Boole", "[", 
                 RowBox[{
                  RowBox[{"Q2minFBD", "<", 
                   RowBox[{"-", "t1"}]}], "&&", 
                  RowBox[{"\[Eta]epr", "<", "\[Eta]eprMaxFBD"}]}], "]"}]}]}], 
              ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
            "ifMid", ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"pass", "=", 
               RowBox[{"pass", "*", 
                RowBox[{"Boole", "[", 
                 RowBox[{
                  RowBox[{"Abs", "[", "\[Eta]epr", "]"}], "<", 
                  "\[Eta]Mid\[Eta]Cut"}], "]"}]}]}], ";"}]}], 
            "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"weights", "*", "pass"}], ",", "s2", ",", "t1", ",", 
             "t2", ",", "s1", ",", "Eppr", ",", "EALP", ",", "Eepr", ",", 
             "cppr", ",", "cX", ",", "cepr", ",", "etaPpr", ",", "etaX"}], 
            "}"}]}]}], "]"}], ",", 
        RowBox[{"CompilationTarget", "->", "\"\<C\>\""}], ",", 
        RowBox[{"RuntimeOptions", "->", "\"\<Speed\>\""}], ",", 
        RowBox[{"RuntimeAttributes", "->", 
         RowBox[{"{", "Listable", "}"}]}], ",", 
        RowBox[{"Parallelization", "->", "True"}]}], "]"}]}], "/.", 
     RowBox[{"ruleOwn", "[", 
      RowBox[{"{", "}"}], "]"}]}], "//", "ReleaseHold"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"checkIfCompiled", "[", "fraction\[Eta]CutComp", "]"}]}], "Input",
 CellChangeTimes->{{3.9773118638536263`*^9, 3.977311867070421*^9}, {
   3.977312524242729*^9, 3.977312581434038*^9}, {3.9773126217868786`*^9, 
   3.97731266711417*^9}, {3.977312769195034*^9, 3.9773127768176346`*^9}, {
   3.9817108839352303`*^9, 3.981710886475836*^9}, {3.982315091650852*^9, 
   3.9823152133458443`*^9}, {3.9836978167067013`*^9, 3.9836978429549255`*^9}, 
   3.996584536380838*^9},
 CellLabel->"In[77]:=",ExpressionUUID->"56668080-155d-1342-8de9-d4fc308010ef"],

