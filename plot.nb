                    RowBox[{"Exp", "[", "Q2", "]"}]}], ",", 
                    RowBox[{"{", 
                    RowBox[{"Q2", ",", 
                    RowBox[{"Log", "[", 
                    SuperscriptBox["10", 
                    RowBox[{"-", "3."}]], "]"}], ",", 
                    RowBox[{"Log", "[", "0.1", "]"}]}], "}"}], ",", 
                    RowBox[{
                    "Method", 
                    "->", "\"\<InterpolationPointsSubdivision\>\""}]}], "]"}],
                     "//", "Quiet"}]}]}]}], "\[IndentingNewLine]", "]"}]}]}], 
              "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", ",", 
             RowBox[{"{", 
              RowBox[{"meson", ",", "allMesons"}], "}"}]}], "]"}]}]}], 
         "\[IndentingNewLine]", ",", 
         RowBox[{"{", 
          RowBox[{"setup", ",", "EnergiesConfigurations"}], "}"}]}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{
      "Print", "[", "\"\<Importing existing MC samples... If no samples \
exist, generate using preparing-samples.nb\>\"", "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Do", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"filesample", "=", 
          RowBox[{"FileNameJoin", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"dir", "[", "\"\<datasets\>\"", "]"}], 
             ",", "\"\<Samples\>\"", ",", 
             RowBox[{"\"\<Distribution_\>\"", "<>", 
              RowBox[{"exportName", "[", "setup", "]"}], "<>", "\"\<_\>\"", "<>", 
              RowBox[{"mapMeson", "[", "P", "]"}], 
              "<>", "\"\<_No-cuts.mx\>\""}]}], "}"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"FileExistsQ", "[", "filesample", "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"mesonSample", "[", 
              RowBox[{"setup", ",", "P"}], "]"}], "=", 
             RowBox[{"Import", "[", 
              RowBox[{
               RowBox[{"FileNameJoin", "[", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"dir", "[", "\"\<datasets\>\"", "]"}], 
                  ",", "\"\<Samples\>\"", ",", 
                  RowBox[{"\"\<Distribution_\>\"", "<>", 
                   RowBox[{"exportName", "[", "setup", "]"}], 
                   "<>", "\"\<_\>\"", "<>", 
                   RowBox[{"mapMeson", "[", "P", "]"}], 
                   "<>", "\"\<_No-cuts.mx\>\""}]}], "}"}], "]"}], 
               ",", "\"\<MX\>\""}], "]"}]}], ";"}]}], "\[IndentingNewLine]", 
          "]"}]}], "\[IndentingNewLine]", ",", 
        RowBox[{"{", 
         RowBox[{"P", ",", "allMesons"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"setup", ",", "EnergiesConfigurations"}], "}"}]}], "]"}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"Print", "[", "\"\<Done\>\"", "]"}], ";"}]}], 
    "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]"}]}]], "Input",
