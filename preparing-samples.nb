Cell[CellGroupData[{

Cell["Definitions", "Subsection",
 CellChangeTimes->{{3.974640049411482*^9, 
  3.974640051301935*^9}},ExpressionUUID->"e2e74fac-a8ad-7c49-9cc7-\
8c97fb18a36f"],

Cell[CellGroupData[{

Cell["Meson decay block", "Subsubsection",
 CellChangeTimes->{{3.9746406436212826`*^9, 
  3.9746406457378235`*^9}},ExpressionUUID->"aab5e781-35be-aa4c-9657-\
f686db95925c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"VisDecaysBlock", "[", 
    RowBox[{"meson_", ",", "decayProcess_", ",", "samplemeson_"}], "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"mtest", "=", 
        RowBox[{"MASS", "[", "meson", "]"}]}], ",", "data", ",", "data0", ",",
        "num"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
        "meson", "==", "\"\<\!\(\*SuperscriptBox[\(\[Pi]\), \(0\)]\)\>\""}], ",",
         "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"decayProcess", "==", "\"\<2e\>\""}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"data", "=", 
            RowBox[{"BoostedDecayProductsWrapped", "[", 
             RowBox[{
             "mtest", ",", "\"\<\!\(\*SuperscriptBox[\(e\), \(+\)]\)\>\"", 
              ",", "\"\<\!\(\*SuperscriptBox[\(e\), \(-\)]\)\>\"", ",", 
              "samplemeson"}], "]"}]}], ";"}]}], "\[IndentingNewLine]", 
         "]"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"meson", "==", "\"\<\[Eta]\>\""}], ",", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"decayProcess", "==", "\"\<2\[Mu]\>\""}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"data", "=", 
            RowBox[{"BoostedDecayProductsWrapped", "[", 
             RowBox[{
             "mtest", ",", "\"\<\!\(\*SuperscriptBox[\(\[Mu]\), \(+\)]\)\>\"",
               ",", "\"\<\!\(\*SuperscriptBox[\(\[Mu]\), \(-\)]\)\>\"", ",", 
              "samplemeson"}], "]"}]}], ";"}]}], "\[IndentingNewLine]", 
         "]"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"meson", "==", "\"\<\[Eta]'\>\""}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"decayProcess", "==", "\"\<\[Pi]\[Rho]\>\""}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"data0", "=", 
            RowBox[{"BoostedDecayProductsWrapped", "[", 
             RowBox[{
             "mtest", ",", "\"\<\!\(\*SuperscriptBox[\(\[Pi]\), \(+\)]\)\>\"",
               ",", "\"\<\!\(\*SuperscriptBox[\(\[Rho]\), \(-\)]\)\>\"", ",", 
              "samplemeson"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"data", "=", 
            RowBox[{
             RowBox[{"Join", "[", 
              RowBox[{
               RowBox[{"data0", "[", 
                RowBox[{"[", 
                 RowBox[{"All", ",", 
                  RowBox[{"Range", "[", 
                   RowBox[{"3", "*", "indexDecay\[Eta]"}], "]"}]}], "]"}], 
                "]"}], ",", 
               RowBox[{"BoostedDecayProductsNoPostProcessingWrapped", "[", 
                RowBox[{
                 RowBox[{
                 "mVval", 
                  "[", "\"\<\!\(\*SuperscriptBox[\(\[Rho]\), \(-\)]\)\>\"", 
                  "]"}], ",", "\"\<\!\(\*SuperscriptBox[\(\[Pi]\), \(-\)]\)\>\
\"", ",", "\"\<\!\(\*SuperscriptBox[\(\[Pi]\), \(0\)]\)\>\"", ",", 
                 RowBox[{"data0", "[", 
                  RowBox[{"[", 
                   RowBox[{"All", ",", 
                    RowBox[{"Range", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"3", "*", "indexDecay\[Eta]"}], "+", "1"}], ",", 
                    RowBox[{"4", "*", "indexDecay\[Eta]"}]}], "]"}]}], "]"}], 
                  "]"}]}], "]"}], ",", "2"}], "]"}], "//", 
             "Developer`ToPackedArray"}]}], ";"}]}], "\[IndentingNewLine]", 
         "]"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
        "meson", "==", "\"\<\!\(\*SuperscriptBox[\(\[Rho]\), \(0\)]\)\>\""}], 
        ",", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"decayProcess", "==", "\"\<2\[Pi]\>\""}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"data", "=", 
            RowBox[{"BoostedDecayProductsWrapped", "[", 
             RowBox[{
             "mtest", ",", "\"\<\!\(\*SuperscriptBox[\(\[Pi]\), \(+\)]\)\>\"",
               ",", "\"\<\!\(\*SuperscriptBox[\(\[Pi]\), \(-\)]\)\>\"", ",", 
              "samplemeson"}], "]"}]}], ";"}]}], "\[IndentingNewLine]", 
         "]"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"meson", "==", "\"\<\[Phi]\>\""}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
           "decayProcess", 
            "==", "\"\<K\!\(\*OverscriptBox[\(K\), \(_\)]\)\>\""}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"num", "=", 
             RowBox[{"IntegerPart", "[", 
              RowBox[{
               RowBox[{"Length", "[", "samplemeson", "]"}], "*", 
               FractionBox[
                RowBox[{"BrVisible", "[", 
                 RowBox[{
                 "meson", 
                  ",", "\"\<\!\(\*SuperscriptBox[\(K\), \
\(+\)]\)\!\(\*SuperscriptBox[\(K\), \(-\)]\)\>\""}], "]"}], 
                RowBox[{
                 RowBox[{"BrVisible", "[", 
                  RowBox[{
                  "meson", 
                   ",", "\"\<\!\(\*SuperscriptBox[\(K\), \
\(+\)]\)\!\(\*SuperscriptBox[\(K\), \(-\)]\)\>\""}], "]"}], "+", 
                 RowBox[{"BrVisible", "[", 
                  RowBox[{
                  "meson", 
                   ",", "\"\<\!\(\*SubscriptBox[\(K\), \
\(L\)]\)\!\(\*SubscriptBox[\(K\), \(S\)]\)\>\""}], "]"}]}]]}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"data", "=", 
             RowBox[{
              RowBox[{"fastjoiner", "[", 
               RowBox[{
                RowBox[{"BoostedDecayProductsWrapped", "[", 
                 RowBox[{
                 "mtest", ",", "\"\<\!\(\*SuperscriptBox[\(K\), \(+\)]\)\>\"",
                   ",", "\"\<\!\(\*SuperscriptBox[\(K\), \(-\)]\)\>\"", ",", 
                  RowBox[{"Take", "[", 
                   RowBox[{"samplemeson", ",", 
                    RowBox[{"{", 
                    RowBox[{"1", ",", "num"}], "}"}]}], "]"}]}], "]"}], ",", 
                RowBox[{"BoostedDecayProductsWrapped", "[", 
                 RowBox[{
                 "mtest", ",", "\"\<\!\(\*SubscriptBox[\(K\), \(L\)]\)\>\"", 
                  ",", "\"\<\!\(\*SubscriptBox[\(K\), \(S\)]\)\>\"", ",", 
                  RowBox[{"Take", "[", 
                   RowBox[{"samplemeson", ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"num", "+", "1"}], ",", 
                    RowBox[{"Length", "[", "samplemeson", "]"}]}], "}"}]}], 
                   "]"}]}], "]"}]}], "]"}], "//", 
              "Developer`ToPackedArray"}]}], ";"}]}], "\[IndentingNewLine]", 
          "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
      "\[IndentingNewLine]", "data"}]}], "\[IndentingNewLine]", "]"}]}], 
  "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{{3.974640354259493*^9, 3.97464043831975*^9}, {
  3.974640476569355*^9, 3.9746404994571304`*^9}, {3.974640533318344*^9, 
  3.97464061621945*^9}, {3.97464066152569*^9, 3.974640672844387*^9}, {
  3.9746407039274445`*^9, 3.974640713972*^9}, {3.9746407509387817`*^9, 
  3.9746409435986824`*^9}},
 CellLabel->
  "In[561]:=",ExpressionUUID->"e16b5ea5-0a75-d14e-9d87-d120a1824c4c"]
}, Open  ]],

