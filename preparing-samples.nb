Cell["Wrapper", "Subsubsection",
 CellChangeTimes->{{3.9746406529490128`*^9, 
  3.9746406537822266`*^9}},ExpressionUUID->"4888b1db-2e54-9d42-bc33-\
354cb8cab2ab"],

Cell[BoxData[
 RowBox[{
  RowBox[{"BlockMesonDecay", "[", 
   RowBox[{
   "meson_", ",", "decay_", ",", "Eptest_", ",", "Eetest_", ",", 
    "ifWithCuts_"}], "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"mtest", "=", 
       RowBox[{"MASS", "[", "meson", "]"}]}], ",", 
      RowBox[{"Nevtest", "=", 
       RowBox[{"3", "*", 
        SuperscriptBox["10", "6"]}]}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{"ifWithCuts", ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "ifPredefinedSelection1", ",", "ifPredefinedSelection2", ",", 
           "ifPredefinedSelection3", ",", "ifPredefinedSelection4"}], "}"}], "=", 
         RowBox[{"{", 
          RowBox[{
          "ifSet1sel", ",", "ifSet2sel", ",", "ifSet3sel", ",", "ifSet4sel"}],
           "}"}]}], ";"}], "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "ifPredefinedSelection1", ",", "ifPredefinedSelection2", ",", 
          "ifPredefinedSelection3", ",", "ifPredefinedSelection4"}], "}"}], "=", 
        RowBox[{"{", 
         RowBox[{"False", ",", "False", ",", "False", ",", "False"}], 
         "}"}]}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"VisDecays", "[", 
       RowBox[{"meson", ",", "energyNameExport", ",", "ifWithCuts"}], "]"}], "=", 
      RowBox[{"VisDecaysBlock", "[", 
       RowBox[{"meson", ",", "decay", ",", 
        RowBox[{"findataP", "[", 
         RowBox[{"meson", ",", "energyNameExport", ",", "ifWithCuts"}], 
         "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"BlockFinal", "[", 
      RowBox[{
      "meson", ",", "mtest", ",", "1.", ",", "Eptest", ",", "Eetest", ",", 
       "Nevtest", ",", "mtest", ",", 
       RowBox[{"EpprMinTest", "[", "ifWithCuts", "]"}], ",", 
       RowBox[{"EpprMaxTest", "[", "ifWithCuts", "]"}], ",", 
       RowBox[{"etapprMinTest", "[", "ifWithCuts", "]"}], ",", 
       RowBox[{"etaXMinTest", "[", "ifWithCuts", "]"}], ",", 
       RowBox[{"etaXMaxTest", "[", "ifWithCuts", "]"}], ",", 
       RowBox[{"Q2minTest", "[", "ifWithCuts", "]"}], ",", 
       RowBox[{"Q2maxTest", "[", "ifWithCuts", "]"}], ",", 
       "ifPredefinedSelection1", ",", "ifPredefinedSelection2", ",", 
       "ifPredefinedSelection3", ",", "ifPredefinedSelection4"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\[Omega]Full", "[", 
       RowBox[{"meson", ",", "energyNameExport", ",", "ifWithCuts"}], "]"}], "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"!", "ifWithCuts"}], ",", "\[Sigma]tot", ",", 
        "\[Sigma]cuts"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\[Omega]VisibleDecays", "[", 
       RowBox[{"meson", ",", "energyNameExport", ",", "ifWithCuts"}], "]"}], "=", 
      RowBox[{
       RowBox[{"\[Omega]Full", "[", 
        RowBox[{"meson", ",", "energyNameExport", ",", "ifWithCuts"}], "]"}], 
       "*", 
       RowBox[{"BrVisible", "[", 
        RowBox[{"meson", ",", "decay"}], "]"}]}]}], ";"}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.9746400604684696`*^9, 3.97464033441189*^9}, {
   3.9746404198142014`*^9, 3.9746404626214943`*^9}, 3.974641480026268*^9, {
   3.9746415201208878`*^9, 3.9746415448462353`*^9}, {3.996560676523266*^9, 
