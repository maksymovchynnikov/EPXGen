   3.996558886863344*^9}},ExpressionUUID->"805425c7-03f9-7449-925a-\
fe32ee24e10a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Meson", " ", "list", " ", "to", " ", "be", " ", "specified", " ", 
    "here"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"listMesons", "=", 
     RowBox[{"{", 
      RowBox[{"\"\<\!\(\*SuperscriptBox[\(\[Pi]\), \(0\)]\)\>\"", 
       ",", "\"\<\[Eta]\>\"", ",", "\"\<\[Omega]\>\""}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<List of mesons for which samples will be \
generated/processed: \>\"", ",", "listMesons"}], "}"}], "]"}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"!", 
       RowBox[{"DirectoryQ", "[", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"dir", "[", "\"\<datasets\>\"", "]"}], 
           ",", "\"\<Samples\>\""}], "}"}], "]"}], "]"}]}], ",", 
      RowBox[{"CreateDirectory", "[", 
       RowBox[{
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"dir", "[", "\"\<datasets\>\"", "]"}], 
           ",", "\"\<Samples\>\""}], "}"}], "]"}], ",", 
        RowBox[{"CreateIntermediateDirectories", "->", "True"}]}], "]"}]}], 
     "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ExportMesonName", "[", 
     RowBox[{"energyName_", ",", "meson_", ",", "ifCuts_"}], "]"}], ":=", 
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"name", "=", 
        RowBox[{"\"\<Distribution_\>\"", "<>", "energyName"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"name", "=", 
        RowBox[{"name", "<>", "\"\<_\>\"", "<>", 
         RowBox[{"mapMeson", "[", "meson", "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"name", "=", 
        RowBox[{"name", "<>", "\"\<_\>\"", "<>", 
         RowBox[{"nameSelection", "[", "ifCuts", "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"name", "=", 
        RowBox[{"name", "<>", "\"\<.mx\>\""}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"dir", "[", "\"\<datasets\>\"", "]"}], 
          ",", "\"\<Samples\>\"", ",", "name"}], "}"}], "]"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"{", 
     RowBox[{"\"\<\!\(\*SuperscriptBox[\(\[Pi]\), \(0\)]\)\>\"", 
      ",", "\"\<\[Eta]\>\"", ",", "\"\<\[Eta]'\>\"", 
      ",", "\"\<\!\(\*SuperscriptBox[\(\[Rho]\), \(0\)]\)\>\"", 
      ",", "\"\<\[Omega]\>\"", ",", "\"\<\[Phi]\>\""}], "}"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Do", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"mesonFileName", "[", 
        RowBox[{"P", ",", "cut"}], "]"}], "=", 
       RowBox[{"ExportMesonName", "[", 
        RowBox[{"energyNameExport", ",", "P", ",", "cut"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"ifRegenerate", "[", 
        RowBox[{"P", ",", "cut"}], "]"}], "=", 
       RowBox[{
        RowBox[{"!", 
         RowBox[{"FileExistsQ", "[", 
          RowBox[{"mesonFileName", "[", 
           RowBox[{"P", ",", "cut"}], "]"}], "]"}]}], "||", 
        "ifRecomputing"}]}], ";"}], "\[IndentingNewLine]", ",", 
     RowBox[{"{", 
      RowBox[{"P", ",", "listMesons"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"cut", ",", "cutsToGenerate"}], "}"}]}], "]"}], "\[IndentingNewLine]", 
   RowBox[{
   "Print", "[", "\"\<Filenames for the samples to be generated:\>\"", "]"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"\"\<Meson\>\"", ",", "\"\<If cuts\>\"", 
        ",", "\"\<Filename\>\"", ",", "\"\<If regenerate\>\""}], "}"}], "}"}],
      ",", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"meson", ",", "cut", ",", 
           RowBox[{
            RowBox[{"FileNameSplit", "[", 
             RowBox[{"mesonFileName", "[", 
              RowBox[{"meson", ",", "cut"}], "]"}], "]"}], "//", "Last"}], ",", 
           RowBox[{"ifRegenerate", "[", 
            RowBox[{"meson", ",", "cut"}], "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"meson", ",", "listMesons"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"cut", ",", "cutsToGenerate"}], "}"}]}], "]"}], ",", "1"}], 
      "]"}]}], "]"}], "\[IndentingNewLine]"}]}]], "Input",
