Cell[CellGroupData[{

Cell["Definitions", "Subsection",
 CellChangeTimes->{{3.9745375104163685`*^9, 
  3.9745375131238995`*^9}},ExpressionUUID->"df71040f-1d47-6f41-9b78-\
c20170bd0d41"],

Cell[BoxData[
 RowBox[{
  RowBox[{"BlockCompute", "[", 
   RowBox[{
   "meson_", ",", "Eptest_", ",", "Eetest_", ",", "ifWithCuts_", ",", 
    "ifExport_"}], "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"mtest", "=", 
       RowBox[{"MASS", "[", "meson", "]"}]}], ",", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Number", " ", "of", " ", "events", " ", "per", " ", "sub"}], 
        "-", "sample"}], "*)"}], 
      RowBox[{"NeventsTest", "=", 
       SuperscriptBox["10", "7"]}], ",", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Total", " ", "number", " ", "of", " ", "events"}], " ", "-", 
        " ", 
        RowBox[{"after", " ", "collecting", " ", "sub"}], "-", "samples"}], 
       "*)"}], 
      RowBox[{"NfinSample", "=", 
       RowBox[{"2", "*", 
        SuperscriptBox["10", "7"]}]}], ",", "ifPredefinedSelection1", ",", 
      "ifPredefinedSelection2", ",", "ifPredefinedSelection3", ",", 
      "ifPredefinedSelection4", ",", 
      RowBox[{"fatest", "=", "1."}], ",", 
      RowBox[{"\[CapitalDelta]", "=", "0"}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Print", "[", 
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<Meson \>\"", ",", "meson"}], "}"}], "]"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{"ifExport", ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{"ifWithCuts", ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
             "ifPredefinedSelection1", ",", "ifPredefinedSelection2", ",", 
              "ifPredefinedSelection3", ",", "ifPredefinedSelection4"}], 
             "}"}], "=", 
            RowBox[{"{", 
             RowBox[{
             "ifSet1sel", ",", "ifSet2sel", ",", "ifSet3sel", ",", 
              "ifSet4sel"}], "}"}]}], ";"}], "\[IndentingNewLine]", ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
            "ifPredefinedSelection1", ",", "ifPredefinedSelection2", ",", 
             "ifPredefinedSelection3", ",", "ifPredefinedSelection4"}], "}"}],
            "=", 
           RowBox[{"{", 
            RowBox[{"False", ",", "False", ",", "False", ",", "False"}], 
            "}"}]}]}], "\[IndentingNewLine]", "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"findata", "=", 
         RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"While", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "findata", "]"}], "<", "NfinSample"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"BlockFinal", "[", 
            RowBox[{
            "meson", ",", "mtest", ",", "fatest", ",", "Eptest", ",", 
             "Eetest", ",", "NeventsTest", ",", "mtest", ",", 
             RowBox[{"EpprMinTest", "[", "ifWithCuts", "]"}], ",", 
             RowBox[{"EpprMaxTest", "[", "ifWithCuts", "]"}], ",", 
             RowBox[{"etapprMinTest", "[", "ifWithCuts", "]"}], ",", 
             RowBox[{"etaXMinTest", "[", "ifWithCuts", "]"}], ",", 
             RowBox[{"etaXMaxTest", "[", "ifWithCuts", "]"}], ",", 
             RowBox[{"Q2minTest", "[", "ifWithCuts", "]"}], ",", 
             RowBox[{"Q2maxTest", "[", "ifWithCuts", "]"}], ",", 
             "ifPredefinedSelection1", ",", "ifPredefinedSelection2", ",", 
             "ifPredefinedSelection3", ",", "ifPredefinedSelection4"}], "]"}],
            ";", "\[IndentingNewLine]", 
           RowBox[{"findata", "=", 
            RowBox[{
             RowBox[{"fastjoiner", "[", 
              RowBox[{"findata", ",", "subsample"}], "]"}], "//", 
             "Developer`ToPackedArray"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"\[CapitalDelta]", "+=", "1"}], ";", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"\[CapitalDelta]", "==", "10"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"Print", "[", 
               RowBox[{"Row", "[", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"Length", "[", "findata", "]"}], ",", "\"\</\>\"", ",",
                   "NfinSample", ",", "\"\< events are generared...\>\""}], 
                 "}"}], "]"}], "]"}], ";", "\[IndentingNewLine]", 
              RowBox[{"\[CapitalDelta]", "=", "0"}], ";"}]}], 
            "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", 
         "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", "\"\<Done\>\"", "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"findataP", "[", 
          RowBox[{"meson", ",", "energyNameExport", ",", "ifWithCuts"}], 
          "]"}], "=", "findata"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Export", "[", 
         RowBox[{
          RowBox[{"mesonFileName", "[", 
           RowBox[{"meson", ",", "ifWithCuts"}], "]"}], ",", 
          RowBox[{"findataP", "[", 
           RowBox[{"meson", ",", "energyNameExport", ",", "ifWithCuts"}], 
           "]"}], ",", "\"\<MX\>\""}], "]"}]}], "\[IndentingNewLine]", ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"findataP", "[", 
          RowBox[{"meson", ",", "energyNameExport", ",", "ifWithCuts"}], 
          "]"}], "=", 
         RowBox[{"Import", "[", 
          RowBox[{
           RowBox[{"mesonFileName", "[", 
            RowBox[{"meson", ",", "ifWithCuts"}], "]"}], ",", "\"\<MX\>\""}], 
          "]"}]}], ";"}]}], "\[IndentingNewLine]", "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.974535058600361*^9, 3.9745351589297504`*^9}, {
