Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Pre", "-", 
     RowBox[{"factor", " ", 
      FractionBox["1", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"2", "\[Pi]"}], ")"}], "5"], "2", 
        SqrtBox[
         RowBox[{"\[Lambda]", 
          RowBox[{"(", 
           RowBox[{"s", ",", 
            SuperscriptBox[
             SubscriptBox["m", "a"], "2"], ",", 
            SuperscriptBox[
             SubscriptBox["m", "b"], "2"]}], ")"}]}]]}]], " ", "from", " ", 
      "d\[Sigma]"}]}], " ", "=", " ", 
    RowBox[{
     FractionBox["1", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"2", "\[Pi]"}], ")"}], "5"], "2", 
       SqrtBox[
        RowBox[{"\[Lambda]", 
         RowBox[{"(", 
          RowBox[{"s", ",", 
           SuperscriptBox[
            SubscriptBox["m", "a"], "2"], ",", 
           SuperscriptBox[
            SubscriptBox["m", "b"], "2"]}], ")"}]}]]}]], 
     FractionBox["d\[CapitalPhi]", 
      RowBox[{
       SubscriptBox["ds", "1"], 
       SubscriptBox["ds", "2"], 
       SubscriptBox["dt", "1"], 
       SubscriptBox["dt", "2"]}]], 
     SubscriptBox["ds", "1"], 
     SubscriptBox["ds", "2"], 
     SubscriptBox["dt", "1"], 
     SubscriptBox["dt", "2"]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"M2tod\[Sigma]", "[", 
      RowBox[{"s_", ",", "ma_", ",", "mb_"}], "]"}], "=", 
     RowBox[{"(*", 
      RowBox[{
       FractionBox["1", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"2", "*", "Pi"}], ")"}], "9"]], "*", 
       FractionBox[
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"2", "*", "Pi"}], ")"}], "4"], 
        RowBox[{"4", 
         SqrtBox[
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox["ProductKaKb", "2"], "-", 
              RowBox[{
               SuperscriptBox["ma", "2"], "*", 
               SuperscriptBox["mb", "2"]}]}], ")"}], "//", "Expand"}], "//", 
           "Simplify"}]]}]]}], "*)"}], 
     FractionBox["1", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"2", "*", "Pi"}], ")"}], "5"], "*", "2", 
       SqrtBox[
        RowBox[{"\[Lambda]v", "[", 
         RowBox[{"s", ",", 
          SuperscriptBox["ma", "2"], ",", 
          SuperscriptBox["mb", "2"]}], "]"}]]}]]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Pre", "-", 
      RowBox[{"factor", " ", 
       FractionBox["d\[CapitalPhi]", 
        RowBox[{
         SubscriptBox["ds", "1"], 
         SubscriptBox["ds", "2"], 
         SubscriptBox["dt", "1"], 
         SubscriptBox["dt", "2"]}]], " ", "from", " ", "d\[Sigma]"}]}], " ", 
     "=", " ", 
     RowBox[{
      FractionBox["1", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"2", "\[Pi]"}], ")"}], "5"], "2", 
        SqrtBox[
         RowBox[{"\[Lambda]", 
          RowBox[{"(", 
           RowBox[{"s", ",", 
            SuperscriptBox[
             SubscriptBox["m", "a"], "2"], ",", 
            SuperscriptBox[
             SubscriptBox["m", "b"], "2"]}], ")"}]}]]}]], 
      FractionBox["d\[CapitalPhi]", 
       RowBox[{
        SubscriptBox["ds", "1"], 
        SubscriptBox["ds", "2"], 
        SubscriptBox["dt", "1"], 
        SubscriptBox["dt", "2"]}]], 
      SubscriptBox["ds", "1"], 
      SubscriptBox["ds", "2"], 
      SubscriptBox["dt", "1"], 
      SubscriptBox["dt", "2"]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"PhaseSpacePreFactor", "[", 
      RowBox[{
      "ma_", ",", "mb_", ",", "m1_", ",", "m2_", ",", "m3_", ",", "s_", ",", 
       "s2_", ",", "t1_", ",", "s1_", ",", "s1lower_", ",", "s1upper_"}], 
      "]"}], "=", 
     RowBox[{
      FractionBox["Pi", 
       RowBox[{"16", 
        SqrtBox[
         RowBox[{"\[Lambda]v", "[", 
          RowBox[{"s", ",", 
           SuperscriptBox["ma", "2"], ",", 
           SuperscriptBox["mb", "2"]}], "]"}]]}]], "*", 
      FractionBox["4", 
       SqrtBox[
        RowBox[{
         RowBox[{"\[Lambda]v", "[", 
          RowBox[{"s2", ",", "t1", ",", 
           SuperscriptBox["mb", "2"]}], "]"}], 
         RowBox[{"(", 
          RowBox[{"s1", "-", "s1lower"}], ")"}], 
         RowBox[{"(", 
          RowBox[{"s1upper", "-", "s1"}], ")"}]}]]]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"The", " ", "same", " ", "pre"}], "-", 
     RowBox[{"factor", " ", "but", " ", "multiplied", " ", "with", " ", 
      SqrtBox[
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["s", "1"], "-", 
          SubscriptBox["s", 
           RowBox[{"1", ",", "-"}]]}], ")"}], 
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["s", "1"], "-", 
          SubscriptBox["s", 
           RowBox[{"1", ",", "+"}]]}], ")"}]}]]}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"PhaseSpacePreFactorReduced", "[", 
      RowBox[{
      "ma_", ",", "mb_", ",", "m1_", ",", "m2_", ",", "m3_", ",", "s_", ",", 
