          RowBox[{"(", 
           RowBox[{"2", " ", "s2"}], ")"}]}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"direct", " ", "bounds"}], "*)"}], 
