Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"s1pm", "[", 
    RowBox[{
    "ma_", ",", "mb_", ",", "m1_", ",", "m2_", ",", "m3_", ",", "s_", ",", 
     "s2_", ",", "t1_", ",", "t2_"}], "]"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"s", "+", 
      SuperscriptBox["m3", "2"], "-", 
      RowBox[{
       FractionBox["1", 
        RowBox[{"\[Lambda]v", "[", 
         RowBox[{"s2", ",", "t1", ",", 
          SuperscriptBox["mb", "2"]}], "]"}]], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"DetVal", "[", 
          RowBox[{
          "ma", ",", "mb", ",", "m1", ",", "m2", ",", "m3", ",", "s", ",", 
           "s2", ",", "t1", ",", "t2"}], "]"}], "+", 
         RowBox[{"2", 
          RowBox[{"\[Sqrt]", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"G", "[", 
              RowBox[{"s", ",", "t1", ",", "s2", ",", 
               SuperscriptBox["ma", "2"], ",", 
               SuperscriptBox["mb", "2"], ",", 
               SuperscriptBox["m1", "2"]}], "]"}], "*", 
             RowBox[{"G", "[", 
              RowBox[{"s2", ",", "t2", ",", 
               SuperscriptBox["m3", "2"], ",", "t1", ",", 
               SuperscriptBox["mb", "2"], ",", 
               SuperscriptBox["m2", "2"]}], "]"}]}], ")"}]}]}]}], ")"}]}]}], 
     ",", 
     RowBox[{"s", "+", 
      SuperscriptBox["m3", "2"], "-", 
      RowBox[{
       FractionBox["1", 
        RowBox[{"\[Lambda]v", "[", 
         RowBox[{"s2", ",", "t1", ",", 
          SuperscriptBox["mb", "2"]}], "]"}]], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"DetVal", "[", 
          RowBox[{
          "ma", ",", "mb", ",", "m1", ",", "m2", ",", "m3", ",", "s", ",", 
           "s2", ",", "t1", ",", "t2"}], "]"}], "-", 
         RowBox[{"2", 
          RowBox[{"\[Sqrt]", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"G", "[", 
              RowBox[{"s", ",", "t1", ",", "s2", ",", 
               SuperscriptBox["ma", "2"], ",", 
               SuperscriptBox["mb", "2"], ",", 
               SuperscriptBox["m1", "2"]}], "]"}], "*", 
             RowBox[{"G", "[", 
              RowBox[{"s2", ",", "t2", ",", 
               SuperscriptBox["m3", "2"], ",", "t1", ",", 
               SuperscriptBox["mb", "2"], ",", 
               SuperscriptBox["m2", "2"]}], "]"}]}], ")"}]}]}]}], ")"}]}]}]}],
     "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"t2pm", "[", 
    RowBox[{"mb_", ",", "m2_", ",", "m3_", ",", "s2_", ",", "t1_"}], "]"}], 
   "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      SuperscriptBox["mb", "2"], "+", 
      SuperscriptBox["m3", "2"], "-", 
      RowBox[{
       FractionBox["1", 
        RowBox[{"2", "*", "s2"}]], 
       RowBox[{"(", 
        RowBox[{"s2", "+", 
         SuperscriptBox["mb", "2"], "-", "t1"}], ")"}], 
       RowBox[{"(", 
        RowBox[{"s2", "+", 
         SuperscriptBox["m3", "2"], "-", 
         SuperscriptBox["m2", "2"]}], ")"}]}], "-", 
      RowBox[{
       FractionBox["1", 
        RowBox[{"2", "*", "s2"}]], 
       SqrtBox[
        RowBox[{"\[Lambda]v", "[", 
         RowBox[{"s2", ",", 
          SuperscriptBox["mb", "2"], ",", "t1"}], "]"}]], 
       SqrtBox[
        RowBox[{"\[Lambda]v", "[", 
         RowBox[{"s2", ",", 
          SuperscriptBox["m3", "2"], ",", 
          SuperscriptBox["m2", "2"]}], "]"}]]}]}], ",", 
     RowBox[{
      SuperscriptBox["mb", "2"], "+", 
      SuperscriptBox["m3", "2"], "-", 
      RowBox[{
       FractionBox["1", 
        RowBox[{"2", "*", "s2"}]], 
       RowBox[{"(", 
        RowBox[{"s2", "+", 
         SuperscriptBox["mb", "2"], "-", "t1"}], ")"}], 
       RowBox[{"(", 
        RowBox[{"s2", "+", 
         SuperscriptBox["m3", "2"], "-", 
         SuperscriptBox["m2", "2"]}], ")"}]}], "+", 
      RowBox[{
       FractionBox["1", 
        RowBox[{"2", "*", "s2"}]], 
       SqrtBox[
        RowBox[{"\[Lambda]v", "[", 
         RowBox[{"s2", ",", 
          SuperscriptBox["mb", "2"], ",", "t1"}], "]"}]], 
       SqrtBox[
        RowBox[{"\[Lambda]v", "[", 
         RowBox[{"s2", ",", 
          SuperscriptBox["m3", "2"], ",", 
          SuperscriptBox["m2", "2"]}], "]"}]]}]}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"t1pm", "[", 
    RowBox[{"ma_", ",", "mb_", ",", "m1_", ",", "s_", ",", "s2_"}], "]"}], 
   "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      SuperscriptBox["ma", "2"], "+", 
      SuperscriptBox["m1", "2"], "-", 
      RowBox[{
       FractionBox["1", 
        RowBox[{"2", "s"}]], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"s", "+", 
            SuperscriptBox["ma", "2"], "-", 
            SuperscriptBox["mb", "2"]}], ")"}], 
          RowBox[{"(", 
           RowBox[{"s", "-", "s2", "+", 
            SuperscriptBox["m1", "2"]}], ")"}]}], "+", 
         RowBox[{
          SqrtBox[
           RowBox[{"\[Lambda]v", "[", 
            RowBox[{"s", ",", 
             SuperscriptBox["ma", "2"], ",", 
             SuperscriptBox["mb", "2"]}], "]"}]], 
          SqrtBox[
           RowBox[{"\[Lambda]v", "[", 
            RowBox[{"s", ",", "s2", ",", 
             SuperscriptBox["m1", "2"]}], "]"}]]}]}], ")"}]}]}], ",", 
     RowBox[{
      SuperscriptBox["ma", "2"], "+", 
      SuperscriptBox["m1", "2"], "-", 
      RowBox[{
       FractionBox["1", 
        RowBox[{"2", "s"}]], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"s", "+", 
            SuperscriptBox["ma", "2"], "-", 
            SuperscriptBox["mb", "2"]}], ")"}], 
          RowBox[{"(", 
           RowBox[{"s", "-", "s2", "+", 
            SuperscriptBox["m1", "2"]}], ")"}]}], "-", 
         RowBox[{
          SqrtBox[
           RowBox[{"\[Lambda]v", "[", 
            RowBox[{"s", ",", 
             SuperscriptBox["ma", "2"], ",", 
             SuperscriptBox["mb", "2"]}], "]"}]], 
          SqrtBox[
           RowBox[{"\[Lambda]v", "[", 
            RowBox[{"s", ",", "s2", ",", 
             SuperscriptBox["m1", "2"]}], "]"}]]}]}], ")"}]}]}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"s2pm", "[", 
     RowBox[{"m1_", ",", "m2_", ",", "m3_", ",", "s_"}], "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"m2", "+", "m3"}], ")"}], "2"], ",", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         SqrtBox["s"], "-", "m1"}], ")"}], "2"]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]", 
