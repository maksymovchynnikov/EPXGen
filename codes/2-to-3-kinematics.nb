Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"Eq", ".", " ", "2.4"}], " ", "of", " ", "the", " ", "book", " ",
      "defines", " ", "the", " ", "phase", " ", 
     RowBox[{"space", ":", " ", "\[CapitalPhi]"}]}], " ", "=", " ", 
    RowBox[{"\[Integral]", 
     RowBox[{
      FractionBox[
       RowBox[{
        SuperscriptBox["d", "3"], 
        SubscriptBox["p", "i"]}], 
       RowBox[{"2", 
        SubscriptBox["E", "i"]}]], 
      SuperscriptBox["\[Delta]", "4"], 
      RowBox[{"(", "...", ")"}]}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"The", " ", "cross", " ", "section", " ", "is", " ", "\[Sigma]"}],
     " ", "=", " ", 
    RowBox[{
     RowBox[{
      FractionBox[
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"2", "\[Pi]"}], ")"}], "4"], 
       RowBox[{
        SubscriptBox["\[Product]", "i"], 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"2", "\[Pi]"}], ")"}], 
         RowBox[{"3", "i"}]]}]], 
      FractionBox["1", 
       RowBox[{"|", 
        OverscriptBox["v", "_"], "|"}]], 
      FractionBox["1", 
       RowBox[{"2", 
        SubscriptBox["E", "a"], "2", 
        SubscriptBox["E", "b"]}]], 
      RowBox[{"\[Integral]", "d\[CapitalPhi]"}]}], " ", "|", "M", 
     SuperscriptBox["|", "2"]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"v", " ", "may", " ", "be", " ", "expressed", " ", "as", " ", 
    FractionBox[
     SqrtBox[
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["k", "a"], 
          SubscriptBox["k", "b"]}], ")"}], "2"], "-", 
       RowBox[{
        SuperscriptBox[
         SubscriptBox["m", "a"], "2"], 
        SuperscriptBox[
         SubscriptBox["m", "b"], "2"]}]}]], 
     RowBox[{
      SubscriptBox["E", "a"], 
      SubscriptBox["E", "b"]}]], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Weinberg", "'"}], "s", " ", "QFT", " ", "Vol", ".1"}], ")"}]}],
    "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Therefore", ",", " ", 
    RowBox[{
    "the", " ", "coefficient", " ", "#", " ", "between", " ", 
     "d\[CapitalPhi]", " ", "and", " ", "cross", " ", "section"}], ",", " ", 
    RowBox[{"d\[Sigma]", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"#", " ", 
        RowBox[{"\[Integral]", " ", "d\[CapitalPhi]"}]}], " ", "|", "M", 
       SuperscriptBox["|", "2"], " ", 
       RowBox[{"for", " ", "the", " ", "scattering", " ", "2"}]}], "\[Rule]", 
      RowBox[{
      "3", " ", "when", " ", "one", " ", "of", " ", "incoming", " ", 
       "particles", " ", "is", " ", "massless", " ", "is", " ", 
       FractionBox["1", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"2", "\[Pi]"}], ")"}], "5"]], 
       FractionBox["1", 
        RowBox[{"4", 
         SqrtBox[
          RowBox[{
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{
              SubscriptBox["k", "a"], 
              SubscriptBox["k", "b"]}], ")"}], "2"], "-", 
           RowBox[{
            SuperscriptBox[
             SubscriptBox["m", "a"], "2"], 
            SuperscriptBox[
             SubscriptBox["m", "b"], "2"]}]}]]}]]}]}]}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"\[Lambda]v", "[", 
      RowBox[{"av_", ",", "bv_", ",", "cv_"}], "]"}], "=", " ", 
     RowBox[{
      RowBox[{"av", "^", "2"}], "+", 
      RowBox[{"bv", "^", "2"}], "+", 
      RowBox[{"cv", "^", "2"}], " ", "-", " ", 
      RowBox[{"2", "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"av", "*", "bv"}], "+", 
         RowBox[{"av", "*", "cv"}], "+", 
         RowBox[{"bv", "*", "cv"}]}], ")"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"G", "[", 
      RowBox[{"x_", ",", "y_", ",", "z_", ",", "u_", ",", "v_", ",", "w_"}], 
      "]"}], "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "1"}], "/", "2"}], "*", 
      RowBox[{"Det", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "1", ",", "1", ",", "1", ",", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "0", ",", "v", ",", "x", ",", "z"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "v", ",", "0", ",", "u", ",", "y"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "x", ",", "u", ",", "0", ",", "w"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "z", ",", "y", ",", "w", ",", "0"}], "}"}]}], 
        "}"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"DetVal", "[", 
      RowBox[{
      "ma_", ",", "mb_", ",", "m1_", ",", "m2_", ",", "m3_", ",", "s_", ",", 
       "s2_", ",", "t1_", ",", "t2_"}], "]"}], "=", 
     RowBox[{
      RowBox[{"Det", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"2", "*", 
            SuperscriptBox["mb", "2"]}], ",", 
           RowBox[{"s2", "-", "t1", "+", 
            SuperscriptBox["mb", "2"]}], ",", 
           RowBox[{
            SuperscriptBox["mb", "2"], "+", 
            SuperscriptBox["m3", "2"], "-", "t2"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"s2", "-", "t1", "+", 
            SuperscriptBox["mb", "2"]}], ",", 
           RowBox[{"2", "s2"}], ",", 
           RowBox[{"s2", "-", 
            SuperscriptBox["m2", "2"], "+", 
            SuperscriptBox["m3", "2"]}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"s", "-", 
            SuperscriptBox["ma", "2"], "+", 
            SuperscriptBox["mb", "2"]}], ",", 
           RowBox[{"s", "+", "s2", "-", 
            SuperscriptBox["m1", "2"]}], ",", "0"}], "}"}]}], "}"}], "]"}], "//",
       "Simplify"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.967799242293949*^9, 3.967799242826809*^9}},
 CellLabel->"In[79]:=",ExpressionUUID->"eaf6066f-eb60-9941-8d96-611cf8429096"],

