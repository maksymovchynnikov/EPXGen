   RowBox[{
    RowBox[{"s2pm", "[", 
     RowBox[{"m1", ",", "m2", ",", "m3", ",", "s"}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"s2max", "[", 
    RowBox[{"m1_", ",", "m2_", ",", "m3_", ",", "s_"}], "]"}], "=", 
