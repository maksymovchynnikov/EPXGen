 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Numerically", " ", "stable", " ", "form", " ", "of", " ", "t1max"}], 
   "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"t1pmStable", "[", 
     RowBox[{"ma_", ",", "mb_", ",", "m1_", ",", "s_", ",", "s2_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"a", "=", 
         RowBox[{"ma", "^", "2"}]}], ",", 
        RowBox[{"b", "=", 
         RowBox[{"mb", "^", "2"}]}], ",", 
        RowBox[{"c", "=", 
         RowBox[{"m1", "^", "2"}]}], ",", 
        RowBox[{"d", "=", "s2"}], ",", "L1", ",", "L2", ",", "P", ",", "A", 
        ",", "den", ",", "num", ",", "diff"}], "}"}], ",", 
      RowBox[{
       RowBox[{"L1", "=", 
        RowBox[{"\[Lambda]v", "[", 
         RowBox[{"s", ",", "a", ",", "b"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"L2", "=", 
        RowBox[{"\[Lambda]v", "[", 
         RowBox[{"s", ",", "d", ",", "c"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"P", "=", 
        RowBox[{
         RowBox[{"Sqrt", "[", "L1", "]"}], " ", 
         RowBox[{"Sqrt", "[", "L2", "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"A", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"s", "+", "a", "-", "b"}], ")"}], " ", 
         RowBox[{"(", 
          RowBox[{"s", "-", "d", "+", "c"}], ")"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"stable", " ", "version", " ", "of", " ", 
         RowBox[{"(", 
          RowBox[{"A", "-", "P"}], ")"}]}], "*)"}], 
       RowBox[{"den", "=", 
        RowBox[{"A", "+", "P"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"num", "=", 
        RowBox[{"4", " ", "s", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"a", "^", "2"}], " ", "c"}], "-", 
           RowBox[{"2", " ", "a", " ", "b", " ", "c"}], "+", 
           RowBox[{"a", " ", 
            RowBox[{"c", "^", "2"}]}], "-", 
           RowBox[{"2", " ", "a", " ", "c", " ", "d"}], "+", 
           RowBox[{"a", " ", 
            RowBox[{"d", "^", "2"}]}], "-", 
           RowBox[{"2", " ", "a", " ", "d", " ", "s"}], "+", 
           RowBox[{"a", " ", 
            RowBox[{"s", "^", "2"}]}], "+", 
           RowBox[{
            RowBox[{"b", "^", "2"}], " ", "c"}], "-", 
           RowBox[{"2", " ", "b", " ", "c", " ", "s"}], "+", 
           RowBox[{"c", " ", 
            RowBox[{"s", "^", "2"}]}]}], ")"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"diff", "=", 
        RowBox[{"num", "/", "den"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"a", "+", "c", "-", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"A", "+", "P"}], ")"}], "/", 
           RowBox[{"(", 
            RowBox[{"2", " ", "s"}], ")"}]}]}], ",", 
         RowBox[{"(*", 
          RowBox[{
          "this", " ", "one", " ", "is", " ", "usually", " ", "fine"}], 
          "*)"}], 
         RowBox[{"a", "+", "c", "-", 
          RowBox[{"diff", "/", 
           RowBox[{"(", 
            RowBox[{"2", " ", "s"}], ")"}]}]}]}], "          ", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"stable", " ", "replacement", " ", "for", " ", "A"}], "-", 
          "P"}], "*)"}], "}"}]}]}], "]"}]}], ";"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"t1maxStable", "[", 
