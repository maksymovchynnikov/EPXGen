 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"t2pmStable", "[", 
     RowBox[{"mb_", ",", "m2_", ",", "m3_", ",", "s2_", ",", "t1_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"b", "=", 
         RowBox[{"mb", "^", "2"}]}], ",", 
        RowBox[{"c", "=", 
         RowBox[{"m3", "^", "2"}]}], ",", 
        RowBox[{"d", "=", 
         RowBox[{"m2", "^", "2"}]}], ",", "L1", ",", "L2", ",", "P", ",", "C",
         ",", "t2L", ",", "t2Udir", ",", "num", ",", "t2U"}], "}"}], ",", 
      RowBox[{
       RowBox[{"L1", "=", 
        RowBox[{"\[Lambda]v", "[", 
         RowBox[{"s2", ",", "b", ",", "t1"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"L2", "=", 
        RowBox[{"\[Lambda]v", "[", 
         RowBox[{"s2", ",", "c", ",", "d"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"P", "=", 
        RowBox[{
         RowBox[{"Sqrt", "[", "L1", "]"}], " ", 
         RowBox[{"Sqrt", "[", "L2", "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"C", "=", 
        RowBox[{"b", "+", "c", "-", 
         RowBox[{
          RowBox[{"(", 
