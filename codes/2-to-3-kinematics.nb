           RowBox[{"c", " ", "s2", " ", "t1"}], "+", 
           RowBox[{"c", " ", 
            RowBox[{"t1", "^", "2"}]}]}], ")"}], "/", "s2"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
          RowBox[{"stable", " ", 
           RowBox[{"sum", ":", 
            RowBox[{"(", 
             RowBox[{"C", "+", "D"}], ")"}]}]}], "=", 
