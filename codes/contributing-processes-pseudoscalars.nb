Cell[BoxData[
 RowBox[{"If", "[", 
  RowBox[{
   RowBox[{"TrueQ", "[", "ifRewritingP", "]"}], ",", 
   RowBox[{"CompoundExpression", "[", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"!", "ifFileMsquaredPexists"}], ",", 
      RowBox[{
       RowBox[{"JVecHadrV", "=", 
        RowBox[{"gV\[Gamma]P", " ", "gVNN", " ", "ReggeV", " ", 
         RowBox[{"LeviCivita", "[", 
          RowBox[{"\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]"}], 
          "]"}], " ", 
         RowBox[{"FV", "[", 
          RowBox[{
           RowBox[{"momLab", "[", "\[Gamma]", "]"}], ",", "\[Nu]"}], "]"}], " ", 
         RowBox[{"FV", "[", 
          RowBox[{
           RowBox[{"momLab", "[", "\[CapitalDelta]", "]"}], ",", "\[Alpha]"}],
           "]"}], " ", 
         RowBox[{"ubarppr", ".", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"GA", "[", "\[Beta]", "]"}], " ", 
             RowBox[{"(", 
              RowBox[{"1", "+", "\[Kappa]V"}], ")"}]}], "-", 
            FractionBox[
             RowBox[{"\[Kappa]V", " ", 
              RowBox[{"FV", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"momLab", "[", "p", "]"}], "+", 
                 RowBox[{"momLab", "[", "ppr", "]"}]}], ",", "\[Beta]"}], 
               "]"}]}], 
             RowBox[{"2", " ", "mp"}]]}], ")"}], ".", "up"}]}]}], ";", 
       RowBox[{"MelementV1", "=", 
        RowBox[{
         RowBox[{"Simplify", "[", 
          RowBox[{"Contract", "[", 
           RowBox[{"ExpandScalarProduct", "[", 
            RowBox[{
            "FphotoToElectro", " ", "LeptonicPiece", " ", "JVecHadrV"}], 
            "]"}], "]"}], "]"}], "/.", "\[VeryThinSpace]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"gV\[Gamma]P", "\[Rule]", "g\[Rho]\[Gamma]P"}], ",", 
           RowBox[{"gVNN", "\[Rule]", "g\[Rho]NN"}], ",", 
           RowBox[{"\[Kappa]V", "\[Rule]", "\[Kappa]\[Rho]"}], ",", 
           RowBox[{"ReggeV", "\[Rule]", "Regge\[Rho]"}]}], "}"}]}]}], ";", 
       RowBox[{"MelementV2", "=", 
        RowBox[{"MelementV1", "/.", "\[VeryThinSpace]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"g\[Rho]\[Gamma]P", "\[Rule]", "g\[Omega]\[Gamma]P"}], ",", 
           RowBox[{"g\[Rho]NN", "\[Rule]", "g\[Omega]NN"}], ",", 
           RowBox[{"\[Kappa]\[Rho]", "\[Rule]", "\[Kappa]\[Omega]"}], ",", 
           RowBox[{"Regge\[Rho]", "\[Rule]", "Regge\[Omega]"}]}], "}"}]}]}], ";", 
       RowBox[{"replRuleVP", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Regge\[Rho]", "\[Rule]", "Regge\[Rho]Star"}], ",", 
          RowBox[{"Regge\[Omega]", "\[Rule]", "Regge\[Omega]Star"}]}], 
         "}"}]}], ";", 
       RowBox[{"MelementSquaredV1", "=", 
        RowBox[{"MsquaredXinsertedKinematics", "[", 
         RowBox[{
         "MelementV1", ",", "MelementV1", ",", "False", ",", "replRuleVP", ",",
           "replRuleVP"}], "]"}]}], ";", 
       RowBox[{"MelementSquaredV2", "=", 
        RowBox[{"MelementSquaredV1", "/.", "\[VeryThinSpace]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"g\[Rho]\[Gamma]P", "\[Rule]", "g\[Omega]\[Gamma]P"}], ",", 
           RowBox[{"g\[Rho]NN", "\[Rule]", "g\[Omega]NN"}], ",", 
           RowBox[{"\[Kappa]\[Rho]", "\[Rule]", "\[Kappa]\[Omega]"}], ",", 
           RowBox[{"Regge\[Rho]", "\[Rule]", "Regge\[Omega]"}], ",", 
