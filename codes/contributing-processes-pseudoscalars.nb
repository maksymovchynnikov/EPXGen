Cell[BoxData[
 RowBox[{"If", "[", 
  RowBox[{
   RowBox[{"TrueQ", "[", "ifRewritingP", "]"}], ",", 
   RowBox[{"CompoundExpression", "[", 
    RowBox[{
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"expr", "=", 
         RowBox[{"MsquaredPprodV", "[", 
          RowBox[{
