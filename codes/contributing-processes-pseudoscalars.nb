           "g\[Omega]NN_", ",", "\[Kappa]\[Omega]_", ",", "Regge\[Omega]_", ",",
            "Regge\[Omega]Star_", ",", "FphotoToElectro_"}], "]"}], "=", 
         RowBox[{"M2KernelFiniteVTemp", "[", "expr", "]"}]}], ";"}]}], "]"}], 
     " ", 
