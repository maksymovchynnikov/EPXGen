            "g\[Omega]\[Gamma]P", ",", "g\[Omega]NN", ",", "\[Kappa]\[Omega]",
            ",", "Regge\[Omega]", ",", "Regge\[Omega]Star", ",", 
           "FphotoToElectro"}], "]"}]}], "}"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"d\[Sigma]Pprodds2dt1dt2ds1V", "[", 
          RowBox[{
          "s_", ",", "mp_", ",", "\[Alpha]EM_", ",", "mX_", ",", "s2_", ",", 
           "t1_", ",", "t2_", ",", "s1_", ",", "g\[Rho]\[Gamma]P_", ",", 
           "g\[Rho]NN_", ",", "\[Kappa]\[Rho]_", ",", "Regge\[Rho]_", ",", 
           "Regge\[Rho]Star_", ",", "g\[Omega]\[Gamma]P_", ",", 
           "g\[Omega]NN_", ",", "\[Kappa]\[Omega]_", ",", "Regge\[Omega]_", ",",
            "Regge\[Omega]Star_", ",", "FphotoToElectro_"}], "]"}], "=", 
         RowBox[{"d\[Sigma]Vprodds2dt1dt2ds1Temp", "[", "expr", "]"}]}], ";", 
        RowBox[{
         RowBox[{"M2KernelFinitePV", "[", 
          RowBox[{
          "s_", ",", "mp_", ",", "\[Alpha]EM_", ",", "mX_", ",", "s2_", ",", 
           "t1_", ",", "t2_", ",", "s1_", ",", "g\[Rho]\[Gamma]P_", ",", 
           "g\[Rho]NN_", ",", "\[Kappa]\[Rho]_", ",", "Regge\[Rho]_", ",", 
