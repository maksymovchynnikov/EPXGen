Cell[BoxData[
 RowBox[{"If", "[", 
  RowBox[{
   RowBox[{"TrueQ", "[", "ifRewritingP", "]"}], ",", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"replNumericProdP", "[", 
        RowBox[{"expr_", ",", "P_"}], "]"}], ":=", 
       RowBox[{"Block", "[", 
        RowBox[{
         RowBox[{"{", "}"}], ",", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"P", "\[NotEqual]", "\"\<ALP\>\""}], ",", 
            RowBox[{
             RowBox[{"replsFactors", "=", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Regge\[Rho]", "\[Rule]", 
                 RowBox[{"ReggeizedPropagator\[Rho]", "[", 
                  RowBox[{"s2", ",", "t2", ",", "P"}], "]"}]}], ",", 
                RowBox[{"Regge\[Rho]Star", "\[Rule]", 
                 RowBox[{"ReggeizedPropagator\[Rho]Star", "[", 
                  RowBox[{"s2", ",", "t2", ",", "P"}], "]"}]}], ",", 
                RowBox[{"Regge\[Omega]", "\[Rule]", 
                 RowBox[{"ReggeizedPropagator\[Omega]", "[", 
                  RowBox[{"s2", ",", "t2", ",", "P"}], "]"}]}], ",", 
                RowBox[{"Regge\[Omega]Star", "\[Rule]", 
                 RowBox[{"ReggeizedPropagator\[Omega]Star", "[", 
                  RowBox[{"s2", ",", "t2", ",", "P"}], "]"}]}], ",", 
                RowBox[{"FphotoToElectro", "\[Rule]", 
                 RowBox[{"FphotoToElectroP", "[", 
                  RowBox[{"P", ",", 
                   RowBox[{"-", "t1"}], ",", "mX"}], "]"}]}]}], "}"}]}], ";", 
             RowBox[{"replsNumbers", "=", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"me", "\[Rule]", "meval"}], ",", 
                RowBox[{"mp", "\[Rule]", "mpval"}], ",", 
                RowBox[{"\[Alpha]EM", "\[Rule]", "\[Alpha]EMval"}], ",", 
                RowBox[{"g\[Rho]NN", "\[Rule]", 
                 RowBox[{
                 "gVNNval", 
                  "[", "\"\<\!\(\*SuperscriptBox[\(\[Rho]\), \(0\)]\)\>\"", 
                  "]"}]}], ",", 
                RowBox[{"g\[Omega]NN", "\[Rule]", 
                 RowBox[{"gVNNval", "[", "\"\<\[Omega]\>\"", "]"}]}], ",", 
                RowBox[{"\[Kappa]\[Rho]", "\[Rule]", 
                 RowBox[{
                 "\[Kappa]Vval", 
                  "[", "\"\<\!\(\*SuperscriptBox[\(\[Rho]\), \(0\)]\)\>\"", 
                  "]"}]}], ",", 
                RowBox[{"\[Kappa]\[Omega]", "\[Rule]", 
                 RowBox[{"\[Kappa]Vval", "[", "\"\<\[Omega]\>\"", "]"}]}], ",", 
                RowBox[{"mX", "\[Rule]", 
                 RowBox[{"MASS", "[", "P", "]"}]}], ",", 
                RowBox[{"g\[Rho]\[Gamma]P", "\[Rule]", 
                 RowBox[{"gPV\[Gamma]", "[", 
                  RowBox[{
                  "P", ",", "\"\<\!\(\*SuperscriptBox[\(\[Rho]\), \
\(0\)]\)\>\""}], "]"}]}], ",", 
                RowBox[{"g\[Omega]\[Gamma]P", "\[Rule]", 
                 RowBox[{"gPV\[Gamma]", "[", 
                  RowBox[{"P", ",", "\"\<\[Omega]\>\""}], "]"}]}]}], "}"}]}], 
             ";"}], "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"fatest", "=", "f\[Pi]Val"}], ";", 
             RowBox[{"replsFactors", "=", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Regge\[Rho]", "\[Rule]", 
                 RowBox[{"ReggeizedPropagatorTimesCouplingALP", "[", 
                  
                  RowBox[{"\"\<\!\(\*SuperscriptBox[\(\[Rho]\), \(0\)]\)\>\"",
                    ",", "mX", ",", "fatest", ",", "s2", ",", "t2"}], "]"}]}],
                 ",", 
                RowBox[{"Regge\[Rho]Star", "\[Rule]", 
                 RowBox[{"ReggeizedPropagatorTimesCouplingALPStar", "[", 
                  
                  RowBox[{"\"\<\!\(\*SuperscriptBox[\(\[Rho]\), \(0\)]\)\>\"",
                    ",", "mX", ",", "fatest", ",", "s2", ",", "t2"}], "]"}]}],
                 ",", 
                RowBox[{"Regge\[Omega]", "\[Rule]", 
                 RowBox[{"ReggeizedPropagatorTimesCouplingALP", "[", 
                  RowBox[{"\"\<\[Omega]\>\"", ",", "mX", ",", "fatest", ",", 
                   "s2", ",", "t2"}], "]"}]}], ",", 
                RowBox[{"Regge\[Omega]Star", "\[Rule]", 
                 RowBox[{"ReggeizedPropagatorTimesCouplingALPStar", "[", 
                  
                  RowBox[{"\"\<\[Omega]\>\"", ",", "mX", ",", "fatest", ",", 
                   "s2", ",", "t2"}], "]"}]}], ",", 
                RowBox[{"FphotoToElectro", "\[Rule]", 
                 RowBox[{"FphotoToElectroP", "[", 
                  RowBox[{"\"\<ALP\>\"", ",", 
                   RowBox[{"-", "t1"}], ",", "mX"}], "]"}]}]}], "}"}]}], ";", 
             RowBox[{"replsNumbers", "=", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"me", "\[Rule]", "meval"}], ",", 
                RowBox[{"mp", "\[Rule]", "mpval"}], ",", 
                RowBox[{"\[Alpha]EM", "\[Rule]", "\[Alpha]EMval"}], ",", 
                RowBox[{"g\[Rho]NN", "\[Rule]", 
                 RowBox[{
                 "gVNNval", 
                  "[", "\"\<\!\(\*SuperscriptBox[\(\[Rho]\), \(0\)]\)\>\"", 
                  "]"}]}], ",", 
                RowBox[{"g\[Omega]NN", "\[Rule]", 
                 RowBox[{"gVNNval", "[", "\"\<\[Omega]\>\"", "]"}]}], ",", 
                RowBox[{"\[Kappa]\[Rho]", "\[Rule]", 
                 RowBox[{
                 "\[Kappa]Vval", 
                  "[", "\"\<\!\(\*SuperscriptBox[\(\[Rho]\), \(0\)]\)\>\"", 
                  "]"}]}], ",", 
                RowBox[{"\[Kappa]\[Omega]", "\[Rule]", 
                 RowBox[{"\[Kappa]Vval", "[", "\"\<\[Omega]\>\"", "]"}]}], ",", 
                RowBox[{"g\[Rho]\[Gamma]P", "\[Rule]", "1"}], ",", 
                RowBox[{"g\[Omega]\[Gamma]P", "\[Rule]", "1"}]}], "}"}]}], 
             ";"}]}], "]"}], ";", 
          RowBox[{
           RowBox[{"expr", "/.", "\[VeryThinSpace]", "replsFactors"}], "/.", 
           "\[VeryThinSpace]", "replsNumbers"}]}]}], "]"}]}], ";", "Null", ";", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"d\[Sigma]Pprodds2dt1dt2", "[", 
           RowBox[{
           "mX_", ",", "s_", ",", "s2_", ",", "t1_", ",", "t2_", ",", "P", 
            ",", "\"\<V\>\""}], "]"}], "=", 
          RowBox[{"replNumericProdP", "[", 
           RowBox[{
            RowBox[{"d\[Sigma]Pprodds2dt1dt2VTemp", "[", 
             RowBox[{
             "s", ",", "mp", ",", "\[Alpha]EM", ",", "mX", ",", "s2", ",", 
              "t1", ",", "t2", ",", "g\[Rho]\[Gamma]P", ",", "g\[Rho]NN", ",",
               "\[Kappa]\[Rho]", ",", "Regge\[Rho]", ",", "Regge\[Rho]Star", ",",
               "g\[Omega]\[Gamma]P", ",", "g\[Omega]NN", ",", 
              "\[Kappa]\[Omega]", ",", "Regge\[Omega]", ",", 
              "Regge\[Omega]Star", ",", "FphotoToElectro"}], "]"}], ",", 
            "P"}], "]"}]}], ";", 
         RowBox[{
          RowBox[{"d\[Sigma]Pprodds2dt1dt2", "[", 
           RowBox[{
           "mX_", ",", "s_", ",", "s2_", ",", "t1_", ",", "t2_", ",", "P", 
            ",", "\"\<Total\>\""}], "]"}], "=", 
          RowBox[{"Re", "[", 
           RowBox[{"d\[Sigma]Pprodds2dt1dt2", "[", 
            RowBox[{
            "mX", ",", "s", ",", "s2", ",", "t1", ",", "t2", ",", "P", 
             ",", "\"\<V\>\""}], "]"}], "]"}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"P", ",", 
          RowBox[{"{", 
           
           RowBox[{"\"\<\!\(\*SuperscriptBox[\(\[Pi]\), \(0\)]\)\>\"", 
            ",", "\"\<\[Eta]\>\"", ",", "\"\<\[Eta]'\>\"", 
            ",", "\"\<ALP\>\""}], "}"}]}], "}"}]}], "]"}]}], ")"}], ";", 
    RowBox[{"Export", "[", 
     RowBox[{"fileSymbolicP", ",", 
      RowBox[{"{", 
       RowBox[{"\"\<EICSymbolicP-v1\>\"", ",", 
        RowBox[{"DownValues", "/@", "symbolicPCacheSymbols"}]}], "}"}], 
      ",", "\"\<WXF\>\""}], "]"}], ";"}], ",", "Null"}], "]"}]], "Input",
 CellChangeTimes->CompressedData["
