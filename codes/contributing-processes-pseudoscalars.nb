Cell[BoxData[
 RowBox[{"If", "[", 
  RowBox[{
   RowBox[{"TrueQ", "[", "ifRewritingP", "]"}], ",", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"d\[Sigma]Pprodds2dt1dt2VTemp", "[", 
          RowBox[{
          "s_", ",", "mp_", ",", "\[Alpha]EM_", ",", "mX_", ",", "s2_", ",", 
           "t1_", ",", "t2_", ",", "g\[Rho]\[Gamma]P_", ",", "g\[Rho]NN_", ",",
            "\[Kappa]\[Rho]_", ",", "Regge\[Rho]_", ",", "Regge\[Rho]Star_", ",",
            "g\[Omega]\[Gamma]P_", ",", "g\[Omega]NN_", ",", 
           "\[Kappa]\[Omega]_", ",", "Regge\[Omega]_", ",", 
           "Regge\[Omega]Star_", ",", "FphotoToElectro_"}], "]"}], ",", 
         "test"}], "}"}], "=", 
       RowBox[{"d\[Sigma]Xprodds2dt1dt2Temp", "[", 
        RowBox[{"d\[Sigma]Pprodds2dt1dt2ds1V", "[", 
         RowBox[{
         "s", ",", "mp", ",", "\[Alpha]EM", ",", "mX", ",", "s2", ",", "t1", ",",
           "t2", ",", "s1", ",", "g\[Rho]\[Gamma]P", ",", "g\[Rho]NN", ",", 
          "\[Kappa]\[Rho]", ",", "Regge\[Rho]", ",", "Regge\[Rho]Star", ",", 
          "g\[Omega]\[Gamma]P", ",", "g\[Omega]NN", ",", "\[Kappa]\[Omega]", ",",
           "Regge\[Omega]", ",", "Regge\[Omega]Star", ",", 
          "FphotoToElectro"}], "]"}], "]"}]}], ";"}], ")"}], ";", "Null", ";", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"!", "test"}], ",", 
        RowBox[{"Print", "[", 
         TemplateBox[{"\"V-exchange part: \"", "test"},
          "RowDefault"], "]"}]}], "]"}], ";"}], ")"}], ";", "Null", ";", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"d\[Sigma]Pprodds2dt1dt2TotalTemp", "[", 
        RowBox[{
