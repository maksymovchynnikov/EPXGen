  RowBox[{
   RowBox[{"If", "[", 
    RowBox[{"ifRecomputeCompiledRoutines", ",", 
     RowBox[{"Samples2FlatCompiled", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Hold", "@", 
          RowBox[{"Compile", "[", 
           RowBox[{
            RowBox[{"{", 
