          RowBox[{
          "$MachineEpsilon", ",", "tiny", ",", "mpval", ",", "meval"}], "}"}],
          "]"}]}], "//", "ReleaseHold"}]}]}], "]"}], ";", 
   RowBox[{"If", "[", 
    RowBox[{"ifRecomputeCompiledRoutines", ",", 
     RowBox[{"Samples2LogLowerCompiled", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Hold", "@", 
          RowBox[{"Compile", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"mX", ",", "_Real"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"s", ",", "_Real"}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"Nevents", ",", "_Integer"}], "}"}]}], "}"}], ",", 
            RowBox[{"Module", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
               "a", ",", "b", ",", "xiMax", ",", "xiMinL", ",", "logRL", ",", 
                "dL", ",", "tol", ",", "u", ",", "i"}], "}"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"a", "=", 
                RowBox[{"s2minXprod", "[", 
                 RowBox[{"mpval", ",", "mX", ",", "meval", ",", "s"}], 
                 "]"}]}], ";", 
               RowBox[{"b", "=", 
                RowBox[{"s2maxXprod", "[", 
                 RowBox[{"mpval", ",", "mX", ",", "meval", ",", "s"}], 
                 "]"}]}], ";", 
               RowBox[{"xiMax", "=", 
                RowBox[{"b", "-", "a"}]}], ";", 
               RowBox[{"tol", "=", 
                RowBox[{"512.", "*", "$MachineEpsilon", "*", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"Abs", "[", "a", "]"}], "+", 
                   RowBox[{"Abs", "[", "b", "]"}], "+", "1."}], ")"}]}]}], ";", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"xiMax", "<=", "tol"}], ",", 
                 RowBox[{"Return", "[", 
                  RowBox[{"Table", "[", 
                   RowBox[{"a", ",", 
                    RowBox[{"{", "Nevents", "}"}]}], "]"}], "]"}]}], "]"}], ";", 
               RowBox[{"xiMinL", "=", 
                RowBox[{"Max", "[", 
                 RowBox[{
                  RowBox[{"64.", "*", "$MachineEpsilon", "*", "xiMax"}], ",", 
                  RowBox[{"clamp", "*", "xiMax"}]}], "]"}]}], ";", 
               RowBox[{"logRL", "=", 
                RowBox[{"Log", "[", 
                 RowBox[{"xiMax", "/", "xiMinL"}], "]"}]}], ";", 
               RowBox[{"dL", "=", 
                RowBox[{"Max", "[", 
                 RowBox[{
                  RowBox[{"64.", "*", "$MachineEpsilon"}], ",", 
                  RowBox[{"tiny", "/", 
                   RowBox[{"Max", "[", 
                    RowBox[{"logRL", ",", "tiny"}], "]"}]}]}], "]"}]}], ";", 
               RowBox[{"Table", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"u", "=", 
                   RowBox[{"dL", "+", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"1.", "-", 
                    RowBox[{"2.", "*", "dL"}]}], ")"}], "*", 
                    RowBox[{"RandomReal", "[", "]"}]}]}]}], ";", 
                  RowBox[{"a", "+", 
                   RowBox[{"xiMinL", "*", 
                    RowBox[{"Exp", "[", 
                    RowBox[{"u", "*", "logRL"}], "]"}]}]}]}], ",", 
                 RowBox[{"{", 
                  RowBox[{"i", ",", "1", ",", "Nevents"}], "}"}]}], "]"}]}]}],
