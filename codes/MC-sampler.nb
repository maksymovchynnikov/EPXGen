              RowBox[{"{", 
               RowBox[{"mX", ",", "_Real"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"s", ",", "_Real"}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"Nevents", ",", "_Integer"}], "}"}]}], "}"}], ",", 
            RowBox[{"Module", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
               "a", ",", "b", ",", "w", ",", "tol", ",", "dlt", ",", "i"}], 
               "}"}], ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"a", "=", 
                RowBox[{"s2minXprod", "[", 
                 RowBox[{"mpval", ",", "mX", ",", "meval", ",", "s"}], 
                 "]"}]}], ";", 
               RowBox[{"b", "=", 
                RowBox[{"s2maxXprod", "[", 
                 RowBox[{"mpval", ",", "mX", ",", "meval", ",", "s"}], 
                 "]"}]}], ";", 
               RowBox[{"w", "=", 
                RowBox[{"b", "-", "a"}]}], ";", 
               RowBox[{"tol", "=", 
                RowBox[{"512.", "*", "$MachineEpsilon", "*", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"Abs", "[", "a", "]"}], "+", 
                   RowBox[{"Abs", "[", "b", "]"}], "+", "1."}], ")"}]}]}], ";", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"w", "<=", "tol"}], ",", 
                 RowBox[{"Return", "[", 
                  RowBox[{"Table", "[", 
                   RowBox[{"a", ",", 
                    RowBox[{"{", "Nevents", "}"}]}], "]"}], "]"}]}], "]"}], ";", 
               RowBox[{"dlt", "=", 
                RowBox[{"Max", "[", 
                 RowBox[{
                  RowBox[{"64.", "*", "$MachineEpsilon"}], ",", 
                  RowBox[{"tiny", "/", 
                   RowBox[{"Max", "[", 
                    RowBox[{
                    RowBox[{"Abs", "[", "w", "]"}], ",", "tiny"}], "]"}]}]}], 
                 "]"}]}], ";", 
               RowBox[{"Table", "[", 
                RowBox[{
                 RowBox[{"a", "+", 
                  RowBox[{"w", "*", 
                   RowBox[{"(", 
                    RowBox[{"dlt", "+", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"1.", "-", 
                    RowBox[{"2.", "*", "dlt"}]}], ")"}], "*", 
                    RowBox[{"RandomReal", "[", "]"}]}]}], ")"}]}]}], ",", 
                 RowBox[{"{", 
                  RowBox[{"i", ",", "1", ",", "Nevents"}], "}"}]}], "]"}]}]}],
              "]"}], ",", 
            RowBox[{"CompilationTarget", "->", "\"\<C\>\""}], ",", 
            RowBox[{"RuntimeOptions", "->", "\"\<Speed\>\""}], ",", 
