   RowBox[{
    RowBox[{"u", "*", "u"}], "+", 
    RowBox[{"v", "*", "v"}], "+", 
    RowBox[{"w", "*", "w"}], "-", 
    RowBox[{"2.", "*", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"u", "*", "v"}], "+", 
       RowBox[{"u", "*", "w"}], "+", 
       RowBox[{"v", "*", "w"}]}], ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalDelta]s1Xprod", "[", 
