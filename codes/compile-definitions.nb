             RowBox[{
              RowBox[{"FileExistsQ", "[", "f", "]"}], ",", 
              RowBox[{"DeleteFile", "[", "f", "]"}]}], "]"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"f", ",", "files"}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"compFuncsExists", "=", "False"}], ";"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"On", " ", "Windows"}], ",", " ", 
    RowBox[{
    "switching", " ", "to", " ", "a", " ", "faster", " ", "compiler", " ", 
     "if", " ", "available"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"$OperatingSystem", "===", "\"\<Windows\>\""}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Needs", "[", "\"\<CCompilerDriver`\>\"", "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Needs", "[", "\"\<CCompilerDriver`GenericCCompiler`\>\"", "]"}],
      ";", "\[IndentingNewLine]", 
     RowBox[{"msysRoot", "=", "\"\<C:\\\\msys64\\\\ucrt64\>\""}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"msysBin", "=", 
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{"msysRoot", ",", "\"\<bin\>\""}], "}"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"gccExe", "=", 
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{"msysBin", ",", "\"\<gcc.exe\>\""}], "}"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"FileExistsQ", "[", "gccExe", "]"}], ",", 
       RowBox[{
        RowBox[{"SetEnvironment", "[", 
         RowBox[{"\"\<PATH\>\"", "->", 
          RowBox[{"msysBin", "<>", "\"\<;\>\"", "<>", 
           RowBox[{"Replace", "[", 
            RowBox[{
             RowBox[{"Environment", "[", "\"\<PATH\>\"", "]"}], ",", 
             RowBox[{
              RowBox[{"Except", "[", "_String", "]"}], "->", "\"\<\>\""}]}], 
            "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"gcc", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\"\<Name\>\"", "->", "\"\<MSYS2 UCRT64 GCC\>\""}], ",", 
           
           RowBox[{"\"\<Compiler\>\"", "->", 
            "CCompilerDriver`GenericCCompiler`GenericCCompiler"}], ",", 
           RowBox[{"\"\<CompilerInstallation\>\"", "->", "msysRoot"}], ",", 
           RowBox[{"\"\<CompilerName\>\"", "->", "\"\<gcc.exe\>\""}], ",", 
           RowBox[{"\"\<CompileOptions\>\"", "->", "\"\<-O2\>\""}]}], "}"}]}],
         ";", "\[IndentingNewLine]", 
        RowBox[{"CCompilerDriver`$CCompiler", "=", "gcc"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", 
            RowBox[{"Kernels", "[", "]"}], "]"}], ">", "0"}], ",", 
          RowBox[{"With", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"path", "=", 
               RowBox[{"Environment", "[", "\"\<PATH\>\"", "]"}]}], ",", 
              RowBox[{"compiler", "=", "gcc"}]}], "}"}], ",", 
            RowBox[{"ParallelEvaluate", "[", 
             RowBox[{
              RowBox[{"Needs", "[", "\"\<CCompilerDriver`\>\"", "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{
              "Needs", "[", "\"\<CCompilerDriver`GenericCCompiler`\>\"", 
               "]"}], ";", "\[IndentingNewLine]", 
              RowBox[{"SetEnvironment", "[", 
               RowBox[{"\"\<PATH\>\"", "->", "path"}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"CCompilerDriver`$CCompiler", "=", "compiler"}], ";"}], 
