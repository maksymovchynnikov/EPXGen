Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"lang", "=", "\"\<C\>\""}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"checkIfCompiled", "[", "compiledFunc_CompiledFunction", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "compiledPrintOutput", ",", "hasMainEvaluate", ",", 
        "mainEvaluateParts"}], "}"}], ",", 
      RowBox[{
       RowBox[{"compiledPrintOutput", "=", 
        RowBox[{"ToString", "[", 
         RowBox[{
          RowBox[{
          "CompiledFunctionTools`CompilePrint", "[", "compiledFunc", "]"}], ",",
           "InputForm"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"hasMainEvaluate", "=", 
        RowBox[{"StringContainsQ", "[", 
         RowBox[{"compiledPrintOutput", ",", "\"\<MainEvaluate\>\""}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"mainEvaluateParts", "=", 
        RowBox[{"If", "[", 
         RowBox[{"hasMainEvaluate", ",", 
          RowBox[{"StringCases", "[", 
           RowBox[{"compiledPrintOutput", ",", 
            RowBox[{"\"\<MainEvaluate\>\"", "~~", "\"\<[\>\"", "~~", 
             RowBox[{"Shortest", "[", "___", "]"}], "~~", "\"\<]\>\""}]}], 
           "]"}], ",", 
          RowBox[{"{", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"!", "hasMainEvaluate"}], ",", "mainEvaluateParts"}], 
        "}"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SetAttributes", "[", 
   RowBox[{"ruleDown", ",", "HoldAll"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ruleDown", "[", "list_", "]"}], ":=", 
  RowBox[{"Flatten", "[", 
   RowBox[{"DownValues", "/@", 
    RowBox[{"(", 
     RowBox[{"Unevaluated", "@", "list"}], ")"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SetAttributes", "[", 
   RowBox[{"ruleOwn", ",", "HoldAll"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ruleOwn", "[", "list_", "]"}], ":=", 
   RowBox[{"Flatten", "[", 
    RowBox[{"OwnValues", "/@", 
     RowBox[{"(", 
      RowBox[{"Unevaluated", "@", "list"}], ")"}]}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dirCompFuncsProject", "=", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{"dirAuxiliary", ",", "\"\<Comp-funcs\>\""}], "}"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ifUseLocalCompiledFunctionCache", "=", 
   RowBox[{"$OperatingSystem", "==", "\"\<MacOSX\>\""}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dirCompFuncs", "=", 
   RowBox[{"If", "[", 
    RowBox[{"ifUseLocalCompiledFunctionCache", ",", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{
       "$HomeDirectory", ",", "\"\<.alp-eic-cf\>\"", ",", "$SystemID"}], 
       "}"}], "]"}], ",", "dirCompFuncsProject"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fileManifest", ",", "fileCompFuncs", ",", "fileSupport"}], "}"}],
    "=", 
   RowBox[{"{", 
    RowBox[{"\"\<CompiledManifest.mx\>\"", ",", "\"\<CompiledFunctions.mx\>\"",
      ",", "\"\<CompiledSupport.mx\>\""}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"compFuncsExists", "=", 
   RowBox[{"And", "@@", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"FileExistsQ", "[", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{"dirCompFuncs", ",", "#"}], "}"}], "]"}], "]"}], "&"}], "/@", 
      RowBox[{"{", 
       RowBox[{"fileManifest", ",", "fileCompFuncs", ",", "fileSupport"}], 
       "}"}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"If", "[", 
  RowBox[{"compFuncsExists", ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"compFuncsExists", "=", 
     RowBox[{"Quiet", "@", 
      RowBox[{"Check", "[", 
       RowBox[{
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"manifest", "=", 
            RowBox[{"Import", "[", 
             RowBox[{
              RowBox[{"FileNameJoin", "[", 
               RowBox[{"{", 
                RowBox[{"dirCompFuncs", ",", "fileManifest"}], "}"}], "]"}], 
              ",", "\"\<MX\>\""}], "]"}]}], "}"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"Lookup", "[", 
             RowBox[{"manifest", ",", "\"\<SystemID\>\"", ",", "\"\<\>\""}], 
             "]"}], "==", "$SystemID"}], "&&", 
           RowBox[{
            RowBox[{"Lookup", "[", 
             RowBox[{"manifest", ",", "\"\<SystemWordLength\>\"", ",", "0"}], 
             "]"}], "==", "$SystemWordLength"}], "&&", 
           RowBox[{"If", "[", 
            RowBox[{"ifUseLocalCompiledFunctionCache", ",", 
             RowBox[{
              RowBox[{
               RowBox[{"Lookup", "[", 
                RowBox[{
                "manifest", ",", "\"\<CacheKind\>\"", ",", "\"\<\>\""}], 
                "]"}], "==", "\"\<LocalCompiledFunctionCache\>\""}], "&&", 
              RowBox[{
               RowBox[{"Lookup", "[", 
                RowBox[{
                "manifest", ",", "\"\<CacheSchemaVersion\>\"", ",", "0"}], 
                "]"}], "==", "10"}], "&&", 
              RowBox[{"AllTrue", "[", 
               RowBox[{
                RowBox[{"Lookup", "[", 
                 RowBox[{"manifest", ",", "\"\<CachedNativeFiles\>\"", ",", 
                  RowBox[{"Lookup", "[", 
                   RowBox[{"manifest", ",", "\"\<ReferencedNativeFiles\>\"", ",", 
                    RowBox[{"{", "}"}]}], "]"}]}], "]"}], ",", 
                "FileExistsQ"}], "]"}]}], ",", "True"}], "]"}]}]}], "]"}], ",",
         "False"}], "]"}]}]}], ";"}]}], "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"ifRecomputeFunctionsTables", "||", 
     RowBox[{"!", "compFuncsExists"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ifRecomputeCompiledRoutines", "=", "True"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"<<", "FeynCalc`"}], ";", "\[IndentingNewLine]", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"files", "=", 
         RowBox[{"FileNames", "[", 
          RowBox[{"\"\<*\>\"", ",", "dirCompFuncs"}], "]"}]}], "}"}], ",", 
       RowBox[{
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"DirectoryQ", "[", "f", "]"}], ",", 
            RowBox[{"DeleteDirectory", "[", 
             RowBox[{"f", ",", 
              RowBox[{"DeleteContents", "\[Rule]", "True"}]}], "]"}], ",", 
