              RowBox[{"-", "1"}]}], "}"}]}], "]"}], "]"}], ",", 
         RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}], "[", "ma", 
       "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"c\[Tau]LLP", "[", 
      RowBox[{"ma_", ",", "fa_"}], "]"}], "=", 
