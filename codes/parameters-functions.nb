Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Low", "-", 
     RowBox[{"mass", " ", "mixing", " ", "coefficients"}]}], ",", " ", 
    "rough"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ruleshALPP", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Delta]", "->", 
        FractionBox[
         RowBox[{
          RowBox[{"MASS", "[", "\"\<d\>\"", "]"}], "-", 
          RowBox[{"MASS", "[", "\"\<u\>\"", "]"}]}], 
         RowBox[{
          RowBox[{"MASS", "[", "\"\<d\>\"", "]"}], "+", 
          RowBox[{"MASS", "[", "\"\<u\>\"", "]"}]}]]}], ",", 
       RowBox[{"m\[Pi]", "->", 
        RowBox[{
        "MASS", "[", "\"\<\!\(\*SuperscriptBox[\(\[Pi]\), \(0\)]\)\>\"", 
         "]"}]}], ",", 
       RowBox[{"m0", "->", 
        SqrtBox[
         RowBox[{
          RowBox[{"3", 
           SuperscriptBox[
            RowBox[{"MASS", "[", "\"\<\[Eta]\>\"", "]"}], "2"]}], "-", 
          RowBox[{"3", 
           SuperscriptBox[
            RowBox[{
            "MASS", "[", "\"\<\!\(\*SuperscriptBox[\(\[Pi]\), \(0\)]\)\>\"", 
             "]"}], "2"]}]}]]}], ",", 
       RowBox[{"m\[Eta]pr", "->", 
        RowBox[{"MASS", "[", "\"\<\[Eta]'\>\"", "]"}]}], ",", 
       RowBox[{"m\[Eta]", "->", 
        RowBox[{"MASS", "[", "\"\<\[Eta]\>\"", "]"}]}], ",", 
       RowBox[{"f\[Pi]", "->", "f\[Pi]Val"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
