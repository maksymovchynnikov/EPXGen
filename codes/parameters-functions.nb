Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"gaNN", ",", "gPNN", ",", "gPV\[Gamma]", ",", "gaV\[Gamma]"}], 
    "}"}], "//", "Clear"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"couplingsRaw", "[", "ma_", "]"}], "=", 
   RowBox[{"Import", "[", 
    RowBox[{
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"dir", "[", "\"\<import\>\"", "]"}], 
        ",", "\"\<ALP-gluon-P-couplings.mx\>\""}], "}"}], "]"}], 
     ",", "\"\<MX\>\""}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Range", "[", 
    RowBox[{"Length", "[", 
     RowBox[{"couplingsRaw", "[", "ma", "]"}], "]"}], "]"}], ",", 
   RowBox[{
    RowBox[{"couplingsRaw", "[", "ma", "]"}], "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", "1"}], "]"}], "]"}]}], "}"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"MapThread", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"#", "=", "#2"}], ")"}], "&"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"couplingsRaw", "[", "ma", "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
      RowBox[{
       RowBox[{"couplingsRaw", "[", "ma", "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "4"}], "]"}], "]"}]}], "}"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"ga\[Rho]\[Gamma]", "[", 
       RowBox[{"ma_", ",", "fa_"}], "]"}], ",", 
      RowBox[{"ga\[Omega]\[Gamma]", "[", 
       RowBox[{"ma_", ",", "fa_"}], "]"}], ",", 
      RowBox[{"ga\[Phi]\[Gamma]", "[", 
       RowBox[{"ma_", ",", "fa_"}], "]"}]}], "}"}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"gaV\[Gamma]", "[", 
       RowBox[{"ma", ",", "fa", ",", "#"}], "]"}], "&"}], "/@", 
     RowBox[{"{", 
      RowBox[{"\"\<\!\(\*SuperscriptBox[\(\[Rho]\), \(0\)]\)\>\"", 
       ",", "\"\<\[Omega]\>\"", ",", "\"\<\[Phi]\>\""}], "}"}]}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Phenomenological", " ", "form", " ", "factor", " ", "from", " ", 
    "2112.09814"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"FormFactorSquaredBrem", "[", "ma_", "]"}], "=", 
   RowBox[{"Abs", "[", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Gamma]", "=", "0.515"}], ",", 
        RowBox[{"\[Delta]", "=", "0.397"}], ",", 
        RowBox[{"\[CapitalGamma]a1", "=", "0.4"}], ",", 
        RowBox[{"ma1", "=", "1.23"}], ",", 
        RowBox[{"\[Alpha]", "=", "0.95"}]}], "}"}], ",", 
      RowBox[{
       RowBox[{
        SuperscriptBox[
         RowBox[{"Abs", "[", 
          RowBox[{
           FractionBox["1", 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"1", "-", 
               RowBox[{"\[Gamma]", "*", 
                RowBox[{"Exp", "[", 
                 RowBox[{"I", "*", "\[Delta]"}], "]"}], "*", 
                SuperscriptBox["ma", "2"]}]}], ")"}], "2"]], "*", 
           RowBox[{"(", 
            RowBox[{"1", "-", "\[Alpha]", "+", 
             RowBox[{"\[Alpha]", "*", 
              FractionBox[
               RowBox[{
                SuperscriptBox["ma1", "2"], 
                RowBox[{"(", 
                 RowBox[{
                  SuperscriptBox["ma1", "2"], "-", 
                  SuperscriptBox["ma", "2"], "+", 
                  RowBox[{"I", "*", "ma1", "*", "\[CapitalGamma]a1"}]}], 
                 ")"}]}], 
               RowBox[{
                SuperscriptBox[
                 RowBox[{"(", 
                  RowBox[{
                   SuperscriptBox["ma1", "2"], "-", 
                   SuperscriptBox["ma", "2"]}], ")"}], "2"], "+", 
                RowBox[{
                 SuperscriptBox["ma1", "2"], "*", 
                 SuperscriptBox["\[CapitalGamma]a1", "2"]}]}]]}]}], ")"}]}], 
          "]"}], "2"], "//", "ComplexExpand"}], "//", "Simplify"}]}], "]"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gaNN", "[", 
    RowBox[{"ma_", ",", "fa_"}], "]"}], "=", 
   RowBox[{
    RowBox[{"gaNN", "[", 
     RowBox[{"ma", ",", "fa"}], "]"}], "*", 
    SqrtBox[
     RowBox[{"FormFactorSquaredBrem", "[", "ma", "]"}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mactrit", "=", "1.3"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"gaNN", "[", 
     RowBox[{"ma_", ",", "fa_"}], "]"}], "=", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"ma", "<=", "mactrit"}], ",", 
      RowBox[{"Evaluate", "[", 
       RowBox[{"gaNN", "[", 
        RowBox[{"ma", ",", "fa"}], "]"}], "]"}], ",", 
      RowBox[{"Evaluate", "[", 
       RowBox[{
        RowBox[{"gaNN", "[", 
         RowBox[{"ma", ",", "fa"}], "]"}], "*", 
        RowBox[{"(", 
         FractionBox["ma", "mactrit"], ")"}]}], "]"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Couplings", " ", "of", " ", "vector", " ", "mesons", " ", "and", " ", 
    "nucleons"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
