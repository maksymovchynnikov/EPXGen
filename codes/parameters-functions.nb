Cell[CellGroupData[{

Cell["EIC: energies, selection criteria", "Subsection",
 CellChangeTimes->{{3.9712427907862473`*^9, 
  3.971242795777767*^9}},ExpressionUUID->"0e9d7dd9-8f13-9a47-992a-\
f41cdec2b9db"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Invariant", " ", "mass"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"predefinedSetups", "=", 
     RowBox[{"{", 
      RowBox[{"\"\<Baseline\>\"", ",", "\"\<Baseline-FBD-upgrade\>\"", 
       ",", "\"\<Optimal\>\"", ",", "\"\<High-energy\>\""}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ifSetArgs", "[", "SetupName_", "]"}], ":=", 
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", "arg", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"MemberQ", "[", 
          RowBox[{"predefinedSetups", ",", "SetupName"}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"SetupName", "==", "\"\<Baseline\>\""}], ",", 
            RowBox[{"arg", "=", 
             RowBox[{"{", 
              RowBox[{"True", ",", "False", ",", "False", ",", "False"}], 
              "}"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"SetupName", "==", "\"\<Baseline-FBD-upgrade\>\""}], ",", 
            RowBox[{"arg", "=", 
             RowBox[{"{", 
              RowBox[{"False", ",", "True", ",", "False", ",", "False"}], 
              "}"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"SetupName", "==", "\"\<Optimal\>\""}], ",", 
            RowBox[{"arg", "=", 
             RowBox[{"{", 
              RowBox[{"False", ",", "False", ",", "True", ",", "False"}], 
