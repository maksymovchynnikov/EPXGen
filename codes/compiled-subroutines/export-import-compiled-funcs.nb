        RowBox[{"ctx", "<>", "\"\<*\>\""}], "]"}]}], "}"}], ",", 
     RowBox[{"Select", "[", 
      RowBox[{"names", ",", 
       RowBox[{
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"h", "=", 
            RowBox[{"ToExpression", "[", 
             RowBox[{"#", ",", "StandardForm", ",", "HoldComplete"}], "]"}]}],
            "}"}], ",", 
          RowBox[{"MatchQ", "[", 
           RowBox[{
            RowBox[{"OwnValues", "@@", "h"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"HoldPattern", "[", "_", "]"}], ":>", 
              "_CompiledFunction"}], "}"}]}], "]"}]}], "]"}], "&"}]}], 
      "]"}]}], "]"}]}], ";", 
  RowBox[{"list", "=", 
   RowBox[{"If", "[", 
    RowBox[{"ifRecomputeCompiledRoutines", ",", "eicCompiledNames", ",", 
     RowBox[{"{", "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"list1", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"#", ",", 
       RowBox[{"checkIfCompiled", "[", 
        RowBox[{"ToExpression", "[", "#", "]"}], "]"}]}], "}"}], "&"}], "/@", 
    "list"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"listBroken", "=", 
   RowBox[{"Select", "[", 
    RowBox[{"list1", ",", 
     RowBox[{
      RowBox[{"!", 
       RowBox[{"#", "[", 
        RowBox[{"[", 
         RowBox[{"2", ",", "1"}], "]"}], "]"}]}], "&"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"listBroken", "=!=", 
     RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Export", "[", 
        RowBox[{
         RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"NotebookDirectory", "[", "]"}], 
            ",", "\"\<print-before-exporting\>\"", ",", 
            RowBox[{"\"\<print-\>\"", "<>", 
             RowBox[{"l", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "<>", "\"\<.txt\>\""}]}], "}"}],
           "]"}], ",", 
         RowBox[{"CompilePrint", "[", 
          RowBox[{"ToExpression", "[", 
           RowBox[{"l", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}], 
         ",", "\"\<Table\>\""}], "]"}], "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"l", ",", "listBroken"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"infoDialog", "[", 
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<There are some functions that are not compilable: \>\"", 
