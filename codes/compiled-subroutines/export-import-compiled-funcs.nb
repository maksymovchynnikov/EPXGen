         RowBox[{"listBroken", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "1"}], "]"}], "]"}], 
         ",", "\"\<. Check `print-before-exporting` directory for \
CompilePrint...\>\""}], "}"}], "]"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Abort", "[", "]"}]}], "\[IndentingNewLine]", ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"files", "=", 
         RowBox[{"FileNames", "[", 
          RowBox[{"\"\<*\>\"", ",", 
           RowBox[{"FileNameJoin", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"NotebookDirectory", "[", "]"}], 
              ",", "\"\<print-before-exporting\>\""}], "}"}], "]"}]}], 
          "]"}]}], "}"}], ",", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "files", "]"}], ">", "0"}], ",", 
         RowBox[{"DeleteFile", "[", "files", "]"}]}], "]"}]}], "]"}], ";"}]}],
    "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"If", "[", 
  RowBox[{"ifRecomputeCompiledRoutines", ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"exportReport", "=", 
     RowBox[{"Get", "[", 
