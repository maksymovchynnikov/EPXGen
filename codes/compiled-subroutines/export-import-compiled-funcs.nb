Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"compiledSymbolsOwn", "[", 
    RowBox[{"ctx_", ":", "\"\<Global`\>\""}], "]"}], ":=", 
   RowBox[{"Module", "[", 
