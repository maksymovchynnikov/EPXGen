     RowBox[{"Simplify", "[", 
      RowBox[{"pprod", "+", 
       RowBox[{
        RowBox[{"\[Gamma]Factor", "[", 
         RowBox[{"Em", ",", "mm"}], "]"}], "*", "vmotherlab", "*", "Ed"}], "+", 
       RowBox[{
        RowBox[{"\[CapitalGamma]factor", "[", 
         RowBox[{"Em", ",", "mm"}], "]"}], "*", "vmotherlab", 
        RowBox[{"(", 
         RowBox[{"vmotherlab", ".", "pprod"}], ")"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"EproductLabCart", "[", 
      RowBox[{
      "pxm_", ",", "pym_", ",", "pzm_", ",", "Em_", ",", "mm_", ",", "pxd_", ",",
        "pyd_", ",", "pzd_", ",", "Ed_"}], "]"}], "=", 
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{"\[Gamma]Factor", "[", 
        RowBox[{"Em", ",", "mm"}], "]"}], 
       RowBox[{"(", 
        RowBox[{"Ed", "+", 
         RowBox[{"vmotherlab", ".", "pprod"}]}], ")"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"pproductLab1Cart", "[", 
        RowBox[{
        "pxm_", ",", "pym_", ",", "pzm_", ",", "Em_", ",", "mm_", ",", "pxd_",
          ",", "pyd_", ",", "pzd_", ",", "Ed_"}], "]"}], ",", 
       RowBox[{"pproductLab2Cart", "[", 
        RowBox[{
        "pxm_", ",", "pym_", ",", "pzm_", ",", "Em_", ",", "mm_", ",", "pxd_",
          ",", "pyd_", ",", "pzd_", ",", "Ed_"}], "]"}], ",", 
