     RowBox[{
      RowBox[{
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{"pproductLabVecCart", "[", 
          RowBox[{
          "pxm", ",", "pym", ",", "pzm", ",", "Em", ",", "mm", ",", "pxd", ",",
            "pyd", ",", "pzd", ",", "Ed"}], "]"}], "[", 
         RowBox[{"[", "#", "]"}], "]"}], "]"}], "&"}], "/@", 
      RowBox[{"{", 
       RowBox[{"1", ",", "2", ",", "3"}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
   "Print", "[", "\"\<Check that \!\(\*SubscriptBox[SuperscriptBox[\(E\), \(2\
\)], \(boosted\)]\) - \!\(\*SubscriptBox[SuperscriptBox[OverscriptBox[\(p\), \
\(_\)], \(2\)], \(boosted\)]\) = \!\(\*SuperscriptBox[\(m\), \(2\)]\):\>\"", 
    "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"testExpr", "[", 
      RowBox[{
      "pxm_", ",", "pym_", ",", "pzm_", ",", "Em_", ",", "mm_", ",", "pxd_", ",",
        "pyd_", ",", "pzd_", ",", "Ed_"}], "]"}], "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{
              SuperscriptBox[
               RowBox[{"EproductLabCart", "[", 
                RowBox[{
                "pxm", ",", "pym", ",", "pzm", ",", "Em", ",", "mm", ",", 
                 "pxd", ",", "pyd", ",", "pzd", ",", "Ed"}], "]"}], "2"], "-", 
              SuperscriptBox[
               RowBox[{"pproductLab1Cart", "[", 
                RowBox[{
                "pxm", ",", "pym", ",", "pzm", ",", "Em", ",", "mm", ",", 
                 "pxd", ",", "pyd", ",", "pzd", ",", "Ed"}], "]"}], "2"], "-", 
