       RowBox[{
       "m", ",", "m2", ",", "m1", ",", "pdg1", ",", "pdg2", ",", 
        "\[Theta]Rand", ",", "\[Phi]Rand"}], "]"}]}]}], "\[IndentingNewLine]",
     "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"If", "[", 
