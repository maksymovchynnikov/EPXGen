             "\[IndentingNewLine]", 
             RowBox[{"sinthetas", "=", 
              SqrtBox[
               RowBox[{"1", "-", 
                SuperscriptBox["costhetas", "2"]}]]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"phis", "=", 
              RowBox[{"RandomReal", "[", 
