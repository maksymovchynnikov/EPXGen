Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"M2tod\[Sigma]Xprod", "[", 
     RowBox[{"s_", ",", "mp_"}], "]"}], "=", 
    RowBox[{"Refine", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"M2tod\[Sigma]", "[", 
          RowBox[{"s", ",", "0", ",", "mp"}], "]"}], "//", "Simplify"}], 
        ")"}], "/.", 
       RowBox[{"{", 
        RowBox[{"me", "->", "0"}], "}"}]}], ",", 
      RowBox[{"s", ">", 
       SuperscriptBox["mp", "2"], ">", "0"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"finite", ",", 
    RowBox[{"non", "-", 
     RowBox[{"singular", " ", "s1"}], "-", 
     RowBox[{"kernel", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"pulled", " ", 
         RowBox[{"1", "/", 
          RowBox[{"Sqrt", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"s1", "-", "s1min"}], ")"}], 
            RowBox[{"(", 
             RowBox[{"s1max", "-", "s1"}], ")"}]}], "]"}]}], " ", "out", " ", 
         "of", " ", "the", " ", "integrand"}], ")"}], ".", " ", "To"}], " ", 
      "be", " ", "used", " ", "in", " ", "the", " ", "MC", " ", 
      "sampler"}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"PhaseSpacePreFactorXprodReducedExact", "[", 
    RowBox[{"s_", ",", "mp_", ",", "s2_", ",", "t1_", ",", "me_"}], "]"}], 
   "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"PhaseSpacePreFactorReduced", "[", 
