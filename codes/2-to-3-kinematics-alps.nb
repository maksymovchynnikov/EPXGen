      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"d0", ",", "d1", ",", "d2"}], "}"}], "=", 
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"func", "=", 
            RowBox[{
             RowBox[{"(", 
              FractionBox["1", 
               RowBox[{"ExactPreFactors1", "[", 
                RowBox[{
                "me", ",", "mp", ",", "mX", ",", "s", ",", "s2", ",", "t1", 
                 ",", "t2", ",", "s1"}], "]"}]], ")"}], "*", "expr"}]}], 
           "}"}], ",", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"func", ",", 
             RowBox[{"D", "[", 
              RowBox[{"func", ",", "s1"}], "]"}], ",", 
             RowBox[{
              FractionBox["1", "2"], 
              RowBox[{"D", "[", 
               RowBox[{"func", ",", "s1", ",", "s1"}], "]"}]}]}], "}"}], "/.", 
           RowBox[{"{", 
            RowBox[{"s1", "->", "0"}], "}"}]}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"test", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"ExactPreFactors1", "[", 
              RowBox[{
              "me", ",", "mp", ",", "mX", ",", "s", ",", "s2", ",", "t1", ",",
                "t2", ",", "s1"}], "]"}], 
             RowBox[{"(", 
              RowBox[{"d0", "+", 
               RowBox[{"d1", "*", "s1"}], "+", 
               RowBox[{"d2", "*", 
                SuperscriptBox["s1", "2"]}]}], ")"}]}], "-", "expr"}], "//", 
           "Simplify"}], ")"}], "===", "0"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"d0", "*", 
                 RowBox[{"Integrals10", "[", 
                  RowBox[{"s1lower", ",", "s1upper"}], "]"}]}], "+", 
                RowBox[{"d1", "*", 
                 RowBox[{"Integrals11", "[", 
                  RowBox[{"s1lower", ",", "s1upper"}], "]"}]}], "+", 
                RowBox[{"d2", "*", 
                 RowBox[{"Integrals12", "[", 
                  RowBox[{"s1lower", ",", "s1upper"}], "]"}]}]}], ")"}], "//",
               "Simplify"}], ")"}], "/.", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"s1lower", "\[Rule]", 
               RowBox[{
                RowBox[{"s1pmXprod", "[", 
                 RowBox[{
                 "mp", ",", "mX", ",", "s", ",", "s2", ",", "t1", ",", "t2"}],
                  "]"}], "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], ",", 
              RowBox[{"s1upper", "\[Rule]", 
               RowBox[{
                RowBox[{"s1pmXprod", "[", 
                 RowBox[{
                 "mp", ",", "mX", ",", "s", ",", "s2", ",", "t1", ",", "t2"}],
                  "]"}], "[", 
                RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}]}], "//", 
           "Together"}], "//", "Simplify"}], ",", "test"}], "}"}]}]}], 
     "\[IndentingNewLine]", "]"}]}]}]}]], "Input",
