Cell[CellGroupData[{

Cell["Vertices and properties of tensor mesons", "Subsection",
 CellChangeTimes->{{3.9792939746127796`*^9, 3.9792939892499065`*^9}, {
  3.979313095066742*^9, 
  3.9793131339542103`*^9}},ExpressionUUID->"ff8d7e29-69e9-eb40-bd59-\
a9216ee0e7ea"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"If", "[", 
  RowBox[{
   RowBox[{"TrueQ", "[", "ifRewritingV", "]"}], ",", 
   RowBox[{"(*", 
    RowBox[{"Polarization", " ", "sum", " ", "rule"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Tens", "[", 
      RowBox[{"a_", ",", "b_", ",", "p_", ",", "m_"}], "]"}], "=", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"MT", "[", 
        RowBox[{"a", ",", "b"}], "]"}]}], "+", 
      FractionBox[
       RowBox[{
        RowBox[{"FV", "[", 
         RowBox[{"p", ",", "a"}], "]"}], "*", 
        RowBox[{"FV", "[", 
         RowBox[{"p", ",", "b"}], "]"}]}], 
       SuperscriptBox["m", "2"]]}]}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"PolarizationSum", "[", 
      RowBox[{
      "\[Alpha]_", ",", "\[Beta]_", ",", "\[Mu]_", ",", "\[Nu]_", ",", "p_", ",",
        "mf2_"}], "]"}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         FractionBox["1", "2"], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"Tens", "[", 
             RowBox[{"\[Mu]", ",", "\[Alpha]", ",", "p", ",", "mf2"}], "]"}], 
            "*", 
            RowBox[{"Tens", "[", 
             RowBox[{"\[Nu]", ",", "\[Beta]", ",", "p", ",", "mf2"}], "]"}]}],
            "+", 
           RowBox[{
            RowBox[{"Tens", "[", 
             RowBox[{"\[Mu]", ",", "\[Beta]", ",", "p", ",", "mf2"}], "]"}], "*", 
            RowBox[{"Tens", "[", 
             RowBox[{"\[Nu]", ",", "\[Alpha]", ",", "p", ",", "mf2"}], 
             "]"}]}]}], ")"}]}], "-", 
        RowBox[{
         FractionBox["1", "3"], 
         RowBox[{"Tens", "[", 
          RowBox[{"\[Mu]", ",", "\[Nu]", ",", "p", ",", "mf2"}], "]"}], "*", 
         RowBox[{"Tens", "[", 
          RowBox[{"\[Alpha]", ",", "\[Beta]", ",", "p", ",", "mf2"}], 
          "]"}]}]}], "//", "Expand"}], "//", "Simplify"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
      SubscriptBox["f", "2"], "NN", " ", "vertex"}], "*)"}], 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[CapitalGamma]f2NN", "[", 
      RowBox[{"\[Lambda]_", ",", "\[Sigma]_", ",", "mp_"}], "]"}], "=", 
     RowBox[{"2", 
      FractionBox["gf2NN", "mp"], "*", 
      FractionBox["1", "2"], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"FV", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"momLab", "[", "p", "]"}], "+", 
            RowBox[{"momLab", "[", "ppr", "]"}]}], ",", "\[Lambda]"}], "]"}], 
         "*", 
         RowBox[{"GA", "[", "\[Sigma]", "]"}]}], "+", 
        RowBox[{
         RowBox[{"FV", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"momLab", "[", "p", "]"}], "+", 
            RowBox[{"momLab", "[", "ppr", "]"}]}], ",", "\[Sigma]"}], "]"}], "*", 
         RowBox[{"GA", "[", "\[Lambda]", "]"}]}]}], ")"}]}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
      SubscriptBox["f", "2"], "V\[Gamma]", " ", "vertex"}], "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"structFull", "[", 
      RowBox[{
      "\[Mu]_", ",", "\[Nu]_", ",", "\[Alpha]_", ",", "\[Beta]_", ",", "p_", ",",
        "q_", ",", "m\[Rho]_"}], "]"}], "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"ScalarProduct", "[", 
            RowBox[{"p", ",", "q"}], "]"}], "+", 
           SuperscriptBox["m\[Rho]", "2"]}], ")"}], "*", 
         RowBox[{"MT", "[", 
          RowBox[{"\[Mu]", ",", "\[Alpha]"}], "]"}], "*", 
         RowBox[{"MT", "[", 
          RowBox[{"\[Nu]", ",", "\[Beta]"}], "]"}]}], "+", 
        RowBox[{
         RowBox[{"FV", "[", 
          RowBox[{"p", ",", "\[Mu]"}], "]"}], "*", 
         RowBox[{"FV", "[", 
          RowBox[{"q", ",", "\[Nu]"}], "]"}], "*", 
         RowBox[{"MT", "[", 
          RowBox[{"\[Alpha]", ",", "\[Beta]"}], "]"}]}], "-", 
        RowBox[{
         RowBox[{"FV", "[", 
          RowBox[{"p", ",", "\[Mu]"}], "]"}], "*", 
         RowBox[{"FV", "[", 
          RowBox[{"q", ",", "\[Alpha]"}], "]"}], "*", 
         RowBox[{"MT", "[", 
          RowBox[{"\[Nu]", ",", "\[Beta]"}], "]"}]}], "-", 
        RowBox[{
         RowBox[{"FV", "[", 
          RowBox[{"p", ",", "\[Beta]"}], "]"}], "*", 
         RowBox[{"FV", "[", 
          RowBox[{"q", ",", "\[Nu]"}], "]"}], "*", 
         RowBox[{"MT", "[", 
          RowBox[{"\[Mu]", ",", "\[Alpha]"}], "]"}]}]}], ")"}], "-", 
      RowBox[{
       RowBox[{"MT", "[", 
        RowBox[{"\[Mu]", ",", "\[Nu]"}], "]"}], "*", 
       FractionBox["1", "2"], "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"ScalarProduct", "[", 
             RowBox[{"p", ",", "q"}], "]"}], "+", 
            SuperscriptBox["m\[Rho]", "2"]}], ")"}], "*", 
          RowBox[{"MT", "[", 
           RowBox[{"\[Alpha]", ",", "\[Beta]"}], "]"}]}], "-", 
         RowBox[{
          RowBox[{"FV", "[", 
           RowBox[{"p", ",", "\[Beta]"}], "]"}], "*", 
          RowBox[{"FV", "[", 
           RowBox[{"q", ",", "\[Alpha]"}], "]"}]}]}], ")"}]}]}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[CapitalGamma]f2V\[Gamma]", "[", 
      RowBox[{
      "gf2V\[Gamma]_", ",", "\[Mu]_", ",", "\[Beta]_", ",", "\[Rho]_"}], 
      "]"}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"gf2V\[Gamma]", "*", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"structFull", "[", 
            RowBox[{"\[Beta]", ",", "\[Rho]", ",", "\[Mu]", ",", "\[Kappa]", ",", 
             RowBox[{"momLab", "[", "\[Gamma]", "]"}], ",", 
             RowBox[{"momLab", "[", "X", "]"}], ",", "0"}], "]"}], "*", 
           RowBox[{"PolarizationVector", "[", 
            RowBox[{
             RowBox[{"momLab", "[", "X", "]"}], ",", "\[Kappa]"}], "]"}]}], 
          ")"}]}], "//", "ExpandScalarProduct"}], "//", "Contract"}], "//", 
      "ExpandScalarProduct"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{
    "Print", "[", "\"\<\!\(\*SubscriptBox[\(f\), \(2\)]\)V\[Gamma] vertex is \
transverse wrt \!\(\*SubscriptBox[\(p\), SuperscriptBox[\(\[Gamma]\), \(*\)]]\
\):\>\"", "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"mom\[Gamma]", "[", "\[Mu]", "]"}], "*", 
          RowBox[{"\[CapitalGamma]f2V\[Gamma]", "[", 
           RowBox[{
           "gf2V\[Gamma]", ",", "\[Mu]", ",", "\[Rho]", ",", "\[Sigma]"}], 
           "]"}]}], "//", "Contract"}], "//", "ExpandScalarProduct"}], "//", 
       "Simplify"}], ")"}], "==", "0"}], ";", "\[IndentingNewLine]", 
    RowBox[{
    "Print", "[", "\"\<\!\(\*SubscriptBox[\(f\), \(2\)]\)V\[Gamma] vertex is \
traceless wrt \!\(\*SubscriptBox[\(f\), \(2\)]\) indices:\>\"", "]"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"\[CapitalGamma]f2V\[Gamma]", "[", 
        RowBox[{
        "gf2V\[Gamma]", ",", "\[Mu]", ",", "\[Beta]", ",", "\[Beta]"}], "]"}],
        "//", "Contract"}], ")"}], "==", "0"}]}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",
 CellChangeTimes->{{3.9793125299407616`*^9, 3.979312574034237*^9}, {
   3.979312606360592*^9, 3.979312675342741*^9}, {3.979312744014866*^9, 
