     RowBox[{"(", 
      FractionBox["3.4", "2.7"], ")"}], "2"]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"funcFit", "[", "s_", "]"}], "=", 
   RowBox[{"factorFit", "*", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"s", "<=", "5.5"}], ",", "5.1", ",", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"5.5", "<", "s", "<=", "6.14"}], ",", 
        RowBox[{"5.2", "*", 
         SuperscriptBox[
          RowBox[{"(", 
           FractionBox["5.5", "s"], ")"}], "12.5"]}], ",", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"5.2", "*", 
           SuperscriptBox[
            RowBox[{"(", 
             FractionBox["5.5", "6.14"], ")"}], "12.5"]}], ")"}], 
         SuperscriptBox[
          RowBox[{"(", 
           FractionBox["6.14", "s"], ")"}], "5"]}]}], "]"}]}], "]"}]}]}], 
  ";"}]}], "Input",
