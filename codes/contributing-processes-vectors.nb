Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"!", "ifFileMsquaredVExists"}], ",", "\[IndentingNewLine]", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"ps", "=", 
         RowBox[{
          RowBox[{"momLab", "[", "p", "]"}], "+", 
          RowBox[{"momLab", "[", "e", "]"}], "-", 
          RowBox[{"momLab", "[", "epr", "]"}]}]}], ",", 
        RowBox[{"pu", "=", 
         RowBox[{
          RowBox[{"momLab", "[", "p", "]"}], "-", 
          RowBox[{"momLab", "[", "X", "]"}]}]}], ",", 
        RowBox[{"Fhat", "=", 
         RowBox[{"(*", 
          RowBox[{"FNVs", "+", "FNVu", "-", 
           RowBox[{"FNVs", "*", "FNVu"}]}], "*)"}], "0"}]}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"Fhat", "===", "0"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"gaugePieceN1", "=", "0"}], ";", "\[IndentingNewLine]", 
          RowBox[{"gaugePieceN2", "=", "0"}], ";"}], "\[IndentingNewLine]", ",",
          "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"gaugePieceN1", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"-", 
              FractionBox[
               RowBox[{"FV", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"2", "*", 
                   RowBox[{"momLab", "[", "p", "]"}]}], "+", 
                  RowBox[{"momLab", "[", "e", "]"}], "-", 
                  RowBox[{"momLab", "[", "epr", "]"}]}], ",", "\[Mu]"}], 
                "]"}], 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"ScalarProduct", "[", 
                  RowBox[{"ps", ",", "ps"}], "]"}], "-", 
                 SuperscriptBox["mp", "2"]}], ")"}]]}], "*", 
             FractionBox[
              RowBox[{"(", 
               RowBox[{"FNVs", "-", "Fhat"}], ")"}], "FNVs"], "*", 
             RowBox[{"(", 
              RowBox[{"ubarppr", ".", 
               RowBox[{"GA", "[", "\[Nu]", "]"}], ".", "up"}], ")"}], "*", 
             RowBox[{"polV", "[", "\[Nu]", "]"}]}], "//", "Contract"}]}], ";",
           "\[IndentingNewLine]", 
          RowBox[{"gaugePieceN2", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"-", 
              FractionBox[
               RowBox[{"FV", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"2", "*", "pppr"}], "-", "p\[Gamma]"}], ",", 
                 "\[Mu]"}], "]"}], 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"ScalarProduct", "[", 
                  RowBox[{"pu", ",", "pu"}], "]"}], "-", 
                 SuperscriptBox["mp", "2"]}], ")"}]]}], "*", 
             FractionBox[
              RowBox[{"(", 
               RowBox[{"FNVu", "-", "Fhat"}], ")"}], "FNVu"], "*", 
             RowBox[{"(", 
              RowBox[{"ubarppr", ".", 
               RowBox[{"GA", "[", "\[Nu]", "]"}], ".", "up"}], ")"}], "*", 
             RowBox[{"polV", "[", "\[Nu]", "]"}]}], "//", "Contract"}]}], 
          ";"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"JvecHadrN1", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"FNVs", "*", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"Sqrt", "[", 
              RowBox[{"4", " ", "Pi", "*", "\[Alpha]EM"}], "]"}], ")"}], "2"],
            "*", "gVNN", "*", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"ubarppr", ".", 
                RowBox[{"GA", "[", "\[Nu]", "]"}], ".", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"GS", "[", "ps", "]"}], "+", "mp"}], ")"}], ".", 
                RowBox[{"GA", "[", "\[Mu]", "]"}], ".", "up"}], ")"}], "*", 
              FractionBox[
               RowBox[{"polV", "[", "\[Nu]", "]"}], 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"ScalarProduct", "[", 
                  RowBox[{"ps", ",", "ps"}], "]"}], "-", 
                 SuperscriptBox["mp", "2"]}], ")"}]]}], "+", "gaugePieceN1"}],
             ")"}]}], "//", "Contract"}], "//", "Simplify"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"JvecHadrN2", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"FNVu", "*", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"Sqrt", "[", 
              RowBox[{"4", " ", "Pi", "*", "\[Alpha]EM"}], "]"}], ")"}], "2"],
            "*", "gVNN", "*", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"ubarppr", ".", 
                RowBox[{"GA", "[", "\[Mu]", "]"}], ".", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"GS", "[", "pu", "]"}], "+", "mp"}], ")"}], ".", 
                RowBox[{"GA", "[", "\[Nu]", "]"}], ".", "up"}], ")"}], "*", 
              FractionBox[
               RowBox[{"polV", "[", "\[Nu]", "]"}], 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"ScalarProduct", "[", 
                  RowBox[{"pu", ",", "pu"}], "]"}], "-", 
                 SuperscriptBox["mp", "2"]}], ")"}]]}], "+", "gaugePieceN2"}],
             ")"}]}], "//", "Contract"}], "//", "Simplify"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"MepToepVN1", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{
             "FphotoToElectro", "*", "JvecHadrN1", "*", "LeptonicPiece"}], "//",
              "ExpandScalarProduct"}], "//", "Contract"}], "//", "Simplify"}],
           ")"}], "/.", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"FNVu", "->", "FNV"}], ",", 
           RowBox[{"FNVs", "->", "FNV"}]}], "}"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"MepToepVN2", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{
             "FphotoToElectro", "*", "JvecHadrN2", "*", "LeptonicPiece"}], "//",
              "ExpandScalarProduct"}], "//", "Contract"}], "//", "Simplify"}],
           ")"}], "/.", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"FNVu", "->", "FNV"}], ",", 
           RowBox[{"FNVs", "->", "FNV"}]}], "}"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"MepToepVN", "=", 
        RowBox[{"MepToepVN1", "+", "MepToepVN2"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"ruleVprodN", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"!", "ifFileMsquaredVExists"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"tmp", "=", 
           RowBox[{"MsquaredXinsertedKinematics", "[", 
            RowBox[{
            "MepToepVN1", ",", "MepToepVN1", ",", "True", ",", "ruleVprodN"}],
             "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"tmp", "+=", 
           RowBox[{"MsquaredXinsertedKinematics", "[", 
            RowBox[{
            "MepToepVN2", ",", "MepToepVN2", ",", "True", ",", "ruleVprodN"}],
             "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"tmp", "+=", 
           RowBox[{"MsquaredXinsertedKinematics", "[", 
            RowBox[{
            "MepToepVN1", ",", "MepToepVN2", ",", "True", ",", "ruleVprodN", ",",
              "ruleVprodN"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"MsquaredVprodN", "[", 
            RowBox[{
            "s_", ",", "mp_", ",", "\[Alpha]EM_", ",", "mX_", ",", "s2_", ",",
              "t1_", ",", "t2_", ",", "s1_", ",", "gVNN_", ",", "FNV_", ",", 
             "FphotoToElectro_"}], "]"}], "=", "tmp"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{
          "Print", 
           "[", "\"\<Check that \!\(\*SubscriptBox[\(p\), \(\[Gamma]\)]\)\!\(\
\*SuperscriptBox[\(M\), \(\[Mu]\)]\) = 0 (Ward identities):\>\"", "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Module", "[", 
           RowBox[{
            RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Mel", "=", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"JvecHadrN1", "+", "JvecHadrN2"}], ")"}], "*", 
                 RowBox[{"FV", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"momLab", "[", "e", "]"}], "-", 
                    RowBox[{"momLab", "[", "epr", "]"}]}], ",", "\[Mu]"}], 
                  "]"}]}], "/.", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"FNVu", "->", "FNV"}], ",", 
                  RowBox[{"FNVs", "->", "FNV"}]}], "}"}]}], "//", 
               "Contract"}]}], ";", "\[IndentingNewLine]", 
