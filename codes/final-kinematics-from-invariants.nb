              RowBox[{"etaMax", "-", "etaMin"}], ")"}], "/", "nbins"}]}], 
           "}"}], ",", 
          RowBox[{
           RowBox[{"edges", "=", 
            RowBox[{"N", "@", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"etaMin", "+", 
                RowBox[{"i", " ", "d"}]}], ",", 
               RowBox[{"{", 
                RowBox[{"i", ",", "0", ",", "nbins"}], "}"}]}], "]"}]}]}], ";",
            "\[IndentingNewLine]", 
           RowBox[{"centers", "=", 
            RowBox[{"N", "@", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"etaMin", "+", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"i", "+", "0.5"}], ")"}], " ", "d"}]}], ",", 
               RowBox[{"{", 
                RowBox[{"i", ",", "0", ",", 
                 RowBox[{"nbins", "-", "1"}]}], "}"}]}], "]"}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"widths", "=", 
            RowBox[{"ConstantArray", "[", 
             RowBox[{"d", ",", "nbins"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"counts", "=", 
            RowBox[{"N", "@", 
             RowBox[{"BinCounts", "[", 
              RowBox[{"etaData", ",", 
               RowBox[{"{", 
                RowBox[{"etaMin", ",", "etaMax", ",", "d"}], "}"}]}], 
              "]"}]}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"total", "=", 
            RowBox[{"Total", "[", "counts", "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"total", "==", "0"}], ",", 
             RowBox[{"Return", "[", 
              RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"Transpose", "[", 
             RowBox[{"{", 
              RowBox[{"centers", ",", 
               RowBox[{"counts", "/", 
                RowBox[{"(", 
                 RowBox[{"total", "*", "widths"}], ")"}]}]}], "}"}], "]"}], "//",
             "Developer`ToPackedArray"}]}]}], "]"}]}], "]"}]}]}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.9678616701384983`*^9, 3.9678616956035576`*^9}, {
