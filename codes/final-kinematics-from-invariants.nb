Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{"ifRecomputeCompiledRoutines", ",", 
    RowBox[{"imposingCuts", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Hold", "@", 
        RowBox[{"Compile", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"ptsKin", ",", "_Real", ",", "1"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"weights", ",", "_Real"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"EXmin", ",", "_Real"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"EpprMin", ",", "_Real"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"EpprMax", ",", "_Real"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"etaPmin", ",", "_Real"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"etaXmin", ",", "_Real"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"etaXmax", ",", "_Real"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"Q2emin", ",", "_Real"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"Q2emax", ",", "_Real"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"ifBaseline", ",", 
              RowBox[{"True", "|", "False"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"ifBaselineFBDupgrade", ",", 
              RowBox[{"True", "|", "False"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"ifOptimalSetup", ",", 
              RowBox[{"True", "|", "False"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"ifHighEnergySetup", ",", 
              RowBox[{"True", "|", "False"}]}], "}"}]}], "}"}], ",", 
          RowBox[{"Module", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
             "Eppr", ",", "EX", ",", "Eepr", ",", "cppr", ",", "cX", ",", 
              "cepr", ",", "s2", ",", "t1", ",", "t2", ",", "s1", ",", 
              RowBox[{"(*", 
               RowBox[{
                RowBox[{
                 RowBox[{"robust", " ", "eta", " ", "from", " ", "cos", 
                  RowBox[{"(", "theta", ")"}]}], ":", "eta"}], "=", 
                RowBox[{"0.5", " ", "Log", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"1", "+", "c"}], ")"}], "/", 
                   RowBox[{"(", 
                    RowBox[{"1", "-", "c"}], ")"}]}], ")"}]}]}], "*)"}], 
              RowBox[{"eps", "=", "1.*^-12"}], ",", "cClip", ",", "etaPpr", ",",
               "etaX", ",", 
              RowBox[{"pass", "=", "1."}], ",", 
              RowBox[{"\[Phi]Suppression", "=", "0."}], ",", 
              RowBox[{"etaePr", "=", "0."}]}], "}"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{
               "s2", ",", "t1", ",", "t2", ",", "s1", ",", "Eppr", ",", "EX", 
                ",", "Eepr", ",", "cppr", ",", "cX", ",", "cepr"}], "}"}], "=",
               "ptsKin"}], ";", "\[IndentingNewLine]", 
             RowBox[{"cClip", "=", "cppr"}], ";", "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"cClip", ">", 
                RowBox[{"1.", "-", "eps"}]}], ",", 
               RowBox[{"cClip", "=", 
                RowBox[{"1.", "-", "eps"}]}]}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"cClip", "<", 
                RowBox[{
                 RowBox[{"-", "1."}], "+", "eps"}]}], ",", 
               RowBox[{"cClip", "=", 
                RowBox[{
                 RowBox[{"-", "1."}], "+", "eps"}]}]}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"etaPpr", "=", 
              RowBox[{"0.5", "*", 
               RowBox[{"Log", "[", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"1.", "+", "cClip"}], ")"}], "/", 
                 RowBox[{"(", 
                  RowBox[{"1.", "-", "cClip"}], ")"}]}], "]"}]}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"cClip", "=", "cX"}], ";", "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"cClip", ">", 
                RowBox[{"1.", "-", "eps"}]}], ",", 
               RowBox[{"cClip", "=", 
                RowBox[{"1.", "-", "eps"}]}]}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"cClip", "<", 
                RowBox[{
                 RowBox[{"-", "1."}], "+", "eps"}]}], ",", 
               RowBox[{"cClip", "=", 
                RowBox[{
                 RowBox[{"-", "1."}], "+", "eps"}]}]}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"etaX", "=", 
              RowBox[{"0.5", "*", 
               RowBox[{"Log", "[", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"1.", "+", "cClip"}], ")"}], "/", 
                 RowBox[{"(", 
                  RowBox[{"1.", "-", "cClip"}], ")"}]}], "]"}]}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"etaePr", "=", 
              RowBox[{"0.5", "*", 
               RowBox[{"Log", "[", 
                FractionBox[
                 RowBox[{"1.", "+", "cepr"}], 
                 RowBox[{"1.", "-", "cepr"}]], "]"}]}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"!", 
                RowBox[{"(", 
                 RowBox[{
                 "ifBaseline", "||", "ifBaselineFBDupgrade", "||", 
                  "ifOptimalSetup", "||", "ifHighEnergySetup"}], ")"}]}], ",",
                "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"pass", "=", 
                 RowBox[{"Boole", "[", 
                  RowBox[{
