Cell[CellGroupData[{

Cell["Final block", "Subsection",
 CellChangeTimes->{{3.9682077580337143`*^9, 
  3.9682077590904922`*^9}},ExpressionUUID->"561419f9-23b5-4e40-98ab-\
8b07fce84cd2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"BlockFinalTemp", "[", 
     RowBox[{
     "particle_", ",", "mX_", ",", "fa_", ",", "Ep_", ",", "Ee_", ",", 
      "useLogS2Lower_", ",", "useLogT1_", ",", "useLogT2_", ",", "useCosS1_", 
      ",", "Nevents_", ",", "EXmin_", ",", "EpprMin_", ",", "EpprMax_", ",", 
      "etapprMin_", ",", "etaXmin_", ",", "etaXmax_", ",", "Q2emin_", ",", 
      "Q2emax_", ",", "ifBaseline_", ",", "ifBaselineFBDupgrade_", ",", 
      "ifOptimal_", ",", "ifHighEnergy_", ",", "nbinsEnergy_", ",", 
      "nbinsEta_", ",", 
      RowBox[{"ifOwnCut_", ":", "False"}], ",", 
      RowBox[{"ownCutFunction_", ":", "x"}], ",", 
      RowBox[{"ifResamplerNeeded_", ":", "True"}]}], "]"}], ":=", 
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"s", "=", 
         RowBox[{"sep", "[", 
          RowBox[{"Ep", ",", "Ee", ",", "mpval", ",", "meval"}], "]"}]}], ",", 
        RowBox[{"ifs1", "=", "True"}], ",", 
        RowBox[{"ift2", "=", "True"}], ",", 
        RowBox[{"mass", "=", 
         RowBox[{"massX", "[", 
          RowBox[{"particle", ",", "mX"}], "]"}]}]}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"points", " ", "and", " ", "weights"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"BlockPointsWeightsParticle", "[", 
        RowBox[{
        "particle", ",", "mass", ",", "fa", ",", "Ep", ",", "Ee", ",", "ifs1",
          ",", "ift2", ",", "useLogS2Lower", ",", "useLogT1", ",", "useLogT2",
          ",", "useCosS1", ",", "Nevents"}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"\[Sigma]tot", "=", 
        RowBox[{"GeVm2Tob", "*", 
         RowBox[{"Total", "[", "weights", "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"kinematics", " ", "per", " ", 
         RowBox[{"point", ":", 
          RowBox[{"{", 
           RowBox[{
           "s2", ",", "t1", ",", "t2", ",", "s1", ",", "EX", ",", "Eppr", ",",
             "cosTh"}], "}"}]}]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"ptsKin", "=", 
        RowBox[{"kinematicsComp", "[", 
         RowBox[{"pts", ",", "mass", ",", "Ee", ",", "Ep"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"apply", " ", 
         RowBox[{"cuts", ":", 
          RowBox[{"returns", " ", 
           RowBox[{"{", 
            RowBox[{
            "wCut", ",", "s2", ",", "t1", ",", "t2", ",", "s1", ",", "EX", ",",
              "Eppr", ",", "cosTh", ",", "etaP"}], "}"}]}]}]}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"Block", "[", 
        RowBox[{
         RowBox[{"{", "preData", "}"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"!", "ifOwnCut"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"preData", "=", 
              RowBox[{"imposingCuts", "[", 
               RowBox[{
               "ptsKin", ",", "weights", ",", "EXmin", ",", "EpprMin", ",", 
                "EpprMax", ",", "etapprMin", ",", "etaXmin", ",", "etaXmax", ",",
                 "Q2emin", ",", "Q2emax", ",", "ifBaseline", ",", 
                "ifBaselineFBDupgrade", ",", "ifOptimal", ",", 
                "ifHighEnergy"}], "]"}]}], ";"}], "\[IndentingNewLine]", ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"preData", "=", 
              RowBox[{"ownCutFunction", "[", 
               RowBox[{"ptsKin", ",", "weights"}], "]"}]}], ";"}]}], 
           "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"ptsAfterCuts", "=", 
           RowBox[{"selectorNonZero", "[", "preData", "]"}]}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "total", " ", "cross", " ", "section", " ", "from", " ", "full", " ", 
         "cut", " ", "sample"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"\[Sigma]cuts", "=", 
        RowBox[{"GeVm2Tob", "*", 
         RowBox[{"Total", "[", 
          RowBox[{"ptsAfterCuts", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "indexFinWeights"}], "]"}], "]"}], "]"}]}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{"ifResamplerNeeded", ",", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "a", " ", "light", " ", "subsample", " ", "for", " ", "plotting", " ",
            "tabulated", " ", "distributions"}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"subsample", "=", 
           RowBox[{"fastSamplerFin", "[", 
            RowBox[{"ptsAfterCuts", ",", 
             RowBox[{"Max", "[", 
              RowBox[{"10", ",", 
               RowBox[{"IntegerPart", "[", 
                RowBox[{"Nevents", "/", "10"}], "]"}]}], "]"}]}], "]"}]}], ";",
           "\[IndentingNewLine]", 
          RowBox[{"EXdistr", "=", 
           RowBox[{"energyPDF", "[", 
            RowBox[{
             RowBox[{"subsample", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "indexFinEX"}], "]"}], "]"}], ",", 
             "nbinsEnergy", ",", "Ee", ",", "Ep", ",", "mass", ",", "False"}],
             "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"EpprDistr", "=", 
           RowBox[{"energyPDF", "[", 
            RowBox[{
             RowBox[{"subsample", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "indexFinEppr"}], "]"}], "]"}], ",", 
             "nbinsEnergy", ",", "Ee", ",", "Ep", ",", "mpval", ",", 
             "False"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"thDistr", "=", 
             RowBox[{"energyBin", "[", 
              RowBox[{
               RowBox[{"subsample", "[", 
                RowBox[{"[", 
                 RowBox[{"All", ",", 
                  RowBox[{"-", "2"}]}], "]"}], "]"}], ",", "nbinsEnergy", ",",
                "Ee", ",", "Ep", ",", "mpval"}], "]"}]}], ";"}], "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"EtaDistr", "=", 
           RowBox[{"etaPDF", "[", 
            RowBox[{
             RowBox[{"subsample", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "index\[Eta]ppr"}], "]"}], "]"}], ",", 
             "nbinsEta", ",", 
             RowBox[{"Max", "[", 
              RowBox[{"etapprMin", ",", "0.01"}], "]"}], ",", "12.", ",", 
             "False"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{
           "\[Sigma]tot", ",", "\[Sigma]cuts", ",", "EXdistr", ",", 
            "EpprDistr", ",", "EtaDistr"}], "}"}]}], "\[IndentingNewLine]", ",",
          "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"\[Sigma]tot", ",", "\[Sigma]cuts"}], "}"}]}], 
        "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", "]"}]}], 
   ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Convenience", " ", "wrapper", " ", "with", " ", "sensible", " ", 
    "defaults", " ", "for", " ", "bins"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"BlockFinal", "[", 
   RowBox[{
   "particle_", ",", "mX_", ",", "fa_", ",", "Ep_", ",", "Ee_", ",", 
    "Nevents_", ",", "EXmin_", ",", "EpprMin_", ",", "EpprMax_", ",", 
    "etapprMin_", ",", "etaXmin_", ",", "etaXmax_", ",", "Q2emin_", ",", 
