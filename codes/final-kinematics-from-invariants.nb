Cell[CellGroupData[{

Cell["Constructing double PDF", "Subsubsection",
 CellChangeTimes->{{3.9678608215331097`*^9, 
  3.96786082409774*^9}},ExpressionUUID->"0102d71c-d5ee-0544-96b4-\
6ca550d34a2c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"PDF2D", "[", 
     RowBox[{"raw_", ",", "ifLogx_", ",", "ifLogy_", ",", "nx_", ",", "ny_"}],
      "]"}], ":=", 
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "data", ",", "filt", ",", "xvals", ",", "yvals", ",", "u", ",", "v", ",",
         "xmin", ",", "xmax", ",", "ymin", ",", "ymax", ",", "dx", ",", "dy", 
        ",", "counts", ",", "nxEff", ",", "nyEff", ",", "xcentT", ",", 
        "ycentT", ",", "xcent", ",", "ycent", ",", "triplets", ",", 
        "tripletsNZ", ",", "wx", ",", "wy", ",", "proper", ",", "n"}], "}"}], 
      ",", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
        "drop", " ", "points", " ", "incompatible", " ", "with", " ", "log"}],
         "-", 
        RowBox[{"space", " ", "requests"}]}], "*)"}], 
      RowBox[{
       RowBox[{"filt", "=", 
        RowBox[{"Select", "[", 
         RowBox[{"raw", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"!", "ifLogx"}], "||", 
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}], ">", "0."}]}], ")"}], "&&", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"!", "ifLogy"}], "||", 
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", "2", "]"}], "]"}], ">", "0."}]}], ")"}]}], 
           "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"filt", "===", 
          RowBox[{"{", "}"}]}], ",", 
         RowBox[{"Return", "[", 
          RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"n", "=", 
        RowBox[{"Length", "[", "filt", "]"}]}], ";", 
       RowBox[{"(*", 
        RowBox[{
        "total", " ", "samples", " ", "for", " ", "PDF", " ", 
         "normalization"}], "*)"}], 
       RowBox[{"(*", 
        RowBox[{"split", " ", "columns"}], "*)"}], 
       RowBox[{"xvals", "=", 
        RowBox[{"filt", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"yvals", "=", 
        RowBox[{"filt", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "transform", " ", "for", " ", "binning", " ", "if", " ", 
         "requested"}], "*)"}], 
       RowBox[{"u", "=", 
        RowBox[{"If", "[", 
         RowBox[{"ifLogx", ",", 
          RowBox[{"Log", "[", "xvals", "]"}], ",", "xvals"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"v", "=", 
        RowBox[{"If", "[", 
         RowBox[{"ifLogy", ",", 
          RowBox[{"Log", "[", "yvals", "]"}], ",", "yvals"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"ranges", " ", "in", " ", "the", " ", 
         RowBox[{"(", 
          RowBox[{"possibly", " ", "transformed"}], ")"}], " ", "variables"}],
         "*)"}], 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"xmin", ",", "xmax"}], "}"}], "=", 
        RowBox[{"MinMax", "[", "u", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"ymin", ",", "ymax"}], "}"}], "=", 
        RowBox[{"MinMax", "[", "v", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "number", " ", "of", " ", "bins", " ", "and", " ", "step", " ", 
         "sizes", " ", "in", " ", "transformed", " ", "space"}], "*)"}], 
       RowBox[{"dx", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"xmax", "-", "xmin"}], ")"}], "/", "nx"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"dy", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"ymax", "-", "ymin"}], ")"}], "/", "ny"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "2", "D", " ", "histogram", " ", "in", " ", "the", " ", "transformed",
          " ", "space"}], "*)"}], 
       RowBox[{"counts", "=", 
        RowBox[{"BinCounts", "[", 
         RowBox[{
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{"u", ",", "v"}], "}"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"xmin", ",", "xmax", ",", "dx"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"ymin", ",", "ymax", ",", "dy"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"nxEff", ",", "nyEff"}], "}"}], "=", 
        RowBox[{"Dimensions", "[", "counts", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "bin", " ", "centers", " ", "in", " ", "transformed", " ", 
          "coords"}], ",", 
         RowBox[{
         "then", " ", "map", " ", "back", " ", "to", " ", "original", " ", 
          "scale"}]}], "*)"}], 
       RowBox[{"xcentT", "=", 
        RowBox[{"N", "@", 
         RowBox[{"Range", "[", 
          RowBox[{
           RowBox[{"xmin", "+", 
            RowBox[{"dx", "/", "2"}]}], ",", 
           RowBox[{"xmin", "+", 
            RowBox[{"dx", "/", "2"}], "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"nxEff", "-", "1"}], ")"}], " ", "dx"}]}], ",", "dx"}], 
          "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"ycentT", "=", 
        RowBox[{"N", "@", 
         RowBox[{"Range", "[", 
          RowBox[{
           RowBox[{"ymin", "+", 
            RowBox[{"dy", "/", "2"}]}], ",", 
           RowBox[{"ymin", "+", 
            RowBox[{"dy", "/", "2"}], "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"nyEff", "-", "1"}], ")"}], " ", "dy"}]}], ",", "dy"}], 
          "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"xcent", "=", 
        RowBox[{"If", "[", 
         RowBox[{"ifLogx", ",", 
          RowBox[{"Exp", "[", "xcentT", "]"}], ",", "xcentT"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"ycent", "=", 
        RowBox[{"If", "[", 
         RowBox[{"ifLogy", ",", 
          RowBox[{"Exp", "[", "ycentT", "]"}], ",", "ycentT"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"triplets", " ", 
         RowBox[{"{", 
          RowBox[{"xCenter", ",", "yCenter", ",", "count"}], "}"}]}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"triplets", "=", 
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"xcent", "[", 
               RowBox[{"[", "i", "]"}], "]"}], ",", 
              RowBox[{"ycent", "[", 
               RowBox[{"[", "j", "]"}], "]"}], ",", 
              RowBox[{"counts", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "j"}], "]"}], "]"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "nxEff"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", "nyEff"}], "}"}]}], "]"}], ",", "1"}], "]"}]}],
        ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"keep", " ", "only", " ", "non"}], "-", 
         RowBox[{"empty", " ", "bins"}]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"tripletsNZ", "=", 
        RowBox[{"Select", "[", 
         RowBox[{"triplets", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "3", "]"}], "]"}], ">", "0"}], "&"}]}], "]"}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "bin", " ", "widths", " ", "in", " ", "transformed", " ", "space"}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"wx", "=", "dx"}], ";", 
       RowBox[{"wy", "=", "dy"}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
          RowBox[{"Convert", " ", "counts"}], "->", 
          RowBox[{"PDF", 
           RowBox[{"(", 
            RowBox[{"x", ",", "y"}], ")"}], " ", "with", " ", "respect", " ", 
           "to", " ", "original", " ", "dx", " ", 
           RowBox[{"dy", ":", 
            RowBox[{"counts", "/", 
             RowBox[{"(", 
              RowBox[{"n", "*", "du", "*", "dv", "*", 
               RowBox[{"x", "^", "I"}], "*", 
               RowBox[{"y", "^", "J"}]}], ")"}]}]}]}]}], ",", 
         RowBox[{
          RowBox[{"with", " ", "I"}], "=", 
          RowBox[{"1", " ", "if", " ", "ifLogx", " ", "else", " ", "0"}]}], ",", 
         RowBox[{"J", "=", 
          RowBox[{"1", " ", "if", " ", "ifLogy", " ", "else", " ", "0."}]}]}],
         "*)"}], "\[IndentingNewLine]", 
       RowBox[{"proper", "=", 
        RowBox[{"tripletsNZ", "/.", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"x_", ",", "y_", ",", "c_"}], "}"}], ":>", 
           RowBox[{"Module", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"jacx", ",", "jacy"}], "}"}], ",", 
             RowBox[{
              RowBox[{"jacx", "=", 
               RowBox[{"If", "[", 
                RowBox[{"ifLogx", ",", "x", ",", "1."}], "]"}]}], ";", 
              RowBox[{"jacy", "=", 
               RowBox[{"If", "[", 
                RowBox[{"ifLogy", ",", "y", ",", "1."}], "]"}]}], ";", 
              RowBox[{"{", 
               RowBox[{"x", ",", "y", ",", 
                RowBox[{"c", "/", 
                 RowBox[{"(", 
                  RowBox[{
                  "n", "*", "wx", "*", "wy", "*", "jacx", "*", "jacy"}], 
                  ")"}]}]}], "}"}]}]}], "]"}]}], "}"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"result", ":", 
         RowBox[{"list", " ", "of", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"bin", " ", "center", " ", "x"}], ",", 
            RowBox[{"bin", " ", "center", " ", "y"}], ",", 
            RowBox[{"PDF", 
             RowBox[{"(", 
              RowBox[{"x", ",", "y"}], ")"}]}]}], "}"}]}]}], "*)"}], 
       "\[IndentingNewLine]", "proper"}]}], "\[IndentingNewLine]", "]"}]}], 
   ";"}], "\n", "\n"}]], "Input",
 CellChangeTimes->{{3.9678608248719254`*^9, 3.9678608406442204`*^9}, {
   3.967860897334461*^9, 3.9678609311594925`*^9}, {3.9678784784686394`*^9, 
   3.967878492334196*^9}, 3.967878711167616*^9, {3.9684665143376293`*^9, 
   3.968466541014553*^9}},
 CellLabel->"In[29]:=",ExpressionUUID->"2c713919-3ff6-0d4f-ba0d-62e5b5cba440"]
