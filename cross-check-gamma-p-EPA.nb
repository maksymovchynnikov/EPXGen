Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Sigma]Wtab", "=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "mes", "=", "\"\<\!\(\*SuperscriptBox[\(\[Rho]\), \(0\)]\)\>\""}], 
        "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"ParallelTable", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"ECM", ">", 
            RowBox[{"mpval", "+", 
             RowBox[{"MASS", "[", "mes", "]"}]}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"Module", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
              "tmind", ",", "tmaxd", ",", "tvals", ",", "tabd\[Sigma]t", ",", 
               "intt"}], "}"}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"{", 
                RowBox[{"tmind", ",", "tmaxd"}], "}"}], "=", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"tmin", "[", 
                  RowBox[{
                   SuperscriptBox["ECM", "2"], ",", "mpval", ",", 
                   RowBox[{"MASS", "[", "mes", "]"}]}], "]"}], ",", 
                 RowBox[{"tmax", "[", 
                  RowBox[{
                   SuperscriptBox["ECM", "2"], ",", "mpval", ",", 
                   RowBox[{"MASS", "[", "mes", "]"}]}], "]"}]}], "}"}]}], ";",
               "\[IndentingNewLine]", 
              RowBox[{"tvals", "=", 
               RowBox[{"Table", "[", 
                RowBox[{
                 SuperscriptBox["10", "x"], ",", 
                 RowBox[{"{", 
                  RowBox[{"x", ",", 
                   RowBox[{"Log10", "[", "tmind", "]"}], ",", 
                   RowBox[{"Log10", "[", "tmaxd", "]"}], ",", 
                   FractionBox[
                    RowBox[{
                    RowBox[{"Log10", "[", "tmaxd", "]"}], "-", 
                    RowBox[{"Log10", "[", "tmind", "]"}]}], "300"]}], "}"}]}],
                 "]"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"tabd\[Sigma]t", "=", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"#", ",", 
                   RowBox[{"Max", "[", 
                    RowBox[{
                    SuperscriptBox["10", 
                    RowBox[{"-", "90."}]], ",", 
                    RowBox[{"Quiet", "[", 
                    RowBox[{"Re", "[", 
                    RowBox[{"GeVm2Tob", "*", 
                    SuperscriptBox["10", "9"], "*", 
                    RowBox[{"d\[Sigma]VproddtPhoto", "[", 
                    RowBox[{
                    SuperscriptBox["ECM", "2"], ",", "#", ",", "mes"}], 
                    "]"}]}], "]"}], "]"}]}], "]"}]}], "}"}], "&"}], "/@", 
                "tvals"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"intt", "[", "t_", "]"}], "=", 
               RowBox[{
                RowBox[{
                 RowBox[{"Interpolation", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"tabd\[Sigma]t", "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", 
                    RowBox[{"{", 
                    RowBox[{"1", ",", "2"}], "}"}]}], "]"}], "]"}], "//", 
                    "Log"}], ",", 
                   RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}], "[", 
                 RowBox[{"Log", "[", "t", "]"}], "]"}], "//", "Exp"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"Quiet", "[", 
               RowBox[{"{", 
                RowBox[{"ECM", ",", 
                 RowBox[{"Quiet", "[", 
                  RowBox[{"NIntegrate", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"intt", "[", 
                    RowBox[{"Exp", "[", "t", "]"}], "]"}], 
                    RowBox[{"Exp", "[", "t", "]"}]}], ",", 
                    RowBox[{"{", 
                    RowBox[{"t", ",", 
                    RowBox[{"Log", "[", "tmind", "]"}], ",", 
                    RowBox[{"Log", "[", "tmaxd", "]"}]}], "}"}]}], "]"}], 
                  "]"}]}], "}"}], "]"}]}]}], "\[IndentingNewLine]", "]"}], 
           "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"ECM", ",", "0."}], "}"}]}], "\[IndentingNewLine]", "]"}],
          "\[IndentingNewLine]", ",", 
         RowBox[{"{", 
          RowBox[{"ECM", ",", 
           RowBox[{"Table", "[", 
            RowBox[{
             SuperscriptBox["10", "x"], ",", 
             RowBox[{"{", 
              RowBox[{"x", ",", 
               RowBox[{"Log10", "[", 
                RowBox[{"mpval", "+", 
                 RowBox[{"MASS", "[", "mes", "]"}]}], "]"}], ",", 
               RowBox[{"Log10", "[", "500.", "]"}], ",", "0.005"}], "}"}]}], 
            "]"}]}], "}"}]}], "]"}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"ListLogLogPlot", "[", 
    RowBox[{"\[Sigma]Wtab", ",", 
     RowBox[{"PlotRange", "->", 
      RowBox[{"{", 
       RowBox[{"All", ",", 
        RowBox[{"{", 
         RowBox[{"500", ",", 
          RowBox[{"5", "*", 
           SuperscriptBox["10", "4"]}]}], "}"}]}], "}"}]}], ",", 
     RowBox[{"ImageSize", "->", "Large"}], ",", 
     RowBox[{"Frame", "->", "True"}], ",", 
     RowBox[{"FrameStyle", "->", 
      RowBox[{"Directive", "[", 
       RowBox[{"Thick", ",", "Black", ",", "20", ",", 
        RowBox[{"FontFamily", "->", "\"\<Palatino\>\""}]}], "]"}]}]}], 
    "]"}]}]}]], "Input",
