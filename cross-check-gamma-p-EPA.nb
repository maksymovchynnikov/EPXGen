Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"replNumPhotoV", "[", "V_", "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"mp", "->", "mpval"}], ",", 
     RowBox[{"mX", "->", 
      RowBox[{"MASS", "[", "V", "]"}]}], ",", 
     RowBox[{"mf2", "->", 
      RowBox[{
      "MASS", "[", "\"\<\!\(\*SubscriptBox[\(f\), \(2\)]\)(1270)\>\"", 
       "]"}]}], ",", 
     RowBox[{"\[Alpha]EM", "->", "\[Alpha]EMval"}], ",", 
     RowBox[{"g\[Sigma]NN", "->", "g\[Sigma]NNval"}], ",", 
     RowBox[{"gf2NN", "->", "gf2NN1val"}], ",", 
     RowBox[{"gf2V\[Gamma]", "->", 
      RowBox[{"gf2V\[Gamma]Val", "[", "V", "]"}]}], ",", 
     RowBox[{"g\[Sigma]V\[Gamma]", "->", 
      RowBox[{"g\[Sigma]V\[Gamma]Val", "[", "V", "]"}]}], ",", 
     RowBox[{"g\[Gamma]\[Pi]V", "->", 
      RowBox[{"gPV\[Gamma]", "[", 
       RowBox[{"\"\<\!\(\*SuperscriptBox[\(\[Pi]\), \(0\)]\)\>\"", ",", "V"}],
        "]"}]}], ",", 
     RowBox[{"\[Beta]\[Beta]toF", "->", 
      RowBox[{"\[Beta]\[Beta]toFval", "[", "V", "]"}]}], ",", 
     RowBox[{"g\[Pi]NN", "->", 
      RowBox[{
      "gPNN", "[", "\"\<\!\(\*SuperscriptBox[\(\[Pi]\), \(0\)]\)\>\"", 
       "]"}]}], ",", 
     RowBox[{"gVNN", "->", 
      RowBox[{"gVNNval", "[", "V", "]"}]}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Do", "[", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"s2", "->", "s"}], ",", 
    RowBox[{"t2", "->", 
     RowBox[{"-", "t"}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"reggeizedRepl", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Fbaryonic", "->", 
        RowBox[{"(*", 
         RowBox[{"FbaryonicExplicit", "[", "s", "]"}], "*)"}], "1"}], ",", 
       RowBox[{"ReggeNs", "->", 
        RowBox[{"(*", 
         RowBox[{"ReggeizedNucleon", "[", 
          RowBox[{"s", ",", "t", ",", "mX"}], "]"}], "*)"}], "1"}], ",", 
       RowBox[{"ReggeNsStar", "->", 
        RowBox[{"(*", 
         RowBox[{"ReggeizedNucleonStar", "[", 
          RowBox[{"s", ",", "t", ",", "mX"}], "]"}], "*)"}], "1"}], ",", 
       RowBox[{"ReggeNu", "->", "1"}], ",", 
       RowBox[{"ReggeNuStar", "->", "1"}]}], "}"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"d\[Sigma]VproddtPhotoN", "[", 
      RowBox[{"s_", ",", "t_", ",", "V"}], "]"}], "=", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"tmin", "[", 
          RowBox[{"s", ",", "mpval", ",", "mX"}], "]"}], "<", "t", "<", 
         RowBox[{"tmax", "[", 
          RowBox[{"s", ",", "mpval", ",", "mX"}], "]"}]}], ",", 
        RowBox[{"Evaluate", "[", 
         RowBox[{
          RowBox[{"d\[Sigma]dtXphotoTemp", "[", 
           RowBox[{"MsquaredVprodPhotoN", "[", 
            RowBox[{
            "s", ",", "\[Alpha]EM", ",", "cos\[Theta]", ",", "mp", ",", "mX", 
             ",", "gVNN", ",", "Fbaryonic", ",", "ReggeNu", ",", 
             "ReggeNuStar", ",", "ReggeNs", ",", "ReggeNsStar"}], "]"}], 
           "]"}], "/.", "reggeizedRepl"}], "]"}], ",", "0."}], "]"}], "/.", 
      RowBox[{"replNumPhotoV", "[", "V", "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", ",", 
   RowBox[{"{", 
    RowBox[{"V", ",", 
     RowBox[{"{", 
      RowBox[{
      "\"\<\!\(\*SuperscriptBox[\(\[Rho]\), \(0\)]\)\>\"", ",", 
       "\"\<\[Omega]\>\"", ",", "\"\<\[Phi]\>\""}], "}"}]}], "}"}]}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tabToFit", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1.9", ",", "2.5", ",", "2.5"}], "}"}], ",", 
     RowBox[{"{", 
