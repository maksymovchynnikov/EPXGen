Cell[BoxData[
 RowBox[{"Do", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"replFactors", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Regge\[Rho]", "->", 
        RowBox[{"ReggeizedPropagator\[Rho]", "[", 
         RowBox[{"s", ",", 
          RowBox[{"-", "t"}], ",", "P"}], "]"}]}], ",", 
       RowBox[{"Regge\[Rho]Star", "->", 
        RowBox[{"ReggeizedPropagator\[Rho]Star", "[", 
         RowBox[{"s", ",", 
          RowBox[{"-", "t"}], ",", "P"}], "]"}]}], ",", 
       RowBox[{"Regge\[Omega]", "->", 
        RowBox[{"ReggeizedPropagator\[Omega]", "[", 
         RowBox[{"s", ",", 
          RowBox[{"-", "t"}], ",", "P"}], "]"}]}], ",", 
       RowBox[{"Regge\[Omega]Star", "->", 
        RowBox[{"ReggeizedPropagator\[Omega]Star", "[", 
         RowBox[{"s", ",", 
          RowBox[{"-", "t"}], ",", "P"}], "]"}]}]}], "}"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"replNum", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"mX", "->", 
        RowBox[{"MASS", "[", "P", "]"}]}], ",", 
       RowBox[{"\[Alpha]EM", "->", "\[Alpha]EMval"}], ",", 
       RowBox[{"mp", "->", "mpval"}], ",", 
       RowBox[{"\[Kappa]\[Rho]", "->", 
        RowBox[{"(*", 
         RowBox[{
         "\[Kappa]Vval", "[", 
          "\"\<\!\(\*SuperscriptBox[\(\[Rho]\), \(0\)]\)\>\"", "]"}], "*)"}], 
        "4.2"}], ",", 
       RowBox[{"\[Kappa]\[Omega]", "->", 
        RowBox[{"\[Kappa]Vval", "[", "\"\<\[Omega]\>\"", "]"}]}], ",", 
       RowBox[{"g\[Rho]pp", "->", 
        RowBox[{
        "gVNNval", "[", "\"\<\!\(\*SuperscriptBox[\(\[Rho]\), \(0\)]\)\>\"", 
         "]"}]}], ",", 
       RowBox[{"g\[Omega]pp", "->", 
        RowBox[{"gVNNval", "[", "\"\<\[Omega]\>\"", "]"}]}], ",", 
       RowBox[{"g\[Gamma]P\[Rho]", "->", 
        RowBox[{"gPV\[Gamma]", "[", 
         RowBox[{
         "P", ",", "\"\<\!\(\*SuperscriptBox[\(\[Rho]\), \(0\)]\)\>\""}], 
         "]"}]}], ",", 
       RowBox[{"g\[Gamma]P\[Omega]", "->", 
        RowBox[{"gPV\[Gamma]", "[", 
         RowBox[{"P", ",", "\"\<\[Omega]\>\""}], "]"}]}]}], "}"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"d\[Sigma]dtPphotoNum", "[", 
      RowBox[{"s_", ",", "t_", ",", "P"}], "]"}], "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"GeVm2Tob", "*", 
        RowBox[{"d\[Sigma]dtXphotoTemp", "[", 
         RowBox[{"MsquaredPprodPhotoV", "[", 
          RowBox[{
          "s", ",", "\[Alpha]EM", ",", "cos\[Theta]", ",", "mp", ",", "mX", 
           ",", "g\[Rho]pp", ",", "\[Kappa]\[Rho]", ",", "g\[Gamma]P\[Rho]", 
           ",", "Regge\[Rho]", ",", "Regge\[Rho]Star", ",", "g\[Omega]pp", 
           ",", "\[Kappa]\[Omega]", ",", "g\[Gamma]P\[Omega]", ",", 
           "Regge\[Omega]", ",", "Regge\[Omega]Star"}], "]"}], "]"}]}], "/.", 
       "replFactors"}], "/.", "replNum"}]}], ";"}], "\[IndentingNewLine]", 
   ",", 
   RowBox[{"{", 
    RowBox[{"P", ",", 
     RowBox[{"{", 
      RowBox[{
      "\"\<\!\(\*SuperscriptBox[\(\[Pi]\), \(0\)]\)\>\"", ",", 
       "\"\<\[Eta]\>\"", ",", "\"\<\[Eta]'\>\""}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
