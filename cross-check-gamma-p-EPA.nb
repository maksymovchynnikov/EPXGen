Cell[BoxData[{
 RowBox[{
  RowBox[{"JvecHadrS", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        SqrtBox[
         RowBox[{"4", "Pi", "*", "\[Alpha]EM"}]], "*", "g\[Sigma]NN", "*", 
        "g\[Sigma]V\[Gamma]", "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"mom\[Gamma]", "[", "\[Kappa]", "]"}], "*", 
           RowBox[{"momV", "[", "\[Kappa]", "]"}], "*", 
           RowBox[{"polV", "[", "\[Mu]", "]"}]}], "-", 
          RowBox[{
           RowBox[{"polV", "[", "\[Kappa]", "]"}], "*", 
           RowBox[{"mom\[Gamma]", "[", "\[Kappa]", "]"}], "*", 
           RowBox[{"momV", "[", "\[Mu]", "]"}]}]}], ")"}], "*", 
        RowBox[{"(", 
         RowBox[{"ubarppr", ".", "up"}], ")"}], "*", "R\[Sigma]"}], "//", 
       "ExpandScalarProduct"}], "//", "Contract"}], "//", 
     "ExpandScalarProduct"}], "//", "Simplify"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ruleVprodS", "=", 
   RowBox[{"{", 
    RowBox[{"R\[Sigma]", "->", "R\[Sigma]Star"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"MepToepVS", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"JvecHadrS", "*", 
       RowBox[{"pol\[Gamma]", "[", "\[Mu]", "]"}]}], "//", 
      "ExpandScalarProduct"}], "//", "Contract"}], "//", "Simplify"}]}], 
  ";"}], "\[IndentingNewLine]", 
