e34c6c8bc3ab"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"JvecHadrP", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"I", "*", "g\[Gamma]\[Pi]V", "*", "2", "*", "g\[Pi]NN", "*", 
      RowBox[{"LeviCivita", "[", 
       RowBox[{"\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]"}], 
       "]"}], "*", 
      RowBox[{"polV", "[", "\[Nu]", "]"}], "*", 
      RowBox[{"mom\[Gamma]", "[", "\[Alpha]", "]"}], "*", 
      RowBox[{"momV", "[", "\[Beta]", "]"}], "*", 
      RowBox[{"(", 
       RowBox[{"ubarppr", ".", "GA5", ".", "up"}], ")"}], "*", "R\[Pi]"}], "//",
      "ExpandScalarProduct"}], "//", "Contract"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ruleVprodP", "=", 
   RowBox[{"{", 
    RowBox[{"R\[Pi]", "->", "R\[Pi]Star"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"MepToepVP", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"JvecHadrP", "*", 
       RowBox[{"pol\[Gamma]", "[", "\[Mu]", "]"}]}], "//", 
      "ExpandScalarProduct"}], "//", "Contract"}], "//", "Simplify"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"MsquaredVprodPhotoP", "[", 
    RowBox[{
    "s_", ",", "\[Alpha]EM_", ",", "cos\[Theta]_", ",", "mp_", ",", "mX_", 
     ",", "g\[Gamma]\[Pi]V_", ",", "g\[Pi]NN_", ",", "R\[Pi]_", ",", 
     "R\[Pi]Star_"}], "]"}], "=", 
   RowBox[{"MsquaredPhotoXInsertedKinematics", "[", 
    RowBox[{"MepToepVP", ",", "MepToepVP", ",", "True", ",", "ruleVprodP"}], 
    "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.979353963503853*^9, 3.979353964857559*^9}, 
   3.9793540008424683`*^9, 3.9793540454838696`*^9, 3.9793541946298103`*^9, {
   3.9793542719610558`*^9, 3.979354276892784*^9}, {3.9793543074296837`*^9, 
   3.9793543084317207`*^9}, {3.979354355203535*^9, 3.979354378652254*^9}, {
   3.9793544390705547`*^9, 3.979354453310255*^9}, {3.9802249000331306`*^9, 
   3.980224900638727*^9}, 3.980224953659231*^9, 3.980239006767103*^9, {
