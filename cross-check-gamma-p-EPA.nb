       RowBox[{"3.4", "*", 
        SuperscriptBox["10", 
         RowBox[{"-", "3"}]]}]}], "}"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tabToFit", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"#", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "2"], ",", 
       RowBox[{"#", "[", 
        RowBox[{"[", "2", "]"}], "]"}], ",", 
       RowBox[{"#", "[", 
        RowBox[{"[", "3", "]"}], "]"}]}], "}"}], "&"}], "/@", "tabToFit"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"tabToFit", "=", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"tseed", "=", "1."}], "}"}], ",", 
    RowBox[{"Join", "[", 
     RowBox[{"tabToFit", ",", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"GeVm2Tob", "*", 
          SuperscriptBox["10", "6"], "*", 
          RowBox[{"d\[Sigma]VproddtPhotoN", "[", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", 
            RowBox[{"Min", "[", 
             RowBox[{"tseed", ",", 
              RowBox[{"0.9", "*", 
               RowBox[{"tmax", "[", 
                RowBox[{
                 RowBox[{"#", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], ",", "mpval", ",", 
                 RowBox[{
                 "MASS", "[", 
                  "\"\<\!\(\*SuperscriptBox[\(\[Rho]\), \(0\)]\)\>\"", 
                  "]"}]}], "]"}]}]}], "]"}], ",", 
            "\"\<\!\(\*SuperscriptBox[\(\[Rho]\), \(0\)]\)\>\""}], "]"}]}], 
         "}"}], "&"}], "/@", "tabToFit"}], ",", "2"}], "]"}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"funcFit", "[", "s_", "]"}], "=", 
   RowBox[{"1.5", "*", 
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox["3.4", "2.7"], ")"}], "2"], "*", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"s", "<=", "5.5"}], ",", "5.1", ",", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"5.5", "<", "s", "<=", "6.14"}], ",", 
        RowBox[{"5.1", "*", 
         SuperscriptBox[
          RowBox[{"(", 
           FractionBox["5.5", "s"], ")"}], "12.5"]}], ",", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"5.1", "*", 
           SuperscriptBox[
            RowBox[{"(", 
             FractionBox["5.5", "6.14"], ")"}], "12.5"]}], ")"}], 
         SuperscriptBox[
          RowBox[{"(", 
           FractionBox["6.14", "s"], ")"}], "5"]}]}], "]"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"constrFunc", "[", 
   RowBox[{"norm_", ",", "s1_", ",", "s2_", ",", "pow_"}], "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"fit1", "[", "s_", "]"}], "=", "norm"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"fit2", "[", 
       RowBox[{"s_", ",", "s0v_"}], "]"}], "=", 
      SuperscriptBox[
       RowBox[{"(", 
        FractionBox["s0v", "s"], ")"}], "pow"]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"fit3", "[", 
       RowBox[{"s_", ",", "s1v_"}], "]"}], "=", 
      SuperscriptBox[
       RowBox[{"(", 
        FractionBox["s1v", "s"], ")"}], "5"]}], ";", "\[IndentingNewLine]", 
     RowBox[{"s0vSol", "=", 
      RowBox[{"s0v", "/.", 
       RowBox[{
        RowBox[{"NSolve", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"fit1", "[", "s1", "]"}], "==", 
           RowBox[{"fit2", "[", 
            RowBox[{"s1", ",", "s0v"}], "]"}]}], ",", "s0v", ",", "Reals"}], 
         "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"s1vSol", "=", 
      RowBox[{"s1v", "/.", 
       RowBox[{
        RowBox[{"NSolve", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"fit3", "[", 
            RowBox[{"s2", ",", "s1v"}], "]"}], "==", 
           RowBox[{"fit2", "[", 
            RowBox[{"s2", ",", "s0vSol"}], "]"}]}], ",", "s1v", ",", 
          "Reals"}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"s", "<", "s1"}], ",", 
       RowBox[{"Evaluate", "[", 
        RowBox[{"fit1", "[", "s", "]"}], "]"}], ",", 
       RowBox[{"Evaluate", "[", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"s1", "<=", "s", "<", "s2"}], ",", 
          RowBox[{"Evaluate", "[", 
           RowBox[{"fit2", "[", 
            RowBox[{"s", ",", "s0vSol"}], "]"}], "]"}], ",", 
          RowBox[{"Evaluate", "[", 
           RowBox[{"fit3", "[", 
            RowBox[{"s", ",", "s1vSol"}], "]"}], "]"}]}], "]"}], "]"}]}], 
      "]"}]}]}], "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
