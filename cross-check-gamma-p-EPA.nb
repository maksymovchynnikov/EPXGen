Cell[CellGroupData[{

Cell["EPA", "Section",
 CellChangeTimes->{{3.977971382018713*^9, 3.977971382355583*^9}, {
   3.977971675249319*^9, 3.9779716791046906`*^9}, {3.977971743684992*^9, 
   3.977971748606373*^9}, {3.977982510921114*^9, 3.9779825112093544`*^9}, 
   3.977990792148739*^9},ExpressionUUID->"40c056d1-ae0e-8c42-af22-\
d83889b1d972"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"xminEPAabs", "[", 
    RowBox[{"mX_", ",", "mp_", ",", "Ep_", ",", "Ee_"}], "]"}], "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"mX", "+", "mp"}], ")"}], "^", "2"}], "-", 
      RowBox[{"mp", "^", "2"}]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"4", "*", "Ee", "*", "Ep"}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"xmaxEPAabs", "[", 
    RowBox[{"me_", ",", "Ee_"}], "]"}], "=", 
   RowBox[{"Min", "[", 
    RowBox[{"0.9", ",", 
     RowBox[{"1", "-", 
      RowBox[{"me", "/", 
       RowBox[{"(", 
        RowBox[{"2", "Ee"}], ")"}]}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Q2minEPAx", "[", 
    RowBox[{"x_", ",", "me_"}], "]"}], "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"x", "^", "2"}], "*", 
      RowBox[{"me", "^", "2"}]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"1", "-", "x"}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Q2maxEPAabs", "=", "10."}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Q2maxEPAx", "[", 
    RowBox[{"x_", ",", "Ee_"}], "]"}], "=", 
   RowBox[{"Min", "[", 
    RowBox[{
     RowBox[{"4", "*", 
      RowBox[{"Ee", "^", "2"}], "*", 
      RowBox[{"(", 
       RowBox[{"1", "-", "x"}], ")"}]}], ",", "Q2maxEPAabs"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"xminEPAQ2", "[", 
    RowBox[{"mX_", ",", "mp_", ",", "Ep_", ",", "Ee_"}], "]"}], "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"mX", "+", "mp"}], ")"}], "^", "2"}], "-", 
      RowBox[{"mp", "^", "2"}]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"4", "*", "Ee", "*", "Ep"}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"xmaxEPAQ2", "[", 
    RowBox[{"mX_", ",", "me_", ",", "Q2_", ",", "Ee_"}], "]"}], "=", 
   RowBox[{"Min", "[", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"Q2", "/", 
       RowBox[{"(", 
        RowBox[{"2", " ", 
         RowBox[{"me", "^", "2"}]}], ")"}]}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Sqrt", "[", 
         RowBox[{"1", "+", 
          RowBox[{"4", " ", 
           RowBox[{
            RowBox[{"me", "^", "2"}], "/", "Q2"}]}]}], "]"}], "-", "1"}], 
       ")"}]}], "*)"}], 
    RowBox[{
     FractionBox["2", 
      RowBox[{
       SqrtBox[
        RowBox[{"1", "+", 
         RowBox[{"4", 
          FractionBox[
           SuperscriptBox["me", "2"], "Q2"]}]}]], "+", "1"}]], ",", 
     RowBox[{"1", "-", 
      RowBox[{"Q2", "/", 
       RowBox[{"(", 
        RowBox[{"4", "*", 
         RowBox[{"Ee", "^", "2"}]}], ")"}]}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Q2minEPAabs", "[", 
     RowBox[{"mX_", ",", "mp_", ",", "me_", ",", "Ep_", ",", "Ee_"}], "]"}], 
    "=", 
    RowBox[{
     RowBox[{
      RowBox[{"Q2minEPAx", "[", 
       RowBox[{"x", ",", "me"}], "]"}], "/.", " ", 
      RowBox[{"{", 
       RowBox[{"x", "->", 
        RowBox[{"xminEPAabs", "[", 
         RowBox[{"mX", ",", "mp", ",", "Ep", ",", "Ee"}], "]"}]}], "}"}]}], "//",
      "Simplify"}]}], ";"}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Finally", ",", 
    RowBox[{
     RowBox[{"the", " ", "cos", 
      RowBox[{"(", 
       RowBox[{"Subscript", "[", 
        RowBox[{"\[Theta]", ",", 
         RowBox[{"e", "'"}]}], "]"}], ")"}]}], "-", 
     RowBox[{"x", " ", "space"}]}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Q2x\[Theta]epr", "[", 
    RowBox[{"Ee_", ",", "me_", ",", "x_", ",", "\[Theta]epr_"}], "]"}], "=", 
   RowBox[{
    RowBox[{"Q2minEPAx", "[", 
     RowBox[{"x", ",", "me"}], "]"}], "+", 
    RowBox[{"2", "*", 
     RowBox[{"Ee", "^", "2"}], " ", 
     RowBox[{"(", 
      RowBox[{"1", "-", "x"}], ")"}], "*", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"Cos", "[", "\[Theta]epr", "]"}]}], ")"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"JacobianxQ2tox\[Theta]epr", "[", 
    RowBox[{"Ee_", ",", "x_", ",", "\[Theta]epr_"}], "]"}], "=", 
   RowBox[{"D", "[", 
