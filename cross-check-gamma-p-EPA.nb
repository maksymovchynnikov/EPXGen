Cell[CellGroupData[{

Cell["Comparison vs Kaskulov", "Subsection",
 CellChangeTimes->{{3.9832910172520905`*^9, 
  3.983291019965332*^9}},ExpressionUUID->"53a71f59-02a7-7544-bc0e-\
477b7cae4069"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"dataKaskulov", "[", 
    RowBox[{"s_", ",", "t_"}], "]"}], "=", 
   RowBox[{
    RowBox[{"Import", "[", 
     RowBox[{
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
         RowBox[{
         RowBox[{"dir", "[", "\"\<datasets\>\"", "]"}], 
         ",", "\"\<dsigmadtKaskulov.mx\>\""}], "}"}], "]"}], 
      ",", "\"\<MX\>\""}], "]"}], "/.", 
    RowBox[{"{", 
     RowBox[{"\[Lambda]", "->", "0"}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"plotVsKaskulov", "[", 
   RowBox[{
   "E\[Gamma]_", ",", "xmax_", ",", "ymin_", ",", "ymax_", ",", "aspRat_"}], 
   "]"}], ":=", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"s", "=", 
      RowBox[{
       SuperscriptBox["mpval", "2"], "+", 
       RowBox[{"2", "*", "mpval", "*", "E\[Gamma]"}]}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"label", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         SqrtBox["s"], "==", 
         RowBox[{"IntegerPart", "[", 
          SqrtBox["s"], "]"}]}], ",", 
        SqrtBox["s"], ",", 
        RowBox[{"Round", "[", 
         RowBox[{
          SqrtBox["s"], ",", "0.1"}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"LogPlot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Re", "[", 
          RowBox[{
           SuperscriptBox["10", "6"], 
           RowBox[{"d\[Sigma]dtPphotoNum", "[", 
            RowBox[{
            "s", ",", "t", 
             ",", "\"\<\!\(\*SuperscriptBox[\(\[Pi]\), \(0\)]\)\>\""}], 
            "]"}]}], "]"}], ",", 
         RowBox[{"Re", "[", 
          RowBox[{"0.8", "*", 
           SuperscriptBox["10", "6"], 
           RowBox[{
            RowBox[{"dataKaskulov", "[", 
             RowBox[{"s", ",", "t"}], "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"-", "1"}], "]"}], "]"}]}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0.", ",", "2."}], "}"}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"ImageSize", "->", "Large"}], ",", 
       RowBox[{"FrameStyle", "->", 
        RowBox[{"Directive", "[", 
         RowBox[{"Thick", ",", "Black", ",", "20", ",", 
          RowBox[{"FontFamily", "->", "\"\<Palatino\>\""}]}], "]"}]}], ",", 
       RowBox[{"PlotRange", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0.", ",", "xmax"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"ymin", ",", "ymax"}], "}"}]}], "}"}]}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<-\!\(\*SubscriptBox[\(t\), \(p\)]\) \
[\!\(\*SuperscriptBox[\(GeV\), \(2\)]\)]\>\"", 
          ",", "\"\<\!\(\*SubscriptBox[\(d\[Sigma]\), \(\[Gamma]p \[Rule] \
\*SuperscriptBox[\(\[Pi]\), \(0\)] p\)]\)/\!\(\*SubscriptBox[\(dt\), \(p\)]\) \
[\[Mu]b/\!\(\*SuperscriptBox[\(GeV\), \(2\)]\)]\>\""}], "}"}]}], ",", 
       RowBox[{"PlotLabel", "->", 
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            
            RowBox[{"\"\<\!\(\*SqrtBox[SubscriptBox[\(s\), \(\[Gamma]p\)]]\) \
= \>\"", ",", "label", ",", "\"\< GeV\>\""}], "}"}], "]"}], ",", "20", ",", 
          "Black", ",", 
          RowBox[{"FontFamily", "->", "\"\<Palatino\>\""}]}], "]"}]}], ",", 
       RowBox[{"AspectRatio", "->", "aspRat"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"Thick", ",", "Blue"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"Thick", ",", 
            RowBox[{"Darker", "@", "Red"}]}], "}"}]}], "}"}]}], ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"Placed", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"Row", "[", 
               RowBox[{"{", "#", "}"}], "]"}], ",", "22", ",", "Black", ",", 
              RowBox[{"FontFamily", "->", "\"\<Palatino\>\""}]}], "]"}], 
            "&"}], "/@", 
           RowBox[{"{", 
            RowBox[{"\"\<1706.07376\>\"", ",", "\"\<1105.1993\>\""}], "}"}]}],
           ",", " ", 
          RowBox[{"{", 
           RowBox[{"0.8", ",", "0.1"}], "}"}]}], "]"}]}], ",", 
       RowBox[{"ImagePadding", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"Automatic", ",", "Automatic"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"Automatic", ",", " ", "0.6"}], "}"}]}], "}"}]}]}], 
      "]"}]}]}], "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"pt1", "=", 
  RowBox[{"plotVsKaskulov", "[", 
   RowBox[{"2.", ",", "2", ",", 
    SuperscriptBox["10", 
     RowBox[{"-", "2."}]], ",", "10", ",", "0.6"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"pt2", "=", 
  RowBox[{"plotVsKaskulov", "[", 
   RowBox[{"4.", ",", "2", ",", 
    SuperscriptBox["10", 
     RowBox[{"-", "2."}]], ",", "10", ",", "0.6"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"pt3", "=", 
