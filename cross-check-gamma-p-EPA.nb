    RowBox[{"I", "*", "g\[Gamma]PV", "*", "gVpp", "*", 
     RowBox[{"LeviCivita", "[", 
      RowBox[{"\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]"}], "]"}],
      "*", 
     RowBox[{"mom\[Gamma]", "[", "\[Nu]", "]"}], "*", 
     RowBox[{"FV", "[", 
      RowBox[{
       RowBox[{"pp", "-", "pppr"}], ",", "\[Alpha]"}], "]"}], "*", 
     RowBox[{"ubarppr", ".", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"GA", "[", "\[Beta]", "]"}], 
         RowBox[{"(", 
          RowBox[{"1", "+", "\[Kappa]V"}], ")"}]}], "-", 
        RowBox[{
         FractionBox["\[Kappa]V", 
          RowBox[{"2", "mp"}]], "*", 
         RowBox[{"(", 
          RowBox[{"FV", "[", 
           RowBox[{
            RowBox[{"pp", "+", "pppr"}], ",", "\[Beta]"}], "]"}], ")"}]}]}], 
       ")"}], ".", 
      RowBox[{"SpinorU", "[", 
       RowBox[{"pp", ",", "mp"}], "]"}]}], "*", "ReggeV"}], "//", 
    "Contract"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ruleVprodPV", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Regge\[Rho]", "->", "Regge\[Rho]Star"}], ",", 
     RowBox[{"Regge\[Omega]", "->", "Regge\[Omega]Star"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"MepToepP\[Rho]", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"JvecHadrPV", "*", 
        RowBox[{"pol\[Gamma]", "[", "\[Mu]", "]"}]}], "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ReggeV", "->", "Regge\[Rho]"}], ",", 
         RowBox[{"\[Kappa]V", "->", "\[Kappa]\[Rho]"}], ",", 
         RowBox[{"g\[Gamma]PV", "->", "g\[Gamma]P\[Rho]"}], ",", 
         RowBox[{"gVpp", "->", "g\[Rho]pp"}]}], "}"}]}], "//", 
      "ExpandScalarProduct"}], "//", "Contract"}], "//", "Simplify"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"MepToepP\[Omega]", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"JvecHadrPV", "*", 
        RowBox[{"pol\[Gamma]", "[", "\[Mu]", "]"}]}], "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ReggeV", "->", "Regge\[Omega]"}], ",", 
         RowBox[{"\[Kappa]V", "->", "\[Kappa]\[Omega]"}], ",", 
         RowBox[{"g\[Gamma]PV", "->", "g\[Gamma]P\[Omega]"}], ",", 
         RowBox[{"gVpp", "->", "g\[Omega]pp"}]}], "}"}]}], "//", 
      "ExpandScalarProduct"}], "//", "Contract"}], "//", "Simplify"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"MsquaredPprodPhotoV", "[", 
    RowBox[{
    "s_", ",", "\[Alpha]EM_", ",", "cos\[Theta]_", ",", "mp_", ",", "mX_", 
     ",", "g\[Rho]pp_", ",", "\[Kappa]\[Rho]_", ",", "g\[Gamma]P\[Rho]_", ",",
      "Regge\[Rho]_", ",", "Regge\[Rho]Star_", ",", "g\[Omega]pp_", ",", 
     "\[Kappa]\[Omega]_", ",", "g\[Gamma]P\[Omega]_", ",", "Regge\[Omega]_", 
     ",", "Regge\[Omega]Star_"}], "]"}], "=", 
   RowBox[{
    RowBox[{"MsquaredPhotoXInsertedKinematics", "[", 
     RowBox[{
     "MepToepP\[Rho]", ",", "MepToepP\[Rho]", ",", "False", ",", 
      "ruleVprodPV", ",", "ruleVprodPV"}], "]"}], "+", 
    RowBox[{"MsquaredPhotoXInsertedKinematics", "[", 
     RowBox[{
     "MepToepP\[Omega]", ",", "MepToepP\[Omega]", ",", "False", ",", 
      "ruleVprodPV", ",", "ruleVprodPV"}], "]"}], "+", 
    RowBox[{"MsquaredPhotoXInsertedKinematics", "[", 
     RowBox[{
     "MepToepP\[Rho]", ",", "MepToepP\[Omega]", ",", "False", ",", 
      "ruleVprodPV", ",", "ruleVprodPV"}], "]"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9802249536532307`*^9, 3.980225148320198*^9}, {
