Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"ResourceFunction", "[", "\"\<MonitorProgress\>\"", "]"}], "@", 
  RowBox[{"Do", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"ResourceFunction", "[", "\"\<MonitorProgress\>\"", "]"}], "@", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Block", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Epv", "=", 
            RowBox[{
             RowBox[{"energies", "[", "setup", "]"}], "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], ",", 
           RowBox[{"Eev", "=", 
            RowBox[{
             RowBox[{"energies", "[", "setup", "]"}], "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], ",", "Q2max"}], "}"}], ",", 
         RowBox[{
          RowBox[{"tab", "=", 
           RowBox[{"ParallelTable", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               SuperscriptBox["10", "x"], ",", 
               RowBox[{
                RowBox[{"d\[Sigma]dQ2EPA", "[", 
                 RowBox[{
                  SuperscriptBox["10", "x"], ",", "Eev", ",", "Epv", ",", 
                  "ptsel"}], "]"}], "//", "Quiet"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"x", ",", 
               RowBox[{"Log10", "[", 
                RowBox[{"Q2minEPAabs", "[", 
                 RowBox[{
                  RowBox[{"mP", "[", "ptsel", "]"}], ",", "mpval", ",", 
                  "meval", ",", "Epv", ",", "Eev"}], "]"}], "]"}], ",", 
               RowBox[{"Log10", "[", "Q2maxEPAabs", "]"}], ",", 
               FractionBox[
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"Log10", "[", "Q2maxEPAabs", "]"}], "-", 
                  RowBox[{"Log10", "[", 
                   RowBox[{"Q2minEPAabs", "[", 
                    RowBox[{
                    RowBox[{"mP", "[", "ptsel", "]"}], ",", "mpval", ",", 
                    "meval", ",", "Epv", ",", "Eev"}], "]"}], "]"}]}], ")"}], 
                "130"]}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"d\[Sigma]dQ2int", "[", "Q2_", "]"}], "=", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Q2minEPAabs", "[", 
               RowBox[{
                RowBox[{"mP", "[", "ptsel", "]"}], ",", "mpval", ",", "meval",
                 ",", "Epv", ",", "Eev"}], "]"}], "<=", "Q2", "<=", 
              "Q2maxEPAabs"}], ",", 
             RowBox[{"Evaluate", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Interpolation", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", 
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "+", 
                    SuperscriptBox["10", 
                    RowBox[{"-", "90."}]]}]}], "}"}], "&"}], "/@", "tab"}], 
                    ")"}], "//", "Log"}], ",", 
                  RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}], "[", 
                RowBox[{"Log", "[", "Q2", "]"}], "]"}], "//", "Exp"}], "]"}], 
             ",", "0."}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"\[Sigma]totEPA", "[", 
            RowBox[{"ptsel", ",", "setup"}], "]"}], "=", 
           RowBox[{"NIntegrate", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"d\[Sigma]dQ2int", "[", 
               RowBox[{"Exp", "[", "Q2", "]"}], "]"}], "*", 
              RowBox[{"Exp", "[", "Q2", "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"Q2", ",", 
               RowBox[{"Log", "[", 
                RowBox[{"Q2minEPAabs", "[", 
                 RowBox[{
                  RowBox[{"mP", "[", "ptsel", "]"}], ",", "mpval", ",", 
                  "meval", ",", "Epv", ",", "Eev"}], "]"}], "]"}], ",", 
               RowBox[{"Log", "[", 
                RowBox[{"-", "t1thresholdRegge"}], "]"}]}], "}"}], ",", 
             RowBox[{
             "Method", "->", "\"\<InterpolationPointsSubdivision\>\""}]}], 
            "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"\[Sigma]totEPAcut", "[", 
            RowBox[{"ptsel", ",", "setup"}], "]"}], "=", 
           RowBox[{
            RowBox[{"NIntegrate", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"d\[Sigma]dQ2int", "[", 
                RowBox[{"Exp", "[", "Q2", "]"}], "]"}], "*", 
               RowBox[{"Exp", "[", "Q2", "]"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"Q2", ",", 
                RowBox[{"Log", "[", "1.", "]"}], ",", 
                RowBox[{"Log", "[", 
                 RowBox[{"-", "t1thresholdRegge"}], "]"}]}], "}"}], ",", 
              RowBox[{
              "Method", "->", "\"\<InterpolationPointsSubdivision\>\""}]}], 
             "]"}], "//", "Quiet"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"d\[Sigma]dQ2int", "[", "Q2_", "]"}], "=", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Min", "[", 
               RowBox[{
                RowBox[{"d\[Sigma]dQ22to3analytic", "[", 
                 RowBox[{"setup", ",", "ptsel"}], "]"}], "[", 
                RowBox[{"[", 
                 RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}], "<", "Q2", 
              "<", 
              RowBox[{"Max", "[", 
               RowBox[{
                RowBox[{"d\[Sigma]dQ22to3analytic", "[", 
                 RowBox[{"setup", ",", "ptsel"}], "]"}], "[", 
                RowBox[{"[", 
                 RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}], ",", 
             RowBox[{"Evaluate", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Interpolation", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", 
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "+", 
                    SuperscriptBox["10", 
                    RowBox[{"-", "90."}]]}]}], "}"}], "&"}], "/@", 
                    RowBox[{"d\[Sigma]dQ22to3analytic", "[", 
                    RowBox[{"setup", ",", "ptsel"}], "]"}]}], ")"}], "//", 
                   "Log"}], ",", 
                  RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}], "[", 
                RowBox[{"Log", "[", "Q2", "]"}], "]"}], "//", "Exp"}], "]"}], 
             ",", "0."}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"\[Sigma]tot2to3Cut", "[", 
            RowBox[{"ptsel", ",", "setup"}], "]"}], "=", 
           RowBox[{
            RowBox[{"NIntegrate", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"d\[Sigma]dQ2int", "[", 
                RowBox[{"Exp", "[", "Q2", "]"}], "]"}], "*", 
               RowBox[{"Exp", "[", "Q2", "]"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"Q2", ",", 
                RowBox[{"Log", "[", "1.", "]"}], ",", 
                RowBox[{"Log", "[", 
                 RowBox[{"-", "t1thresholdRegge"}], "]"}]}], "}"}], ",", 
              RowBox[{
              "Method", "->", "\"\<InterpolationPointsSubdivision\>\""}]}], 
             "]"}], "//", "Quiet"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], 
       "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"setup", ",", "energylist"}], "}"}]}], "]"}]}], 
    "\[IndentingNewLine]", ",", 
