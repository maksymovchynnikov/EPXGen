               SuperscriptBox["0.938", "2"]}]]]}], ";", "\[IndentingNewLine]", 
           RowBox[{"Eppr", "=", 
            RowBox[{"data", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"pospOut", "-", "1"}], ")"}], "*", "lenparticle"}], "+",
