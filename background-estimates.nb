        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
           "cos\[Theta]ppr", ",", "\[Eta]ppr", ",", "Q2e", ",", "Eppr", ",", 
            "cos\[Theta]X", ",", "\[Eta]X", ",", "\[Eta]epr", ",", 
            "cos\[Theta]epr"}], "}"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"cos\[Theta]ppr", "=", 
