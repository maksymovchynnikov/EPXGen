1f65dfe346ed"],

Cell[BoxData[
 RowBox[{
  RowBox[{"testMCvsAnalytic", "[", 
   RowBox[{
   "X_", ",", "fa_", ",", "mX_", ",", "Eptest_", ",", "Eetest_", ",", 
    "Nevents_"}], "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"ifs1", "=", "True"}], ",", 
      RowBox[{"ift2", "=", "True"}], ",", 
      RowBox[{"useLogS2Lower", "=", "True"}], ",", 
      RowBox[{"useLogT1", "=", "True"}], ",", 
      RowBox[{"useLogT2", "=", "True"}], ",", 
      RowBox[{"useCosS1", "=", "True"}], ",", "tmin", ",", "tmax", ",", 
      "s2min", ",", "s2max", ",", 
      RowBox[{"mass", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"X", "==", "\"\<ALP\>\""}], ",", "mX", ",", 
         RowBox[{"MASS", "[", "X", "]"}]}], "]"}]}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"MemberQ", "[", 
        RowBox[{
         RowBox[{"{", 
          
          RowBox[{"\"\<\!\(\*SuperscriptBox[\(\[Pi]\), \(0\)]\)\>\"", 
           ",", "\"\<\[Eta]\>\"", ",", "\"\<\[Eta]'\>\"", 
           ",", "\"\<ALP\>\""}], "}"}], ",", "X"}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"\[Sigma]An", "=", 
         RowBox[{"\[Sigma]PprodAnalytic1", "[", 
          RowBox[{"X", ",", "mass", ",", "fa", ",", "Eptest", ",", "Eetest"}],
           "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"\[Sigma]An2", "=", 
         RowBox[{"\[Sigma]PprodAnalytic", "[", 
          RowBox[{"X", ",", "mass", ",", "fa", ",", "Eptest", ",", "Eetest"}],
           "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"\[Sigma]MC", "=", 
         RowBox[{
          RowBox[{"BlockPointsWeightsP", "[", 
           RowBox[{
           "mass", ",", "fa", ",", "X", ",", "Eptest", ",", "Eetest", ",", 
            "ifs1", ",", "ift2", ",", "useLogS2Lower", ",", "useLogT1", ",", 
            "useLogT2", ",", "useCosS1", ",", "Nevents", ",", 
            "t1thresholdRegge", ",", "t2thresholdRegge"}], "]"}], "//", 
          "Total"}]}], ";"}], "\[IndentingNewLine]", ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"\[Sigma]An", "=", 
         RowBox[{"\[Sigma]VprodAnalytic1", "[", 
          RowBox[{"X", ",", "Eptest", ",", "Eetest"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"\[Sigma]An2", "=", 
         RowBox[{"\[Sigma]VprodAnalytic2", "[", 
          RowBox[{"X", ",", "Eptest", ",", "Eetest"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"\[Sigma]MC", "=", 
         RowBox[{
          RowBox[{"BlockPointsWeightsV", "[", 
           RowBox[{
           "mass", ",", "X", ",", "Eptest", ",", "Eetest", ",", "ifs1", ",", 
            "ift2", ",", "useLogS2Lower", ",", "useLogT1", ",", "useLogT2", ",",
             "useCosS1", ",", "Nevents", ",", "t1thresholdRegge", ",", 
            "t2thresholdRegge"}], "]"}], "//", "Total"}]}], ";"}]}], 
      "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"tabd\[Sigma]dt1Analytic", "=", "tabbt1"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tabd\[Sigma]ds2Analytic", "=", "tabbs2"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Defines", " ", "pts"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"Print", "[", "\"\<Cross-sections:\>\"", "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tabcomp", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<Semi-analytic, 3D integral\>\"", ",", "\[Sigma]An"}], 
         "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\"\<Semi-analytic, 2D + interpolation\>\"", ",", 
          "\[Sigma]An2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\"\<MC\>\"", ",", "\[Sigma]MC"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", "tabcomp", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{
     "Print", "[", "\"\<\!\(\*SubscriptBox[\(t\), \(1\)]\),min/max - from \
sampled pool or from analytic bounds:\>\"", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"tabcomp2", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"{", 
          
          RowBox[{"\"\<Approach\>\"", 
           ",", "\"\<\!\(\*FractionBox[SubscriptBox[\(t\), \(1, min\)], \
SuperscriptBox[\(GeV\), \(-2\)]]\)\>\"", 
           ",", "\"\<\!\(\*FractionBox[SubscriptBox[\(t\), \(1, max\)], \
SuperscriptBox[\(GeV\), \(-2\)]]\)\>\""}], "}"}], "}"}], ",", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", "\"\<Semi-analytic\>\"", "}"}], ",", 
            RowBox[{"{", "\"\<MC\>\"", "}"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"t1pmXprod", "[", 
               RowBox[{"s", ",", 
                RowBox[{"s2minXprod", "[", 
                 RowBox[{"mp", ",", "mX", ",", "me", ",", "s"}], "]"}], ",", 
                "me", ",", "mp"}], "]"}], "/.", 
              RowBox[{"{", 
               RowBox[{"s", "->", 
                RowBox[{"sep", "[", 
                 RowBox[{"Eptest", ",", "Eetest", ",", "mp", ",", "me"}], 
                 "]"}]}], "}"}]}], "/.", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"me", "->", "meval"}], ",", 
               RowBox[{"mp", "->", "mpval"}], ",", 
               RowBox[{"mX", "->", "mass"}]}], "}"}]}], ",", 
            RowBox[{
             RowBox[{"pts", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "2"}], "]"}], "]"}], "//", "MinMax"}]}], 
           "}"}], ",", "2"}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", "tabcomp2", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<Fraction of zero weights: \>\"", ",", " ", 
         RowBox[{
          FractionBox[
           RowBox[{"Length", "[", 
            RowBox[{"Select", "[", 
             RowBox[{"weights", ",", 
              RowBox[{
               RowBox[{"#", "==", "0."}], "&"}]}], "]"}], "]"}], 
           RowBox[{"Length", "[", "weights", "]"}]], "//", "N"}]}], "}"}], 
       "]"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"Creating", " ", "PDF", " ", 
        RowBox[{"d\[Sigma]", "/", "d"}]}], "|", 
       SubscriptBox["t", "1"], "|"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"pool1", "=", 
      RowBox[{"RandomChoice", "[", 
       RowBox[{
        RowBox[{"weights", "->", "pts"}], ",", 
        RowBox[{
         RowBox[{"Nevents", "/", "10"}], "//", "IntegerPart"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"inbins", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "70"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "100"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "40"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"pdfdatas2", ",", "pdfdatat1", ",", "pdfdatat2"}], "}"}], "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", 
            RowBox[{"\[Sigma]MC", "*", 
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], "&"}], "/@", 
         RowBox[{"pdf1Dmaker", "[", 
          RowBox[{"pool1", ",", 
           RowBox[{"f", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", 
           RowBox[{"f", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"f", ",", "inbins"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"pdfs2", "[", "x_", "]"}], ",", 
        RowBox[{"pdft1", "[", "x_", "]"}], ",", 
        RowBox[{"pdft2", "[", "x_", "]"}]}], "}"}], "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Min", "[", 
            RowBox[{"t", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}], "<=", "x", "<=", 
           RowBox[{"Max", "[", 
            RowBox[{"t", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}], ",", 
          RowBox[{"Evaluate", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Interpolation", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", 
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "+", 
                    SuperscriptBox["10", 
                    RowBox[{"-", "90."}]]}]}], "}"}], "&"}], "/@", "t"}], 
                 ")"}], "//", "Log"}], ",", 
               RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}], "[", 
             RowBox[{"Log", "[", "x", "]"}], "]"}], "//", "Exp"}], "]"}], ",", 
          SuperscriptBox["10", 
           RowBox[{"-", "90."}]]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", 
          RowBox[{"{", 
           RowBox[{"pdfdatas2", ",", "pdfdatat1", ",", "pdfdatat2"}], "}"}]}],
          "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tabPDFdata", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"MinMax", "[", 
         RowBox[{"pdfdatas2", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}], ",", 
        RowBox[{"MinMax", "[", 
         RowBox[{"pdfdatat1", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}], ",", 
        RowBox[{"MinMax", "[", 
         RowBox[{"pdfdatat2", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"tmin", ",", "tmax"}], "}"}], "=", 
      RowBox[{"MinMax", "[", 
       RowBox[{
        RowBox[{"Drop", "[", 
         RowBox[{"tabPDFdata", ",", "1"}], "]"}], "//", "Flatten"}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"d\[Sigma]dt1AnalyticInt", "[", "t1_", "]"}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Interpolation", "[", 
         RowBox[{
          RowBox[{"tabd\[Sigma]dt1Analytic", "//", "Log"}], ",", 
          RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}], "[", 
        RowBox[{"Log", "[", "t1", "]"}], "]"}], "//", "Exp"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"nameen", "=", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"n", "=", 
          RowBox[{
           RowBox[{"ToString", "[", "Eptest", "]"}], "<>", "\"\<\[Times]\>\"",
            "<>", 
           RowBox[{"ToString", "[", "Eetest", "]"}]}]}], "}"}], ",", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"MemberQ", "[", 
           RowBox[{"EnergiesConfigurations", ",", "n"}], "]"}], ",", 
          RowBox[{"compactNameConf", "[", "n", "]"}], ",", 
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            
            RowBox[{"\"\<\!\(\*SubscriptBox[\(E\), \
\(p\)]\)\[Times]\!\(\*SubscriptBox[\(E\), \(e\)]\) = \>\"", ",", "Eptest", 
             ",", "\"\< GeV\[Times]\>\"", ",", "Eetest", 
             ",", "\"\< GeV\>\""}], "}"}], "]"}]}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"epilog", "=", 
      RowBox[{"{", 
       RowBox[{"Inset", "[", 
        RowBox[{
         RowBox[{"Framed", "[", 
          RowBox[{
           RowBox[{"Style", "[", 
            RowBox[{
             RowBox[{"Row", "[", 
              RowBox[{"{", 
               
               RowBox[{"\"\<e p \[Rule] e p \>\"", ",", "X", ",", "\"\<, \>\"",
                 ",", "nameen"}], "}"}], "]"}], ",", "22", ",", "Black", ",", 
             RowBox[{"FontFamily", "->", "\"\<Palatino\>\""}]}], "]"}], ",", 
           RowBox[{"FrameStyle", "->", 
            RowBox[{"Directive", "[", 
             RowBox[{"Black", ",", 
              RowBox[{"Thickness", "[", "0.9", "]"}]}], "]"}]}], ",", 
           RowBox[{"Background", "->", "White"}], ",", 
           RowBox[{"FrameMargins", "->", "Medium"}]}], "]"}], ",", 
         RowBox[{"Scaled", "[", 
          RowBox[{"{", 
